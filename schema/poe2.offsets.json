{
  // PoEformance offset schema for Path of Exile 2.
  //
  // This file IS the reverse-engineering knowledge of the project. Offsets are data,
  // not code: edit here, hot-reload in the tool, no rebuild. Every field may declare
  // an "invariant" describing what a correct value looks like - the validator runs
  // them at attach time and turns silent offset drift into a red row in the report.
  //
  // Ported from the AHK tool's PoE2Offsets.ahk + StaticOffsetsPatterns.ahk, including
  // the drift history comments (they are the hard-won part).
  //
  // Conventions:
  //   offsets/consts   hex strings ("0x1A0") or decimal
  //   pattern          hex bytes, "??" wildcard, "^" marks the RIP disp32 position
  //   invariant kinds  range | plausiblePtr | nonNullPtr | unitVector3
  //                    | vectorSane | stringContains | changes

  "version": 1,
  "gameVersion": "0.5.x (AreaInstance tail re-verified 2026-08 by owner: +0x08 wave; base port: AHK tool v0.45.13.298, 2026-07)",

  "statics": {
    "GameStates": {
      "pattern": "48 39 2D ^ ?? ?? ?? ?? 0F 85 ?? ?? ?? ?? B9 40 01 00 00",
      "comment": "Root of everything: the game-state array."
    },
    "FileRoot": {
      "pattern": "48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B 05 ^ ?? ?? ?? ?? 48 83 C4 28",
      "comment": "Loaded-files root (GGPK file records)."
    },
    "AreaChangeCounter": {
      "pattern": "FF 05 ^ ?? ?? ?? ?? 4D 8B 06 49 8D 50 20",
      "comment": "The area-change counter: `inc [counter]` in the instance-load function. CONFIRMED IN CHEAT ENGINE (2026-08): it reads a small number that steps by one per zone, and matches the stamps in the loaded-file table. The reference's own pattern stops after `4D 8B 06` and hits TWICE here; the second hit points at unmapped memory, so it is a false positive, and the four bytes added (`49 8D 50 20`) are the first place the two diverge. An earlier attempt anchored a LOCKED increment instead (`49 89 46 ?? F0 FF 05 ^ ?? ?? ?? ?? 48 8B CD E8`) - it hit exactly once, which read as success, and resolved a DIFFERENT counter that stood at 188 while this one stood at 12. Lesson: a unique hit is not a correct one, and disambiguating a pattern means lengthening it AT ITS OWN SITE."
    },
    "TerrainRotatorHelper": {
      "pattern": "48 83 EC 38 41 0F B6 C0 4C 8B D1 4C 8B CA 48 8D 0D ?? ?? ?? ?? 44 0F B6 04 08 B8 08 00 00 00 8B 0A 44 3B C0 89 4C 24 24 BA 16 00 00 00 44 0F 47 C0 48 8D 05 ^ ?? ?? ?? ??",
      "comment": "Resolves the larger terrain-rotation array."
    },
    "TerrainRotationSelector": {
      "pattern": "48 83 EC 38 41 0F B6 C0 4C 8B D1 4C 8B CA 48 8D 0D ^ ?? ?? ?? ?? 44 0F B6 04 08 B8 08 00 00 00 8B 0A 44 3B C0 89 4C 24 24 BA 16 00 00 00 44 0F 47 C0 48 8D 05 ?? ?? ?? ??",
      "comment": "Rotation lookup table (00 03 02 01 04 ...). Same function as the helper, ^ on the FIRST lea. Upstream's 17-byte prologue-only form matches other functions too; the longer tail makes it unique."
    },
    "GameCullSize": {
      "pattern": "2B 0D ?? ?? ?? ?? 8B 05 ?? ?? ?? ?? 2B 05 ^ ?? ?? ?? ?? 0F 57 FF",
      "comment": "Letterbox bar width for UI-space -> screen conversion. A garbage value here silently poisons every width-scaled UI rect - clamp on use."
    }
  },

  "structs": {
    "GameState": {
      "comment": "The static GameStates pointer dereferences to this.",
      "fields": {
        "CurrentStateVecLast": {
          "offset": "0x10", "type": "ptr", "invariant": { "kind": "plausiblePtr" },
          "comment": "End pointer of the state STACK. The state in force is the SECOND-last entry (end - 0x10), not the last - GameHelper2 reads it that way and the last slot is not the active one."
        },
        "States": { "offset": "0x48", "type": "ptr", "comment": "Array of TotalStates entries, StateEntrySize apart; each entry starts with the state object's pointer. Index InGameStateIndex is the one the overlay may draw over." }
      },
      "consts": {
        "StateEntrySize": "0x10",
        "InGameStateIndex": "4",
        "TotalStates": "13"
      }
    },

    "InGameState": {
      "fields": {
        "AreaInstanceData": {
          "offset": "0x290", "type": "ptr",
          "invariant": { "kind": "nonNullPtr" },
          "comment": "Null while not in an area; nonNullPtr is only meaningful in-game. Re-confirmed 0x290 in the 2026-08 check (an older external baseline had 0x288)."
        },
        "UiRootStructPtr": { "offset": "0x2F0", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "KB/M UI manager (UserInterface_MouseAndKeyboard)." },
        "GamepadUiRootStructPtr": { "offset": "0x318", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "Controller UI manager." },
        "WorldData": { "offset": "0x368", "type": "ptr", "invariant": { "kind": "nonNullPtr" }, "comment": "CONFIRMED 2026-08 and no longer suspect: it was flagged because AreaInstanceData moved +0x08 in the same wave, and nonNullPtr passes at either slot since both hold plausible pointers. The matrix hunt settled it - the camera matrix resolves correctly at THIS base + 0x1A0, and a projection that maps 123 real entities linearly cannot come from the wrong struct. The earlier W2SMatrix failure was a bad invariant, not a drifted WorldData." }
      }
    },

    "AreaLoadingState": {
      "comment": "Fields of the AreaLoadingState game state (index 1).",
      "fields": {
        "IsLoading": { "offset": "0x770", "type": "i32", "comment": "Non-zero while an area is loading." },
        "TotalLoadingScreenTimeMs": { "offset": "0xEC0", "type": "u32", "comment": "Cumulative loading-screen time; increases on area change." },
        "CurrentAreaDetailsPtr": { "offset": "0xF40", "type": "ptr", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    "UiRootStruct": {
      "fields": {
        "UiRootPtr": { "offset": "0x340", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "GameUiPtr": { "offset": "0xBE0", "type": "ptr", "invariant": { "kind": "plausiblePtr" } },
        "GameUiControllerPtr": { "offset": "0xBE8", "type": "ptr", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    // ── The in-game map: a SECOND screen-space system, independent of W2SMatrix ──
    // Verified against GameHelper2's Radar plugin (Plugins/Radar). Dots on the game's own
    // map are NOT projected with the camera matrix. They use a fixed isometric transform
    // driven by the map UI element's zoom and shift:
    //     deltaZ /= 10.86957                                  (world -> grid, = 250/23)
    //     screen  = mapCentre + ((dx - dy) * cos, (deltaZ - (dx + dy)) * sin)
    //     CameraAngle = 38.7 degrees; cos/sin fold in the map diagonal and the zoom
    //     large map zoom x 0.187812, minimap zoom x 0.748
    //     large map centre  = Center + Shift + DefaultShift
    //     minimap centre    = Position + Size/2 + DefaultShift + Shift
    //     deltaZ comes from Render.TerrainHeight, dx/dy are GRID deltas from the player
    // This is why markers projected with W2SMatrix do not line up with the game's own map
    // markers: the map is zoomable and this transform accounts for it, the matrix cannot.
    // IMPLEMENTED and confirmed in-game 2026-08 (see PoEformance.Game/Ui/MapRadar.cs).
    // Three PoE2 deviations from the reference, each verified against this game:
    //   - the LARGE map's accumulated position is already its CENTRE (the minimap's is its
    //     top-left, so only that one adds half its size);
    //   - the large map's UnscaledSize reads 0, so its diagonal is borrowed from the minimap
    //     (window diagonal as fallback);
    //   - with the minimap diagonal borrowed, the zoom takes NO correction factor - the one
    //     upstream applies exists to scale the WINDOW diagonal down, so it would shrink
    //     everything twice.
    "ImportantUiElements": {
      "comment": "Relative to the KB/M UiRootStructPtr (= ReadPtr(InGameState + 0x2F0)). Controller mode uses a different layout.",
      "fields": {
        "ChatParentPtr": { "offset": "0x640", "type": "ptr" },
        "LeftPanelPtr": { "offset": "0x6D8", "type": "ptr", "comment": "UNVERIFIED, from GameHelper2's ImportantUiElementsOffsets. Whichever left-side panel is open - character, skills, quests. Null while none is, so this is BOTH the address and half the answer; the other half is that the element it points at is only visible while its panel is showing." },
        "RightPanelPtr": { "offset": "0x6E0", "type": "ptr", "comment": "UNVERIFIED, same source. The right-side one: inventory, stash, a vendor." },
        "PassiveSkillTreePanel": { "offset": "0x730", "type": "ptr" },
        "MapParentPtr": { "offset": "0x7C8", "type": "ptr" },
        "WorldMapPanelPtr": { "offset": "0x988", "type": "ptr", "comment": "UNVERIFIED, same source. The world-travel map - the act screens, not the endgame atlas, which is its own panel at a child path." },
        "ControllerModeMapParentPtr": { "offset": "0xAA8", "type": "ptr" }
      }
    },

    "BigPanels": {
      "comment": "UNVERIFIED - the panels that take over the screen, ported from GameHelper2's IsAnyLargePanelOpen. Two kinds and the difference matters: the left panel, the right panel, the world map and the skill tree are POINTERS on ImportantUiElements, which is the sturdy half; the four below are CHILD PATHS, which is a position in somebody else's list and moves when a patch inserts a panel above them. A wrong path usually lands on nothing and reads as shut, which is harmless - but it can land on a real element that is always showing, and then the overlay is hidden forever with nothing to say why. That is what the readout in the status window and the switch beside it are for. The skill tree is the tree's NODE CONTAINER (child 2 of the panel) rather than the panel: in 0.5.x the per-node pointers read null, but the container's visible bit is reliable.",
      "fields": {},
      "consts": {
        "SkillTreeNodesChild": "2",
        "AtlasSkillsPath0": "25",
        "AtlasSkillsPath1": "0",
        "TemplePath0": "64",
        "TemplePath1": "0",
        "ExchangePath0": "114",
        "ExchangePath1": "20",
        "ExchangePath2": "6",
        "ExchangePath3": "1",
        "TrialPath0": "84",
        "TrialPath1": "0"
      }
    },

    "UiElementBase": {
      "comment": "CONFIRMED IN-GAME 2026-08: the map radar built on this walk places dots exactly where the owner's production AHK tool does, which exercises the parent chain, both scale factors and the visibility rule end to end. Fields every UiElement has. Offsets are the PoE2 0.5.x set verified by the AHK tool; they agree with GameHelper2's UiElementBaseOffset.cs everywhere except StringIdPtr, which drifted 0x140 -> 0x098 in PoE2 and would read the text/font-style field at the old offset. Base UI resolution is 2560x1600: every position and size here is in THAT space and must be scaled to the window (see UiScale).",
      "fields": {
        "Self": { "offset": "0x008", "type": "ptr", "comment": "Points at the element ITSELF - *(this+0x08) == this is a cheap validity check before trusting any other field." },
        "ChildrenFirst": { "offset": "0x010", "type": "ptr", "comment": "StdVector begin: array of child UiElement pointers." },
        "ChildrenLast": { "offset": "0x018", "type": "ptr", "comment": "StdVector end; child count = (Last - First) / 8." },
        "StringIdPtr": { "offset": "0x098", "type": "ptr", "comment": "StdWString - the element's identifier (\"life_orb\", \"InventoryPanel\"). PoE2 0.5.x; 0x140 is the stale 0.4.x layout and 0x0F8 is the text style." },
        "ParentPtr": { "offset": "0x0B8", "type": "ptr", "comment": "Parent element - the chain walked to turn a relative position into an absolute one." },
        "PositionModifier": { "offset": "0x0F0", "type": "f32", "comment": "StdTuple2D<float>, y at +0x0F4. Added to the PARENT position, but only when the CHILD's ShouldModifyPos flag is set." },
        "RelativePosition": { "offset": "0x118", "type": "f32", "comment": "StdTuple2D<float>, y at +0x11C. Position relative to the parent, in the 2560x1600 UI space." },
        "LocalScaleMultiplier": { "offset": "0x130", "type": "f32", "comment": "Extra scale this element applies. When it differs from the parent's, the accumulated position must be CONVERTED between the two scale spaces." },
        "Flags": { "offset": "0x180", "type": "u32", "comment": "Bit 10 = ShouldModifyPos, bit 11 = IsVisible. Visibility is only meaningful with the whole parent chain visible too." },
        "ScaleIndex": { "offset": "0x18A", "type": "u8", "comment": "Selects which scale pair applies: 1 -> (v1,v1), 2 -> (v2,v2), 3 -> (v1,v2), anything else -> unscaled." },
        "UnscaledSize": { "offset": "0x288", "type": "f32", "comment": "StdTuple2D<float>, y at +0x28C. Size in UI space, scaled the same way as the position." },
        "ItemPtr": { "offset": "0x4F8", "type": "ptr", "comment": "The item entity held by an inventory/stash slot element, 0 elsewhere." },
        "TextPtr": { "offset": "0x390", "type": "ptr", "comment": "StdWString - the text the element DISPLAYS. The identifying field for every widget whose StringId is empty (skill-bar slots, loot labels, dialogue rows), which is most of them: a UI browser without it shows a tree of blanks. AHK-verified live 2026-06-14." },
        "TextStylePtr": { "offset": "0x0F8", "type": "ptr", "comment": "StdWString - font style descriptor (\"Normal\", \"PathOfExile.Panel.Title\"). Named here because 0x0F8 is where StringIdPtr sat in 0.4.x, so a browser reading the old layout shows these as ids - the mistake this field makes obvious instead of puzzling." },
        "FontNamePtr": { "offset": "0x0C8", "type": "ptr", "comment": "StdWString - font family (\"Fontin\", \"Fontin Smallcaps\")." }
      },
      "consts": {
        "BaseResolutionX": "2560",
        "BaseResolutionY": "1600",
        "FlagShouldModifyPos": "0x400",
        "FlagIsVisible": "0x800",
        "MaxParentChainDepth": "16"
      }
    },

    "MapParentStruct": {
      "comment": "Children of MapParentPtr, read from the cache location inside the struct.",
      "fields": {
        "LargeMapPtr": { "offset": "0x28", "type": "ptr" },
        "MiniMapPtr": { "offset": "0x30", "type": "ptr" }
      }
    },

    "MapUiElement": {
      "comment": "CONFIRMED IN-GAME 2026-08 via the map radar - dots track the map at every zoom level. A map-type UiElement: UiElementBase at 0x000, then its own fields. Matches GameHelper2 MapUiElement.cs. PoE2 4.5.x shifted all three by -0x38 when UiElementBase shrank (the old Zoom at 0x3E0 read 0.000).",
      "fields": {
        "Shift": { "offset": "0x368", "type": "f32", "comment": "StdTuple2D<float> - how far the user/game has shifted the map centre; y at +0x36C." },
        "DefaultShift": { "offset": "0x370", "type": "f32", "comment": "StdTuple2D<float> - resting offset, (0, -20) in PoE2; y at +0x374." },
        "Zoom": { "offset": "0x3A8", "type": "f32", "comment": "Current zoom, normally 0.5 - 1.5. THE value the world-to-screen projection cannot know about." }
      }
    },

    "WorldData": {
      "fields": {
        "WorldAreaDetailsPtr": { "offset": "0x98", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "CameraStructure": { "offset": "0x98", "type": "ptr", "comment": "INLINE camera struct base - do NOT dereference. GameHelper2's WorldDataOffset declares WorldAreaDetailsPtr and CameraStructurePtr at the SAME offset 0x98, the second as an inline struct, and its CameraStructure puts WorldToScreenMatrix at +0x108: 0x98 + 0x108 = WorldData+0x1A0, which is exactly the offset the AHK tool uses. (This field read 0xA0 before, arriving at the same 0x1A0 via +0x100; 0x98 is the referenced value.) No invariant: whatever floats sit here would validate anything." },
        "W2SMatrix": {
          "offset": "0x1A0", "type": "mat4x4",
          "comment": "World-to-screen camera transform = CameraStructure(0x98) + 0x108. CONFIRMED IN-GAME 2026-08 against a 123-entity scene: MatrixHunt ranked it first with a fixed-camera linearity of 0.943, the nearest decoy reaching 0.728, and 0x1E0 scored IDENTICALLY - the duplicate copy GameHelper2 documents, which corroborates rather than contradicts. Also matches the AHK tool's WorldData+0x1A0. Read with the GameHelper2 convention (System.Numerics Matrix4x4 + Vector4.Transform), i.e. each clip component is a dot with a COLUMN of the flat array: x from {0,4,8,12}, w from {3,7,11,15}. DRIFT HISTORY: 0x1A8 -> 0x1A0 (a patch shifted it -8 bytes; issue #158) -> 0x11C (2026-08, WRONG, reverted). NO STRUCTURAL INVARIANT ON PURPOSE. The removed one demanded a unit-length direction vector CONTIGUOUS at +0x30, and it did the worst thing an invariant can do: it rejected the truth and accepted a decoy. Under this column convention the direction row is STRIDED across {3,7,11}, so it is not contiguous at +0x30 at all - the invariant failed here, at the correct offset, and passed at 0x11C, where an unrelated block of four unit rows happens to match. Projecting the real scene through 0x11C collapses all 76 entities into 0.01 NDC (a monster 79 units from the player landing 0.00000 away), and the check meant to catch that - 'does the player land at screen centre?' - PASSED, because an inflated w drives every numerator to ~0 and centres everything. Unit-length rows are far too weak a fingerprint; frustum planes, basis blocks and inverse transforms all have them. The replacement test is semantic and lives in MatrixHunt: the player must be centred AND the rest of the scene must spread out, scored against real entities."
        }
      }
    },

    "WorldAreaDetails": {
      "comment": "Reached through WorldData.WorldAreaDetailsPtr (0x98). TWO hops, not one: WorldData -> WorldAreaDetails -> the WorldAreas.dat ROW. Ported from the AHK tool, which uses exactly this chain in game.",
      "fields": {
        "RowPtr": { "offset": "0xA0", "type": "ptr", "invariant": { "kind": "nonNullPtr" }, "comment": "The WorldAreas.dat row for the area currently loaded." }
      }
    },

    // ── dat ROWS are computable, not searchable ──
    // Four structs here are not engine objects at all - they are rows of the game's static
    // content tables, loaded into memory: WorldAreaDat (WorldAreas), BuffDefinition
    // (BuffDefinitions), MinimapIconRow (MinimapIcons) and ItemVisualIdentityRow
    // (ItemVisualIdentity). A row keeps the column ORDER the .dat file declares, PACKED,
    // with no alignment padding - which is why so many of these offsets are odd numbers.
    // poe-tool-dev/dat-schema publishes that column order for 1275 PoE2 tables, so for a
    // dat row the offset of any column is arithmetic. Column widths in memory:
    //     bool/i8/u8 1 | i16/u16 2 | i32/u32/f32 4 | enum-row 4 | string 8 (a UTF-16
    //     pointer) | reference to ANOTHER table's row 16 | reference to a row of the SAME
    //     table 8 | array of anything 16
    // A 16-byte foreign reference is a TABLE reference followed by a ROW reference, so a
    // pointer to the referenced row sits at +8, not at the column start. See BuffVisualsKey.
    // Where these come from: derived here by elimination - out of sixteen plausible
    // combinations exactly one reproduces every dat-row offset in this file, and the two
    // that pin it down are BuffDefinition 0x55 and 0x67, both sitting behind an array, an
    // enum and two row references - and then found to agree, type for type, with the
    // .datc64 table the AHK tool has been extracting these files with for months
    // (tools/poe_tools.py, TYPE_SIZES_DATC64). Two of these were guessed wrong first, and
    // both wrong guesses survived the elimination because nothing in this file could
    // disprove them: the self-reference width (41 PoE2 tables have such a column, and in
    // WorldAreas it is column 13 of 82) and which half of a foreign reference holds the
    // pointer. Reading the reference first would have cost a minute.
    // scripts\dat-offsets.ps1 does the arithmetic; -SelfTest re-runs the check.
    // NONE OF THIS APPLIES TO COMPONENTS. Life, Actor, Render, Positioned, Buffs,
    // StatusEffect, Entity and the UI structs have no .dat table behind them. ChestData
    // is the trap: it POINTS AT a Chests row but is not one, and checking it against that
    // table lands on offsets that are not even column boundaries.
    "WorldAreaDat": {
      "comment": "A row of WorldAreas.dat: what KIND of area this is. There is no IsHideout field - the reference derives it from the Id containing 'hideout' but not 'map', because hideout areas are named that way and map areas are not.",
      "fields": {
        "IdPtr": { "offset": "0x00", "type": "ptr", "comment": "Wide string, e.g. G1_2, MapRiverhold, HideoutFelled." },
        "NamePtr": { "offset": "0x08", "type": "ptr", "comment": "Wide string, the display name." },
        "Act": { "offset": "0x10", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 20 } },
        "IsTown": { "offset": "0x14", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 } },
        "HasWaypoint": { "offset": "0x15", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 } }
      }
    },

    "AreaInstance": {
      "comment": "DRIFT HISTORY, two waves so far: (1) +0x18 - PlayerInfo 0x580->0x598, TerrainMetadata 0x8A0->0x8B8; (2) 2026-08, owner-verified: +0x08 across the tail - PlayerInfo 0x598->0x5A0, AwakeEntities 0x6D8->0x6E0, SleepingEntities 0x6E8->0x6F0, TerrainMetadata 0x8B8->0x8C0 (a new 8-byte field was inserted below ~0x5A0). When ONE field here drifts, assume the whole tail moved by the same delta and check them all. Low fields (CurrentAreaLevel 0xC4, CurrentAreaHash 0x11C) did not move in either wave.",
      "fields": {
        "CurrentAreaLevel": {
          "offset": "0xC4", "type": "i32",
          "invariant": { "kind": "range", "min": 0, "max": 100 },
          "comment": "Monster level of the current area."
        },
        "CurrentAreaHash": { "offset": "0x11C", "type": "u32", "comment": "Instance hash - changes on every area transition; used as the per-area reset signal all over the tool." },
        "Environments": { "offset": "0x4C0", "type": "ptr", "comment": "UNVERIFIED since the 2026-08 +0x08 wave - sits between the stable low fields and the shifted tail; if the insertion point is below 0x4C0 this is 0x4C8 now. Confirm via the drift report before use." },
        "PlayerInfo": {
          "offset": "0x5A0", "type": "ptr",
          "comment": "INLINE LocalPlayerStruct base - do NOT dereference: the value AT this address is already ServerDataPtr (+0x00); LocalPlayerPtr is +0x20 (abs 0x5C0). Proven by the first live run 2026-08: dereferencing here validated ServerData as a struct base and the player chain 'broke'. Drift history: 0x580 -> 0x598 -> 0x5A0 (+0x08 wave). The invariants live on the LocalPlayerStruct rows."
        },
        "AwakeEntities": {
          "offset": "0x6E0", "type": "ptr",
          "invariant": { "kind": "nonNullPtr" },
          "comment": "EntityListStruct: AwakeEntities std::map head is its first field (+0x00). Was 0x6D8 (2026-08 +0x08 wave)."
        },
        "SleepingEntities": { "offset": "0x6F0", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "Was 0x6E8 (2026-08 +0x08 wave)." },
        "TerrainMetadata": {
          "offset": "0x8C0", "type": "ptr",
          "comment": "TerrainStruct (was 0x8A0, then 0x8B8, now 0x8C0 - 2026-08 +0x08 wave). Source: GameHelper2 AreaInstanceOffsets.cs. NOTE: unlike most ptr fields this is an inline struct base in some builds - treat as base address, not pointer, when reading TerrainMetadata fields."
        }
      }
    },

    "LocalPlayerStruct": {
      "fields": {
        "ServerDataPtr": { "offset": "0x00", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "LocalPlayerPtr": {
          "offset": "0x20", "type": "ptr",
          "invariant": { "kind": "stringContains", "needle": "Metadata/Characters", "hops": ["0x00", "0x08"], "stringAt": "0x08" },
          "comment": "The local player entity. Invariant follows Entity->EntityDetails(+0x08)->Path(+0x08) and expects a Metadata/Characters/... path - the strongest possible 'this is really the player' check."
        }
      }
    },

    "TerrainMetadata": {
      "comment": "Base = AreaInstance + TerrainMetadata offset. Walkable grid: each byte holds 2 cells (even x = low nibble, odd x = high nibble); nibble != 0 means walkable. GridLandscapeData / Layer3 / Layer4 were probed for a fog-of-war grid and are STATIC terrain-type data - the explored state is GPU-side and NOT readable (hunt closed 2026-07-06, do not reopen without new evidence).",
      "fields": {
        "TotalTilesX": { "offset": "0x18", "type": "i64", "invariant": { "kind": "range", "min": 1, "max": 4096 } },
        "TotalTilesY": { "offset": "0x20", "type": "i64", "invariant": { "kind": "range", "min": 1, "max": 4096 } },
        "TileDetailsPtr": {
          "offset": "0x28", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 56, "maxCount": 16777216 },
          "comment": "StdVector<TileStructure>, each 0x38 bytes."
        },
        "GridWalkableData": { "offset": "0xD0", "type": "stdVector", "invariant": { "kind": "vectorSane", "elementSize": 1, "maxCount": 67108864 } },
        "GridLandscapeData": { "offset": "0xE8", "type": "stdVector", "comment": "Static terrain-type nibbles 0-5. NOT fog-of-war." },
        "BytesPerRow": { "offset": "0x130", "type": "i32", "invariant": { "kind": "range", "min": 1, "max": 16384 } },
        "TileHeightMultiplier": { "offset": "0x134", "type": "i16" }
      }
    },

    "MinimapIcon": {
      "comment": "The component an entity carries when the GAME ITSELF marks it on the map - which makes it the authoritative answer to 'is this a point of interest', including quest targets. Source: GameHelper2 RemoteObjects/Components/MinimapIcon.cs.",
      "fields": {
        "IconRowPtr": { "offset": "0x20", "type": "ptr", "comment": "Row in MinimapIcons.dat. Its first field is the icon's name." }
      }
    },

    "MinimapIconRow": {
      "comment": "A row of MinimapIcons.dat. The name is the game's own category for the marker (\"Waypoint\", \"QuestObject\", \"RewardChestExpedition\").",
      "fields": {
        "NamePtr": { "offset": "0x00", "type": "ptr", "comment": "The table's Id column, which is the engine identifier and stays English. The localised label is a separate column at 0x1A." }
      }
    },

    "TileStruct": {
      "comment": "0x38 bytes each, inside TileDetailsPtr. WARNING from the AHK port: the tile ARRAY index and the TileIdX sub-cell byte are different things - a case-insensitive variable collision between them once placed every landmark at the map origin.",
      "fields": {
        "SubTileDetailsPtr": { "offset": "0x00", "type": "ptr" },
        "TgtFilePtr": { "offset": "0x08", "type": "ptr" },
        "TileHeight": { "offset": "0x30", "type": "i16" },
        "TileIdX": { "offset": "0x34", "type": "u8" },
        "TileIdY": { "offset": "0x35", "type": "u8" },
        "RotationSelector": { "offset": "0x36", "type": "u8" }
      }
    },

    "TgtFile": {
      "fields": {
        "TgtPath": { "offset": "0x08", "type": "stdWString", "comment": "The tile path, e.g. Art/Models/Terrain/..." }
      }
    },

    "StdMap": {
      "comment": "MSVC std::map header, laid out INLINE where it appears (AreaInstance.AwakeEntities is such a struct, not a pointer to one: reading a ptr at its offset yields Head because Head is its first field). Size is the element count. AwakeEntities and SleepingEntities sit 0x10 apart, matching this 16-byte layout.",
      "fields": {
        "Head": { "offset": "0x00", "type": "ptr", "comment": "Sentinel node. Its Parent (+0x08) is the tree root; the sentinel itself is never an element." },
        "Size": { "offset": "0x08", "type": "i64", "comment": "Element count - the sanity bound for a traversal." }
      }
    },

    "StdMapNode": {
      "comment": "MSVC std::map red-black tree node. Entities live in one keyed by entity id.",
      "fields": {
        "Left": { "offset": "0x00", "type": "ptr" },
        "Parent": { "offset": "0x08", "type": "ptr" },
        "Right": { "offset": "0x10", "type": "ptr" },
        "IsNil": { "offset": "0x19", "type": "u8" },
        "KeyId": { "offset": "0x20", "type": "u32" },
        "ValueEntityPtr": { "offset": "0x28", "type": "ptr" }
      }
    },

    "Entity": {
      "fields": {
        "EntityDetailsPtr": { "offset": "0x08", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "ComponentsVec": {
          "offset": "0x10", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 256 },
          "comment": "Vector of component pointers, indexed by ComponentLookup. begin = +0x10, end = +0x18."
        },
        "ComponentsVecLast": { "offset": "0x18", "type": "ptr", "comment": "End pointer of ComponentsVec (component count = (end - begin) / 8)." },
        "Id": { "offset": "0x88", "type": "u32" },
        "Flags": {
          "offset": "0x8C", "type": "u8",
          "comment": "Bit 0 clear = entity valid (GameHelper2 EntityOffsets.cs; was 0x84). NEEDS IN-GAME VERIFY on the 0.5 client - revert to 0x84 if validity regresses."
        }
      }
    },

    "EntityDetails": {
      "fields": {
        "Path": {
          "offset": "0x08", "type": "stdWString",
          "comment": "The metadata path, e.g. Metadata/Monsters/... Everything classifies entities by this string."
        },
        "ComponentLookupPtr": { "offset": "0x28", "type": "ptr", "invariant": { "kind": "nonNullPtr" } }
      }
    },

    "ComponentLookup": {
      "fields": {
        "Bucket": { "offset": "0x28", "type": "ptr", "comment": "Hash buckets of (namePtr, index) entries mapping component name -> ComponentsVec index." }
      }
    },

    "ComponentLookupEntry": {
      "comment": "One hash-bucket entry (0x10 bytes): a component name pointer and the index of that component in the entity's ComponentsVec. Index is a 32-BIT int at +0x08 (the AHK reference reads it as \"Int\"); reading it as 64-bit combines it with the next field and yields garbage for every entry whose following 4 bytes are non-zero - which drops most components (found 2026-08 by tracing a real recording: only entries whose high dword happened to be 0 decoded).",
      "consts": { "Size": "0x10" },
      "fields": {
        "NamePtr": { "offset": "0x00", "type": "ptr" },
        "Index": { "offset": "0x08", "type": "i32" }
      }
    },

    "StdBucket": {
      "comment": "MSVC hash-bucket array behind ComponentLookup.Bucket. Data/DataLast bracket an array of ComponentLookupEntry; Capacity is the bucket count. Ported from the AHK tool's PoE2Offsets.StdBucket.",
      "fields": {
        "Data": { "offset": "0x00", "type": "ptr" },
        "DataLast": { "offset": "0x08", "type": "ptr" },
        "Capacity": { "offset": "0x20", "type": "i32" }
      }
    },

    "Render": {
      "comment": "Component: world position + model bounds + the name the game shows.",
      "fields": {
        "Name": {
          "offset": "0x160", "type": "stdWString",
          "comment": "The readable name - 'Elder Madox' on Metadata/NPC/League/Affliction/ElderMadoxMapIntro. FOUND LIVE (2026-08, owner, in the dissector): a pointer with size 11 one qword on - exactly the length of the text it points at - and capacity 15 after that. A std::wstring, and the layout ReadStdWString already expects. CORRECTED ONCE, and the correction is the useful part: it was first entered as 0xA0, read straight off the dissector's row numbers, which are relative to whatever the VIEW starts at rather than to the component. That view began at Render+0xC0, proved by its own contents - the row at view+0x78 held 14548.91/15711.96, which is CurrentWorldPosition at Render+0x138, and 0x138-0xC0 is 0x78. So every row was 0xC0 low. Read a dissector row as an offset only after checking where the view starts. It also fits: 0x160..0x178 is empty space between CharacterModelBounds (ends 0x150) and TerrainHeight (0x1B0). CONFIRMED IN-GAME (2026-08) across a whole area, and it carries more than expected: NPCs ('Elder Madox', 'Alva'), chests ('Vaal Chest', 'Pot'), and - the useful surprise - area transitions, which name WHERE THEY GO ('Shoreline Hideout', 'Vaal Ruins') on both the portal entity and the terrain piece that is one. Scenery, effects and ground items read empty, which is why every consumer falls back to the metadata path. THE ONE EXCEPTION IS YOUR OWN CHARACTER, which reads the class - 'Sorceress' - and not the name you chose. That is worth knowing twice over: GameHelper2 has this field commented out as 'ClassName' at 0xA0, which is what you would call it having looked at the player and nothing else, and 0xA0 is also exactly where a misread dissector row first put it here. A stale offset agreeing with a wrong reading is not corroboration."
        },
        "CurrentWorldPosition": {
          "offset": "0x138", "type": "f32",
          "comment": "x; y at +0x13C, z at +0x140."
        },
        "CharacterModelBounds": { "offset": "0x144", "type": "f32" },
        "TerrainHeight": { "offset": "0x1B0", "type": "f32" }
      }
    },

    "Life": {
      "comment": "Component. DRIFT HISTORY: vital bases shifted in 4.5.x (Health 0x1A8->0x1B0, Mana 0x1F8->0x208, ES 0x230->0x248); confirmed in-game via component probe. Matches GameHelper2 Life.cs. Each vital is a Vital sub-struct.",
      "fields": {
        "Health": { "offset": "0x1B0", "type": "ptr", "comment": "Vital sub-struct base, not a pointer - read Vital fields relative to this offset." },
        "Mana": { "offset": "0x208", "type": "ptr" },
        "EnergyShield": { "offset": "0x248", "type": "ptr" }
      }
    },

    "Vital": {
      "comment": "Sub-struct of Life (per vital). THE PERCENTAGE IS AGAINST THE UNRESERVED POOL, not against Max - GameHelper2's VitalStruct: reservedTotal = ceil(ReservedPercent / 10000 * Max) + ReservedFlat, then percent = round(100 * Current / (Max - reservedTotal)). Getting that wrong is not subtle: with half of mana reserved by auras, a FULL mana globe reads 50% against Max, so anything thresholded on it fires forever.",
      "fields": {
        "ReservedFlat": { "offset": "0x10", "type": "i32", "comment": "Flat amount reserved, subtracted from Max directly." },
        "ReservedPercent": { "offset": "0x14", "type": "i32", "comment": "Reserved share in HUNDREDTHS OF A PERCENT: divide by 10000 to get a fraction (5000 = 50%). Named ReservedFraction here before it was read; the reference name and scale now match." },
        "Regen": { "offset": "0x28", "type": "f32" },
        "Max": { "offset": "0x2C", "type": "i32", "comment": "GameHelper2 calls this Total." },
        "Current": { "offset": "0x30", "type": "i32" }
      }
    },

    "Positioned": {
      "fields": {
        "Reaction": {
          "offset": "0x1E0", "type": "u8",
          "comment": "(reaction & 0x7F) == 1 means friendly. Feeds isFriendly everywhere."
        }
      }
    },

    "Targetable": {
      "comment": "Component. Offsets located via the chest closed-vs-opened diff probe (v4.5.1.1.4).",
      "fields": {
        "IsTargetable": {
          "offset": "0x69", "type": "u8",
          "invariant": { "kind": "range", "min": 0, "max": 1 },
          "comment": "The ONLY byte that flips closed(1)/opened(0) across 20+2 chests; also 1 for living monsters, 0 for corpses. Drives highlighting, corpse detection and the kill counter."
        },
        "IsTargetedByPlayer": { "offset": "0x6B", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 }, "comment": "Hover-diff confirmed: only the attacked monster's byte flipped 0->1." },
        "HiddenFromPlayer": { "offset": "0x59", "type": "u8" }
      }
    },

    "Actor": {
      "comment": "Component: animation + skills + cooldowns.",
      "fields": {
        "AnimationId": {
          "offset": "0x8B0", "type": "i32",
          "invariant": { "kind": "range", "min": 0, "max": 8192 },
          "comment": "DRIFT HISTORY: was 0x8A0, shifted +0x10. The old offset FROZE at 0 while acting - the 'changes' symptom. Confirmed via ActorProbe: 0x8B0 cycles Idle(0)/FixedRun(195)/DodgeRoll(268) and skill CastTypes. (0x380 is a locomotion-LAYER field, not this.) Vector offsets below did NOT move with it."
        },
        "ActiveSkills": {
          "offset": "0xB08", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 16, "maxCount": 512 },
          "comment": "Full granted-skill table (42 entries for a 9-gem char is CORRECT - it includes non-equipped granted effects)."
        },
        "Cooldowns": {
          "offset": "0xB20", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 256 },
          "comment": "Count stays at the number of cooldown-capable skills; live timers are inside each entry's cdList, not the list size."
        },
        "DeployedEntities": { "offset": "0xC18", "type": "stdVector", "comment": "Empty (begin=end) with no minions/totems out - that is not a drift." }
      }
    },

    "LoadedFilesRoot": {
      "comment": "What the FileRoot static points at: an ARRAY of BucketCount buckets, each BucketSize apart. GameHelper2's LoadedFilesRootObject, whose TotalCount is 0x10. The name says hash map and the layout says otherwise - each bucket is a plain vector with a capacity beside it, so walking one needs no hashing.",
      "fields": {},
      "consts": {
        "BucketCount": "0x10",
        "BucketSize": "0x38"
      }
    },

    "LoadedFilesBucket": {
      "comment": "One bucket. Data is a StdVector of FileRecordSlot; Capacity is one LESS than the real capacity, and is only read as a sanity gate - the vector's own first/last say how many there are.",
      "fields": {
        "Data": { "offset": "0x00", "type": "stdVector" },
        "Capacity": { "offset": "0x18", "type": "i32" }
      }
    },

    "FileRecordSlot": {
      "comment": "One slot in a bucket's vector. Three pointers; only the middle one leads anywhere. An EMPTY slot is ordinary - a hash table is mostly empty - so a null or unreadable record here is not an error.",
      "fields": {
        "Record": { "offset": "0x08", "type": "ptr" }
      },
      "consts": { "Size": "0x18" }
    },

    "FileRecord": {
      "comment": "One loaded file. AreaChangeCount is the STAMP the game put on it when it loaded, and nothing re-stamps it - so the files carrying the newest stamp in the table are the ones the current area brought in. MEASURED LIVE (2026-08), and it disagrees with the reference: GameHelper2 puts the stamp at 0x40 and has 0x38 commented out as an UnknownConstant, and here it is the other way round. With the counter static reading 13, a sweep of 3999 records found 13 at +0x38 in 465 of them and NOWHERE at +0x40, where all 3999 held a flat 2. 465 records carrying the current area's stamp is what a freshly loaded map looks like; a field reading the same number in every record is a constant, not a stamp. GameHelper2 skips stamps below 3 because the first couple of areas of a session load the whole menu with them, and that is kept.",
      "fields": {
        "Name": { "offset": "0x08", "type": "stdWString" },
        "AreaChangeCount": { "offset": "0x38", "type": "i32" }
      },
      "consts": { "IgnoreFirstAreas": "2" }
    },

    "AtlasPanel": {
      "comment": "UNVERIFIED - ported from GameHelper2's ImportantUiElements (which credits yokkenUA's Atlas plugin), read on 2026-08 and not yet confirmed against this client. Nothing here has been seen working; the first live run should expect to correct it. The atlas panel is a fixed CHILD PATH from the game-UI root - 22, 0, 6 - and its children are the nodes, the you-are-here marker and the region buttons mixed together. They are told apart by the UiElement Flags word (0x180) with the visible bit (0x800) masked off, which acts as a type fingerprint.",
      "fields": {
        "ConnectionsVector": { "offset": "0x5A8", "type": "stdVector", "comment": "EVERY line on the atlas, once, on the PANEL - not a per-node neighbour list. Drift history: this project first read it at the same offset on each NODE element, where a node's own bytes occasionally pass for two pointers a small distance apart, so most nodes reported no connections at all and a few reported invented ones. The symptom was a route drawn to the right map by a way nobody can walk. Entries are 0x14 bytes: an unknown i32, then the source grid pair, then the target grid pair." }
      },
      "consts": {
        "PathFromUiRoot0": "22",
        "PathFromUiRoot1": "0",
        "PathFromUiRoot2": "6",
        "VisibleMask": "0x800",
        "MapNodeFingerprint": "0x542EF3",
        "MistNodeFingerprint": "0x442EF3",
        "CurrentNodeMarkerFingerprint": "0x502EF3",
        "OceanRegionButtonRow": "2",
        "ConnectionEdgeStride": "0x14",
        "ConnectionEdgeSource": "0x04",
        "ConnectionEdgeTarget": "0x0C"
      }
    },

    "AtlasNode": {
      "comment": "UNVERIFIED, same provenance as AtlasPanel. One node of the endgame atlas, which is a UiElement with its own data hanging off it. THE DATA IS NOT IN THE ELEMENT: the reference reads [node+0x10] (the children vector's first pointer) and then +0x20 into that, and the biome, status and map id live at the END of that chain, while the grid position sits on the element itself. Status is a bit field, not a number: 0x02 completed, 0x01 accessible, neither means locked.",
      "fields": {
        "GridPosition": { "offset": "0x320", "type": "i32", "comment": "x here, y at +0x324. On the node ELEMENT, not on its data. The same offset on a region button is a row pointer, which is why the fingerprint has to be checked first." },
        "ContentVector": { "offset": "0x350", "type": "stdVector", "comment": "Content tokens for a rendered node, four bytes each. Only a node the game has drawn has them." },
        "BadgeVectorBegin": { "offset": "0x368", "type": "ptr", "comment": "A vector of BYTES, one per badge, not of pointers: each is an EndgameMapContent ROW and the content id is the row plus 100. It is filled from the server's cell state rather than from the drawing, so it survives fog and culling - which is why it is worth having as well as the badge children." },
        "BadgeVectorEnd": { "offset": "0x370", "type": "ptr" }
      },
      "consts": {
        "DataStoragePtr": "0x10",
        "DataPtr": "0x20",
        "RitualModsChild": "0x3B8",
        "BadgeChild0": "0",
        "BadgeChild1": "0",
        "BadgeContentId": "0x188",
        "BadgeRowToContentId": "100",
        "CompletedBit": "0x02",
        "AccessibleBit": "0x01"
      }
    },

    "AtlasRitual": {
      "comment": "UNVERIFIED, same provenance as AtlasPanel and with the same warning doubled: these were reverse-engineered by yokkenUA against a client of the day, from live-memory observation plus Ghidra analysis of AtlasPanel_ritualLineToggleNode and ritualLineNextCandidates, and NOTHING here has been seen working against this client. They hang off the atlas panel element, so a wrong panel path makes every one of them read rubbish - check the atlas itself first. The ritual line is the 'Head of the King' line: page mode 6, a line id that seeds the reward roll, a vector of clicked-but-unconfirmed grid positions and one of committed ones, plus a precomputed table of which nodes may follow which.",
      "fields": {
        "LineMode": { "offset": "0x637", "type": "u8", "comment": "Non-zero while the panel is in ritual-line mode (page mode 6). Everything else here is meaningless when it is zero." },
        "LineId": { "offset": "0x63C", "type": "u32", "comment": "Seed word 0 of the reward roll. Changes when the line is re-rolled." },
        "PendingVector": { "offset": "0x648", "type": "stdVector", "comment": "Grid positions clicked but not yet confirmed. Pairs of int32." },
        "CommittedVector": { "offset": "0x660", "type": "stdVector", "comment": "Grid positions already on the line. Its COUNT is seed word 1 of the roll." },
        "CandidateTableBegin": { "offset": "0x590", "type": "ptr" },
        "CandidateTableEnd": { "offset": "0x598", "type": "ptr", "comment": "The precomputed next-candidate table the game binary-searches. Entries of 0x44 bytes: node x,y then five (x,y,extra) triples, (0,0) meaning an empty slot." }
      },
      "consts": {
        "CandidateEntryStride": "0x44",
        "MaxCandidates": "5",
        "StatsFirstHop": "0x320",
        "StatsSecondHop": "0x1B0",
        "StatsHolder": "0x3A20",
        "StatsBegin": "0x408",
        "StatsEnd": "0x410",
        "StatsStride": "0x28",
        "StatsValueOffset": "0x08",
        "PickCounterPath0": "22",
        "PickCounterPath1": "2",
        "PickCounterPath2": "0",
        "PickCounterFingerprint": "0x502EE1",
        "TextOffset": "0x4C0"
      }
    },

    "AtlasNodeData": {
      "comment": "UNVERIFIED, same provenance. What the two-hop chain off a node element leads to.",
      "fields": {
        "MapDataPtr": { "offset": "0x2A0", "type": "ptr", "comment": "-> wrapper -> string header -> buffer: the locale-independent map id, e.g. MapUniqueReactor_04." },
        "ContentName": { "offset": "0x290", "type": "stdWString" },
        "BiomeId": { "offset": "0x2CE", "type": "u8" },
        "StatusBits": { "offset": "0x2CF", "type": "u8" }
      }
    },

    "Chest": {
      "fields": {
        "ChestDataPtr": { "offset": "0x160", "type": "ptr" },
        "IsOpened": { "offset": "0x168", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 } }
      }
    },

    "ChestData": {
      "fields": {
        "IsLabelVisible": { "offset": "0x21", "type": "u8" },
        "StrongboxDatPtr": { "offset": "0x50", "type": "ptr" }
      }
    },

    "Monster": {
      "fields": {
        "IsBoss": { "offset": "0x27", "type": "u8", "comment": "HYPOTHESIS from Sikaka/POE2Radar - VERIFY in-game against a known boss before relying on it." }
      }
    },

    "TriggerableBlockage": {
      "comment": "The barrier a trial or an encounter puts across a doorway. COPIED FROM GameHelper2 (TriggerableBlockageOffsets), not yet seen in this game - the entity browser listed it as a component nobody here had written a byte of, and the reference already had it. Verify by standing at a closed barrier and watching the row flip when it opens.",
      "fields": {
        "IsBlocked": { "offset": "0x30", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 }, "comment": "1 while the way is shut." }
      }
    },

    "Shrine": {
      "comment": "COPIED FROM GameHelper2 (ShrineOffsets), not yet verified here. Two more fields sit commented out in that file and are worth the look if this one proves right: EntityIdWhoLastPickedTheShrine at 0x20, and a pointer to the Shrines dat row at 0x30 - the latter would name the shrine, since that row starts with its Id string.",
      "fields": {
        "IsUsed": { "offset": "0x24", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 }, "comment": "1 once somebody has taken it." }
      }
    },

    "Inventories": {
      "comment": "Component: what an entity itself carries - a monster's equipment, a chest's contents. NOT the ServerData 'Inventory' further down, which is the player's stash and backpack reached through PlayerInventories; the two share a word and nothing else. NOWHERE IN EITHER REFERENCE - GameHelper2's Objects/Components/ holds 21 files and no inventory among them - so all of this was read off the live dissector (2026-08, owner, on a VultureDemon@75) with nothing to corroborate it. THE COMPONENT IS AN ARRAY, which is what the plural name was saying all along: sub-objects of 0x150 bytes lying inline, the first starting at the component address itself, two of them seen. Three independent things say 0x150: the module pointers at +0x000 and +0x018 repeat exactly at +0x150 and +0x168 (same vtable, same type), the vector below repeats at +0x170, and its inline buffer repeats at +0x188. EACH SUB-OBJECT OWNS A VECTOR WITH INLINE STORAGE, and that is why most of the component reads as empty: begin/end/capacity at +0x20/+0x28/+0x30 point back INTO the sub-object, at +0x38, where 16 slots run to +0xB8. Two entries in the first sub-object, three in the second, and in both the rows go empty at exactly the address 'end' holds. A begin pointer landing inside the structure you are looking at is the tell for inline storage - the empty rows after it are unused slots, not undecoded fields, and reading them as fields is a day lost. WHAT THE ENTRIES ARE IS STILL OPEN: they were followed live and none is a dat row, so the search that went looking for one is closed, not unfinished. ALSO OPEN: +0x158, where the second sub-object's header would put OwnerEntity, holds something other than the entity +0x008 holds - so either the sub-objects are not all the same thing, or that field is not the owner. A third copy at +0x2A0 would settle it.",
      "consts": { "SubObjectStride": "0x150", "InlineBuffer": "0x38", "InlineSlots": "16" },
      "fields": {
        "EntriesVec": {
          "offset": "0x20", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 16 },
          "comment": "begin, with end at +0x28. Pointers, 8 bytes each. maxCount is the inline capacity, so a count above 16 means this is not the vector any more."
        },
        "EntriesVecLast": { "offset": "0x28", "type": "ptr", "comment": "Vector end; count = (Last - First) / 8." },
        "EntriesCapacityEnd": { "offset": "0x30", "type": "ptr", "comment": "End of the inline buffer: begin + 0x80. Its distance from begin is what says the storage is inline and 16 slots wide." }
      }
    },

    "Component": {
      "comment": "The two fields EVERY component starts with, whatever it is. Worth having as a layout of its own because it is what orients you in one nobody has decoded: the first row says WHICH TYPE this is and the second says whose it is, so a window of unknown bytes already has two rows that mean something. Confirmed live on a DemonicApparitionPortal's Transitionable, where OwnerEntity held exactly the entity address the browser was showing. Named ComponentHeader in the AHK tool.",
      "fields": {
        "StaticPtr": {
          "offset": "0x00", "type": "ptr",
          "comment": "The component's TYPE descriptor - identical across every instance of the same component, so it fingerprints the type. Two rows sharing this value are the same kind of thing."
        },
        "OwnerEntity": { "offset": "0x08", "type": "ptr", "comment": "The entity this component belongs to." }
      }
    },

    "Transitionable": {
      "comment": "Component: the open/closed/activated state of a thing that changes - doors, levers, shrines, barricades. Both references agree on this offset (the AHK tool reads it as a short, GameHelper2 as an int), which is as close to certain as an offset gets here.",
      "fields": {
        "CurrentState": { "offset": "0x120", "type": "i16" }
      }
    },

    "StateMachine": {
      "comment": "Component: an entity's named states, and which one it is in. From the AHK tool's decoder. The names are not stored with the values: StatesPtr leads to an array of StdString at StateNamesBase, each StateNameSize apart, indexed by the state's number.",
      "fields": {
        "CurrentState": { "offset": "0x120", "type": "i16", "comment": "Same offset as Transitionable.CurrentState - the AHK decoder reads it through that constant." },
        "StatesPtr": { "offset": "0x158", "type": "ptr" },
        "StatesValuesFirst": { "offset": "0x160", "type": "ptr", "comment": "StdVector begin." },
        "StatesValuesLast": { "offset": "0x168", "type": "ptr", "comment": "StdVector end." }
      },
      "consts": { "StateNamesBase": "0x10", "StateNameSize": "0xC0" }
    },

    "Animated": {
      "comment": "Component: the model an entity actually loaded. Worth having because it tells apart entities that SHARE a metadata path but look different - the ExpeditionMarker flag variants were the case that needed it. The path is two hops away: ModelInfoPtr -> AnimatedModelInfo.ModelFileRecordPtr -> FileInfoValue.Name. Both references agree.",
      "fields": {
        "AnimatedEntityPtr": { "offset": "0x280", "type": "ptr" },
        "ModelInfoPtr": { "offset": "0x358", "type": "ptr" }
      }
    },

    "AnimatedModelInfo": {
      "comment": "Behind Animated.ModelInfoPtr. Leads to the file record of the loaded .ao model.",
      "fields": {
        "ModelFileRecordPtr": { "offset": "0x18", "type": "ptr" }
      }
    },

    "FileInfoValue": {
      "comment": "A GGPK file record. Name is the file's path - here, the .ao model.",
      "fields": {
        "Name": { "offset": "0x08", "type": "stdWString" }
      }
    },

    "Pathfinding": {
      "comment": "Component: how a monster moves. From the AHK tool, which probed it in-game.",
      "fields": {
        "Flying": { "offset": "0xE5", "type": "u8", "comment": "Non-zero on flying entities - they ignore the walkable grid, so a route to one means nothing." },
        "BaseSpeed": { "offset": "0xEC", "type": "i32" }
      }
    },

    "AreaTransition": {
      "comment": "Component on portals and zone exits. HYPOTHESIS from Sikaka/POE2Radar, carried over UNVERIFIED by the AHK tool - and neither field says where the transition LEADS, which is the thing actually worth having. Treat as a starting point, not as known.",
      "fields": {
        "GracePeriod": { "offset": "0x18", "type": "i32" },
        "TeleportDelay": { "offset": "0x1C", "type": "i32" }
      }
    },

    "BaseEvents": {
      "comment": "NOT WORTH DECODING, and that is the finding rather than a gap. The AHK tool dumped this in-game and found engine dispatch plumbing: vtables in the module's own range and intrusive linked-list nodes, with no named-field data. A decoder could only ever surface handler counts. The one useful signal is the ENTITY POINTERS it embeds - an NPC's BaseEvents references other entities - so look at those in the dissector rather than writing a reader for this."
    },

    "Functions": {
      "comment": "NOT WORTH DECODING - engine dispatch plumbing, same finding as BaseEvents. Proven in-game by the AHK tool, not assumed."
    },

    "InteractionAction": {
      "comment": "NOT WORTH DECODING - engine dispatch plumbing, same finding as BaseEvents. Proven in-game by the AHK tool, not assumed."
    },

    "Buffs": {
      "comment": "Component: every buff and debuff currently on the entity. NOTE A DELIBERATE DIVERGENCE FROM GameHelper2: it reads this vector as StdVector<IntPtr> and dereferences each element, whereas in PoE2 the entries are stored INLINE, 0x50 apart, which is how the AHK tool reads them in production. Where the two references disagree, the PoE2-specific one wins - dereferencing an inline struct here yields garbage.",
      "fields": {
        "StatusEffectFirst": { "offset": "0x160", "type": "ptr", "comment": "StdVector begin: first inline StatusEffect." },
        "StatusEffectLast": { "offset": "0x168", "type": "ptr", "comment": "StdVector end; count = (Last - First) / StatusEffectStructSize." }
      },
      "consts": { "StatusEffectStructSize": "0x50" }
    },

    "BuffDefinition": {
      "comment": "The static description a StatusEffect points at, and A ROW OF BuffDefinitions.dat - so its offsets are computable rather than searchable, see the note above WorldAreaDat. BuffType 0x04 marks a FLASK buff, which is what makes 'is this flask still active' answerable without name matching.",
      "fields": {
        "Name": { "offset": "0x00", "type": "utf16Ptr", "comment": "-> raw UTF-16 string, NOT a StdWString, e.g. \"flask_effect_life\". This is the table's Id column, i.e. the ENGINE identifier, which is what we want: it stays English on a localised client. The localised display name is a separate column at 0x12, and the description at 0x08, if either is ever wanted for the UI." },
        "BuffVisualsKey": { "offset": "0x5D", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "DERIVED, NOT OBSERVED - declared, never read, and never seen in a live game. It was 0x55, which is where the BuffVisual COLUMN starts; that column is a 16-byte table reference followed by a row reference, so the pointer is the second half. Two independent references agree on the +8: the AHK tool's .datc64 layout, and GameHelper2 reading GrantedEffects.ActiveSkillDatPtr at 0x57 where that column starts at 0x4F. The invariant is there so the claim is checkable rather than argued about, but note that nothing checks it today: the drift report walks GameState -> InGameState -> AreaInstance/WorldData -> LocalPlayerStruct, and this row is not on that chain. It costs nothing and settles the question the moment anyone validates a BuffDefinition." },
        "BuffType": { "offset": "0x67", "type": "u8", "comment": "0x04 = flask buff. The column is really called BuffCategory and is an i32; reading the low byte works and is what the reference does, but the upper three bytes are not padding - they are part of the value." }
      },
      "consts": { "BuffTypeFlask": "0x04" }
    },

    "StatusEffect": {
      "comment": "One active buff or debuff, INLINE in the Buffs vector at 0x50 stride.",
      "fields": {
        "BuffDefinitionPtr": { "offset": "0x08", "type": "ptr", "comment": "-> BuffDefinition, which carries the name and the type." },
        "TotalTime": { "offset": "0x18", "type": "f32" },
        "TimeLeft": { "offset": "0x1C", "type": "f32", "comment": "Seconds remaining. The signal for 'this flask is still doing its job'." },
        "SourceEntityId": { "offset": "0x28", "type": "u32" },
        "RawStage": { "offset": "0x2C", "type": "u32", "comment": "The buff's internal stage counter, for effects that ramp up while they run. RAW is the load-bearing word: this is NOT the stage the game shows, and its scale is per-skill. GameHelper2 named it in commit 9a459ac and converts Whirling Slash (buff \"spear_sandstorm\") with (RawStage - 15) / 3 - it starts at 15 and steps by 3. So a consumer needs a calibration per skill, not one shared formula, and the only skill anyone has verified is that one. Second trap from the same commit: that buff does NOT sit on the player. The skill spawns its own effect entity (path contains sandstorm_swipe/sandstorm_swipe_storm) and the buff hangs off THAT entity, so reading only the player's Buffs never sees it." },
        "Charges": { "offset": "0x40", "type": "i16", "comment": "SIGNED - the reference reads a short." },
        "FlaskSlot": { "offset": "0x42", "type": "i16", "comment": "RAW slot 0-4 for a flask buff, i.e. belt slot 1-5; anything outside that range means this buff did not come from a flask. Signed short, not a byte." },
        "Effectiveness": { "offset": "0x48", "type": "i16", "comment": "Percentage delta: the effective value is 100 + this." }
      }
    },

    "Stats": {
      "comment": "The component. It holds no stat pairs itself - it holds POINTERS to StatsInternal sub-structures, and the pairs live in those. Written down because the layout invited exactly one wrong reading and got it: StatsInternalStatsVector was declared here as though 0xF8 were an offset into the component, and reading it that way returns a zeroed field on every entity, which then looks like 'this entity has no stats'. Verified against a flame wall in a recorded session: Stats+0xF8 and Stats+0x100 both read 0x0, while the AHK tool reaches the same data through StatsByItems and StatsByBuffAndActions. Offsets from that tool, which is battle-tested against PoE2.",
      "fields": {
        "StatsByItems": { "offset": "0x160", "type": "ptr", "comment": "-> StatsInternal: what the entity's gear gives it." },
        "CurrentWeaponIndex": { "offset": "0x168", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 8 } },
        "ShapeshiftPtr": { "offset": "0x170", "type": "ptr", "comment": "Non-null while shapeshifted." },
        "StatsByBuffAndActions": { "offset": "0x1C8", "type": "ptr", "comment": "-> StatsInternal: what buffs and actions give it. The one a skill's own numbers would be in." }
      }
    },

    "StatsInternal": {
      "comment": "A bag of (stat id, value) pairs, pointed at by the Stats component. The ids are the game's own, out of its Stats table - 347 is base_skill_effect_duration, 351 is skill_effect_duration.",
      "fields": {
        "StatsVector": {
          "offset": "0xF8", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 8192 },
          "comment": "Vector of (key u32, value i32) pairs, inline at an 8-byte stride."
        },
        "StatsVectorLast": { "offset": "0x100", "type": "ptr", "comment": "End of the vector; count = (Last - First) / 8." }
      }
    },

    "Mods": {
      "comment": "Component on items and rare/magic monsters.",
      "fields": {
        "Identified": { "offset": "0x90", "type": "u8" },
        "Rarity": { "offset": "0x94", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 10 } },
        "StatsFromMods": { "offset": "0x148", "type": "stdVector", "comment": "The item's RESOLVED stats as (stat id, value) pairs - what the game shows on the item, already summed across its mods. The per-mod vectors say which mods are on it; this says what they add up to." },
        "AllMods": { "offset": "0xA0", "type": "stdVector" }
      }
    },

    "ObjectMagicProperties": {
      "comment": "Rarity and mods, for the things that carry this INSTEAD of a Mods component - monsters, and on the item side flasks, gems and some magic items. Which of the two an item has cannot be told from its path, so a reader tries both and keeps whichever decodes better. The rarity range stays 0-10 because monsters use more of it than items do. Ground drops: currency and fragments carry no rarity component at all - classify those by path (contains /Currency/), not by a rarity read of -1. The two offsets below were reached separately by the AHK tool (imm0r/PoEformance) and by this project, which is as close to confirmation as an offset gets without the game.",
      "fields": {
        "Rarity": { "offset": "0x144", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 10 } },
        "AllMods": { "offset": "0x150", "type": "stdVector", "comment": "Five vectors in a row - implicit, explicit, enchant, and two league ones - each 0x18 bytes." },
        "StatsFromMods": { "offset": "0x1F8", "type": "stdVector", "comment": "The resolved (stat id, value) pairs, as the Mods component has at 0x148." }
      }
    },

    "WorldItemComponent": {
      "comment": "On a ground-drop WRAPPER entity (Metadata/MiscellaneousObjects/WorldItem). The wrapper has no rarity/art of its own.",
      "fields": {
        "InnerItem": {
          "offset": "0x28", "type": "ptr",
          "invariant": { "kind": "stringContains", "needle": "Metadata/", "hops": ["0x00", "0x08"], "stringAt": "0x08" },
          "comment": "The real ITEM entity (path/rarity/Mods/RenderItem). Confirmed in-game 2026-06-23; keep a 0x08..0xA0 sweep as the patch-shift fallback."
        }
      }
    },

    "Stack": {
      "fields": {
        "StackSizeDataPtr": { "offset": "0x10", "type": "ptr", "comment": "Shared per-base-type StackSizeData descriptor (two Wisdom stacks resolve to the same pointer)." },
        "Count": { "offset": "0x18", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 100000 } }
      }
    },

    "StackSizeData": {
      "comment": "Per-context stack caps, verified in-game 2026-07-04. The container-type signal is NOT in the inventory struct's first bytes - display logic picks the smallest cap that still fits the current count.",
      "fields": {
        "MaxStackTab": { "offset": "0x20", "type": "i32", "comment": "Currency stash tab cap (Wisdom = 5000)." },
        "MaxStack": { "offset": "0x28", "type": "i32", "comment": "Normal cap: backpack AND normal stash tabs (Wisdom = 40)." }
      }
    },


    "StdVector": {
      "comment": "Not a game struct - the SIZE of a std::vector, which is three pointers: begin, end, and the end of the allocation. Needed because an item's five mod lists sit one after another in memory, so walking from one to the next is a stride of this. 0x18 is what the AHK tool strides by (AllMods + 0x18 * n across implicit/explicit/enchant/hellscape/crucible) and what GameHelper2's StdVector declares. DRIFT: nothing here can drift - it is the compiler's layout, not the game's - but it was MISSING from this file entirely, and the item reader asks for it in its constructor. That threw at start-up and took the whole tool down before the overlay ever appeared, from the commit that first read an item's mods until 2026-08-09.",
      "consts": {
        "StructSize": "0x18"
      }
    },

    "ModArray": {
      "comment": "One entry of a mod vector. The ROLLS live here and the stat ids do not: the mod's dat row says which stats it grants, and this holds only the numbers rolled for them - so a '+Life and +Mana' mod has two values and nothing here says which is which.",
      "fields": {
        "Values": { "offset": "0x00", "type": "stdVector", "comment": "The rolled values, 4 bytes each." },
        "Value0": { "offset": "0x18", "type": "i32", "comment": "A single roll, for the entries whose Values vector is empty." },
        "ModsPtr": { "offset": "0x28", "type": "ptr", "comment": "-> the Mods.dat row, whose first field is a pointer to the mod's id string." }
      },
      "consts": {
        "EntrySize": "0x40"
      }
    },

    "StatPair": {
      "comment": "A resolved stat: which one, and how much of it. The key is a ROW INDEX into Stats.dat rather than a name, so turning it into words needs the shipped stat table.",
      "fields": {
        "Key": { "offset": "0x00", "type": "i32" },
        "Value": { "offset": "0x04", "type": "i32" }
      },
      "consts": {
        "EntrySize": "0x08"
      }
    },

    "RenderItemComponent": {
      "fields": {
        "ResourcePath": { "offset": "0x28", "type": "stdWString", "comment": "2D inventory-art .dds path; the basename doubles as a price-lookup key." }
      }
    },

    "ItemBaseComponent": {
      "fields": {
        "UniqueIviRow": { "offset": "0x30", "type": "ptr", "comment": "ItemVisualIdentity dat row for uniques (0 for non-uniques); its +0x00 points to the IVI Id wide string." }
      }
    },

    "ItemVisualIdentityRow": {
      "comment": "The dat row ItemBaseComponent.UniqueIviRow points at. Its Id - \"FourUniquePinnacle1\" - is the ROBUST key for a unique: it is an engine identifier and stays English on a localised client, where the displayed name does not. data/unique_ivi_name_map.tsv turns it into the name price sites use. Chain and offsets from the AHK tool, live-verified there 2026-06-24.",
      "fields": {
        "IdPtr": { "offset": "0x00", "type": "ptr", "comment": "Points at the Id as a wide string." }
      }
    },

    "Player": {
      "fields": {
        "Name": { "offset": "0x1B0", "type": "stdWString" },
        "Xp": { "offset": "0x1D8", "type": "u64" },
        "Level": { "offset": "0x204", "type": "i32", "invariant": { "kind": "range", "min": 1, "max": 100 } }
      }
    },

    "ServerDataOffsets": {
      "comment": "What LocalPlayerStruct.ServerDataPtr actually points at. It is NOT the struct holding PlayerInventories - that one is reached through the vector below. Missing this hop reads PlayerInventories off the wrong base, where it is simply zero, which looks exactly like a drifted offset. Source: GameHelper2 ServerDataOffsets.",
      "fields": {
        "PlayerServerData": { "offset": "0x48", "type": "stdVector", "comment": "StdVector of pointers to ServerDataStructure; the first entry is the local player's." },
        "League": { "offset": "0x21E0", "type": "stdWString", "comment": "Active league name, EXACTLY poe.ninja/poe2scout's value (\"Standard\", \"HC Runes of Aldur\") - it drives price-league detection, so a wrong one silently prices a stash against another economy. ON THE OUTER STRUCT, not on the inner one the inventories are on, and that is the whole trap: it was read off the inner struct first and came back empty, which reads as 'not in the game yet' and cost every price in the tool. The AHK tool says which struct in the shape of its own resolve - the pointer it reads the league from is whichever one's +0x48 is a plausible vector, which is the OUTER by definition, while it reads inventories from what that vector points at. Confirmed from the other side in a recording, 2026-08-09: at this offset on the INNER struct sit two heap pointers interleaved with two into the module image - a pair of vtables - in the same frames where that struct's inventory vector reads 118 inventories perfectly. Value live-verified by the owner 2026-06-22 (AHK tool)." }
      }
    },

    "ServerDataStructure": {
      "comment": "Reached via ServerDataOffsets.PlayerServerData, not directly from ServerDataPtr.",
      "fields": {
        "PlayerInventories": {
          "offset": "0x320", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 24, "maxCount": 1024 }
        }
      }
    },

    "InventoryArray": {
      "consts": { "EntrySize": "0x18" },
      "fields": {
        "InventoryId": { "offset": "0x00", "type": "i32" },
        "InventoryPtr0": { "offset": "0x08", "type": "ptr" }
      }
    },

    "Inventory": {
      "fields": {
        "TotalBoxes": { "offset": "0x150", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 256 } },
        "TotalBoxesY": { "offset": "0x154", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 256 } },
        "ItemList": { "offset": "0x170", "type": "stdVector", "comment": "Vector of POINTERS to InventoryItem structs." },
        "ItemListLast": { "offset": "0x178", "type": "ptr", "comment": "Vector end; count = (Last - First) / 8." },
        "ServerRequestCounter": { "offset": "0x1E8", "type": "i32" }
      }
    },

    "ChargesComponent": {
      "comment": "Component on a flask item: how many charges it holds and what a use costs. Together they answer the only question that matters before pressing the key - is this flask usable AT ALL. Confirmed identically by GameHelper2's ChargesOffsets and the AHK tool.",
      "fields": {
        "ChargesInternalPtr": { "offset": "0x10", "type": "ptr", "comment": "-> ChargesInternal, which holds the per-use cost." },
        "Current": { "offset": "0x18", "type": "i32", "comment": "Charges the flask currently holds." }
      }
    },

    "ChargesInternal": {
      "comment": "The shared per-base-type descriptor a Charges component points at.",
      "fields": {
        "PerUseCharges": { "offset": "0x18", "type": "i32", "comment": "Cost of one use. A flask with fewer charges than this cannot be used." }
      }
    },

    "InventoryItem": {
      "fields": {
        "Item": { "offset": "0x00", "type": "ptr" },
        "SlotStart": { "offset": "0x08", "type": "i32" },
        "SlotStartY": { "offset": "0x0C", "type": "i32" },
        "SlotEnd": { "offset": "0x10", "type": "i32" },
        "SlotEndY": { "offset": "0x14", "type": "i32" }
      }
    },

    "UiElement": {
      "comment": "Game UI tree node. Scale conversion is per-element: v1 = (clientW - 2*cull)/2560, v2 = clientH/1600; ScaleIndex picks the pair, times LocalScaleMultiplier. Sanity-clamp everything - a mis-resolved GameCullSize or drifted ScaleIndex silently poisons every rect.",
      "fields": {
        "Self": { "offset": "0x08", "type": "ptr" },
        "Children": { "offset": "0x10", "type": "stdVector" },
        "StringId": { "offset": "0x98", "type": "stdWString", "comment": "Was 0x140 in the 0.4 layout - the 0.5 client moved it." },
        "LocalScaleMultiplier": { "offset": "0x130", "type": "f32", "comment": "Sanitize: accept 0.2..5.0, else treat as 1.0." },
        "Flags": { "offset": "0x180", "type": "u32", "comment": "Visibility bit lives here." },
        "ScaleIndex": { "offset": "0x18A", "type": "u8", "comment": "0.4-era offset; may have drifted in 0.5 - unknown index falls back to uniform scale." },
        "ItemPtr": {
          "offset": "0x4F8", "type": "ptr",
          "comment": "Item-slot elements: direct pointer to the item ENTITY. Source: coussiraty/CoreExile2 InventoryAdapters.cs (ItemPointerOffset = 0x4F8); verified live on a hovered Rare. Powers price-on-hover and ritual badges."
        }
      }
    }
  }
}
