{
  // PoEformance offset schema for Path of Exile 2.
  //
  // This file IS the reverse-engineering knowledge of the project. Offsets are data,
  // not code: edit here, hot-reload in the tool, no rebuild. Every field may declare
  // an "invariant" describing what a correct value looks like - the validator runs
  // them at attach time and turns silent offset drift into a red row in the report.
  //
  // Ported from the AHK tool's PoE2Offsets.ahk + StaticOffsetsPatterns.ahk, including
  // the drift history comments (they are the hard-won part).
  //
  // Conventions:
  //   offsets/consts   hex strings ("0x1A0") or decimal
  //   pattern          hex bytes, "??" wildcard, "^" marks the RIP disp32 position
  //   invariant kinds  range | plausiblePtr | nonNullPtr | unitVector3
  //                    | vectorSane | stringContains | changes

  // ── 999 AND 1000 ARE NOT VALUES, THEY ARE HALVES OF A POINTER ──────────────────
  // Written down because it is a trap this project has now walked into, and the shape of
  // it will catch the next reader too. A Cheat Engine four-byte scan found a slot that
  // read 999 while the cursor sat on an inventory item and 1000 while it did not - clean,
  // repeatable, two-state, and entirely an artefact of where the four-byte window sat.
  //   999 = 0x3E7, 1000 = 0x3E8: the TOP THIRTY-TWO BITS of a 64-bit heap pointer.
  // Measured on a 502,766-read recording: 99.41% of every four-byte 999 in it and 99.99%
  // of every 1000 sat at an address four past an eight-byte boundary, and the two were the
  // commonest non-zero high halves in the file (28.3% and 8.9% of 1.7M qwords). The game's
  // heap for that run spanned the 0x3E8_00000000 boundary, so a pointer either side of it
  // reads as one number or the other through a narrow window.
  //
  // WHICH PAIR IT IS DIFFERS PER LAUNCH. Across the committed fixtures: 1054/1055
  // (pid 28332), 646/647 (26584), 940/941 (27844), 1513 (20652), 999/1000 (17996) - the
  // same pid always gives the same pair, a new one never does. So a test written as
  // "== 999" is a test against one launch of the game. What carries meaning is the whole
  // eight bytes, and whether the pointer MOVED.
  //
  // The instrument for this is `--peek <path>` (Core/Diagnostics/AddressPeek.cs), which
  // takes a Cheat Engine path as written - "PathOfExileSteam.exe+468C3A8,235C" - shows the
  // aligned slot around an unaligned address, and with `--peekwatch` prints the slots that
  // move while something is done in the game.
  //
  // SETTLED, and it is NOT a mouse-over flag. tests/fixtures/session-2026-08-hover.rec is
  // ten seconds of --peekwatch over that slot (92 samples) and HoverSlotTests replays it.
  // What the two adjacent pointers at +0x2358 and +0x2360 turned out to be:
  //   - a std::shared_ptr. _Ptr at +0x2358, _Rep at +0x2360, and _Ptr is ALWAYS exactly
  //     _Rep + 0x10 in every settled sample, which is make_shared putting the payload inline
  //     behind the control block. Every value either has ever held carries the same control
  //     block vtable (module+0x30F2CB8), so it is one class rather than a pool.
  //   - the vector theory died on the slot after them. begin/end/capacity would put capacity
  //     at +0x2368; that slot changed in 89 of 92 samples and is a FLOAT CLOCK, 7754.7 s to
  //     7764.4 s across the 10.2 s the recording covers.
  //   - the payload names an ASSET. Two hops on (shared_ptr -> payload -> record) sit
  //     "UI GlyphMap" and "Art/Textures/Interface2/2DArt/UIImages/InGame/HUD/CharmBarBg.dds",
  //     with "Support Gem" and "LargeNormal" among the one-frame values. The object the
  //     static points at also shares its first field with a back-pointer found in loaded-file
  //     records, and this static sits 0xFA08 from FileRoot - it is the resource system.
  // So the field holds the resource record most recently handled. It CORRELATES with hovering,
  // because a tooltip pulls in the item's frame art and its class name, and it is not a
  // question about the mouse: over ten seconds it took eight distinct values, most of them for
  // a single frame. Not written into "structs" because nothing in the tool needs it - it is
  // recorded here so the next person who finds this slot does not spend the day twice.
  //
  // AtlasWatch.Hovered stands: PoE2 still keeps no hovered-UiElement slot. For "is the cursor
  // on an inventory item", the answer remains the geometric one - descend the UI tree to what
  // contains the cursor, then UiElement.ItemPtr at +0x4F8.
  //
  // WHAT THIS PARAGRAPH DOES NOT COVER, and was read as covering for months: the hovered
  // ENTITY. That one the game does keep, at InGameState+0x300 -> +0x3F0 -> +0xA8, and it was
  // confirmed in 2026-08 - see MouseOverHostPtr. The two questions look alike written down and
  // are answered in different places, so "no hovered slot" was carried over to a slot that
  // exists. A negative result is about the thing it tested; say which thing.

  "version": 1,
  "gameVersion": "0.5.x (AreaInstance tail re-verified 2026-08 by owner: +0x08 wave; base port: AHK tool v0.45.13.298, 2026-07)",

  "statics": {
    "GameStates": {
      "pattern": "48 39 2D ^ ?? ?? ?? ?? 0F 85 ?? ?? ?? ?? B9 40 01 00 00",
      "comment": "Root of everything: the game-state array."
    },
    "FileRoot": {
      "pattern": "48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B 05 ^ ?? ?? ?? ?? 48 83 C4 28",
      "comment": "Loaded-files root (GGPK file records)."
    },
    "AreaChangeCounter": {
      "pattern": "FF 05 ^ ?? ?? ?? ?? 4D 8B 06 49 8D 50 20",
      "comment": "The area-change counter: `inc [counter]` in the instance-load function. CONFIRMED IN CHEAT ENGINE (2026-08): it reads a small number that steps by one per zone, and matches the stamps in the loaded-file table. The reference's own pattern stops after `4D 8B 06` and hits TWICE here; the second hit points at unmapped memory, so it is a false positive, and the four bytes added (`49 8D 50 20`) are the first place the two diverge. An earlier attempt anchored a LOCKED increment instead (`49 89 46 ?? F0 FF 05 ^ ?? ?? ?? ?? 48 8B CD E8`) - it hit exactly once, which read as success, and resolved a DIFFERENT counter that stood at 188 while this one stood at 12. Lesson: a unique hit is not a correct one, and disambiguating a pattern means lengthening it AT ITS OWN SITE."
    },
    "TerrainRotatorHelper": {
      "pattern": "48 83 EC 38 41 0F B6 C0 4C 8B D1 4C 8B CA 48 8D 0D ?? ?? ?? ?? 44 0F B6 04 08 B8 08 00 00 00 8B 0A 44 3B C0 89 4C 24 24 BA 16 00 00 00 44 0F 47 C0 48 8D 05 ^ ?? ?? ?? ??",
      "comment": "Resolves the larger terrain-rotation array."
    },
    "TerrainRotationSelector": {
      "pattern": "48 83 EC 38 41 0F B6 C0 4C 8B D1 4C 8B CA 48 8D 0D ^ ?? ?? ?? ?? 44 0F B6 04 08 B8 08 00 00 00 8B 0A 44 3B C0 89 4C 24 24 BA 16 00 00 00 44 0F 47 C0 48 8D 05 ?? ?? ?? ??",
      "comment": "Rotation lookup table (00 03 02 01 04 ...). Same function as the helper, ^ on the FIRST lea. Upstream's 17-byte prologue-only form matches other functions too; the longer tail makes it unique."
    },
    "GameCullSize": {
      "pattern": "2B 0D ?? ?? ?? ?? 8B 05 ?? ?? ?? ?? 2B 05 ^ ?? ?? ?? ?? 0F 57 FF",
      "comment": "Letterbox bar width for UI-space -> screen conversion. A garbage value here silently poisons every width-scaled UI rect - clamp on use."
    }
  },

  "structs": {
    "GameState": {
      "comment": "The static GameStates pointer dereferences to this.",
      "fields": {
        "CurrentStateVecLast": {
          "offset": "0x10", "type": "ptr", "invariant": { "kind": "plausiblePtr" },
          "comment": "End pointer of the state STACK. The state in force is the SECOND-last entry (end - 0x10), not the last - GameHelper2 reads it that way and the last slot is not the active one."
        },
        "States": { "offset": "0x48", "type": "ptr", "comment": "Array of TotalStates entries, StateEntrySize apart; each entry starts with the state object's pointer. Index InGameStateIndex is the one the overlay may draw over." }
      },
      "consts": {
        "StateEntrySize": "0x10",
        "InGameStateIndex": "4",
        "TotalStates": "13"
      }
    },

    "InGameState": {
      "comment": "WHICH OF ITS FIELDS BELONG TO THE CHARACTER, measured rather than guessed. Two recordings of the SAME running game with two different characters - switched without restarting, so this object keeps its address - differ in 111 of 32768 bytes, and twelve of those are pointers leading somewhere else for the other character: 0x290 (AreaInstanceData), 0x2E8, 0x2F0 (UiRootStructPtr), 0x2F8, 0x300, 0x308, 0x388, 0x3A0, 0x4C0, 0x510, 0x5B8, plus two non-pointer words at 0x490 and 0x568. Everything else is the same object twice, WorldData at 0x368 included - which is worth knowing on its own: that one survives an area change rather than being rebuilt with it. The caveat that keeps this honest is that the two recordings differ in AREA as well as in character, so a changed pointer is character-scoped OR area-scoped and this does not say which. It is still the shortest list of places a character's own state can be, which is what --questflags now reads properly instead of giving each a kilobyte.",
      "fields": {
        "AreaInstanceData": {
          "offset": "0x290", "type": "ptr",
          "invariant": { "kind": "nonNullPtr" },
          "comment": "Null while not in an area; nonNullPtr is only meaningful in-game. Re-confirmed 0x290 in the 2026-08 check (an older external baseline had 0x288)."
        },
        "UiRootStructPtr": { "offset": "0x2F0", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "KB/M UI manager (UserInterface_MouseAndKeyboard)." },
        "MouseOverHostPtr": {
          "offset": "0x300", "type": "ptr", "struct": "MouseOverHost",
          "comment": "NO INVARIANT ON PURPOSE, even though it is now confirmed and read every frame: the drift report counts an UNREADABLE field as a failure, exactly as loudly as a wrong value, and every recording committed before 2026-08 predates anything reading this slot - so a plausiblePtr here turns the whole baseline replay red without a byte having moved. It is the recording-limits rule biting from the other side, and it goes away once the fixtures are re-made with a build that reads the chain. FIRST HOP OF THE HOVERED-ENTITY CHAIN, and CONFIRMED 2026-08 against a capture made for it (tests/fixtures/session-2026-08-hoverhunt.rec, --hoverhunt, 940 frames of deliberately hovering things). It had been written off: the note at the top of this file says PoE2 keeps no hovered slot, on the strength of a hunt for a hovered UI ELEMENT that found a resource record. A hovered ENTITY is a different question and nobody had asked it - the sessions that swept this region were --questflags captures in which nothing was hovered on purpose, so +0xA8 read zero, which is what nothing-hovered and a wrong offset look like alike. WHAT THE CAPTURE SETTLES: the host resolved in 932 of 940 frames, its +0x3F0 in all 932, and the entity slot behind that held something in 143 of them. Every single one of those 143 values - 143 of 143 - is an address the game itself was listing in AwakeEntities that frame, across ten distinct entities of four kinds (six Vaal monsters, two chests, an endgame checkpoint, a world item), and the slot took 50 different values over the session. IT IS NOT A NEAREST-ENTITY SLOT: it was EMPTY on 789 of 932 frames in an area holding 96 monsters, which is what a cursor pointing at floor looks like and not what proximity looks like. It also sits in the list of twelve pointers that differ between two characters (see this struct's comment), consistent with per-character UI state. Cost: three reads for 'the thing under the cursor', against a descent through the UI tree."
        },
        "GamepadUiRootStructPtr": { "offset": "0x318", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "Controller UI manager." },
        "WorldData": { "offset": "0x368", "type": "ptr", "invariant": { "kind": "nonNullPtr" }, "comment": "CONFIRMED 2026-08 and no longer suspect: it was flagged because AreaInstanceData moved +0x08 in the same wave, and nonNullPtr passes at either slot since both hold plausible pointers. The matrix hunt settled it - the camera matrix resolves correctly at THIS base + 0x1A0, and a projection that maps 123 real entities linearly cannot come from the wrong struct. The earlier W2SMatrix failure was a bad invariant, not a drifted WorldData." }
      }
    },

    "MouseOverHost": {
      "comment": "The object InGameState+0x300 leads to - the middle of the hovered-entity chain. Only one of its fields is understood, and that is the honest state of it: the capture that settled the chain read a 0x400 window of this object every frame, and nothing else in that window separated hovering from not hovering. The window is in tests/fixtures/session-2026-08-hoverhunt.rec, so the rest of it can be mined offline whenever there is a reason to.",
      "fields": {
        "SubStructPtr": {
          "offset": "0x3F0", "type": "ptr", "struct": "MouseOverSub",
          "invariant": { "kind": "plausiblePtr" },
          "comment": "Resolved in all 932 frames in which the host itself did. Named MouseOverSubStruct by GameHelper2; this client agrees at the same offset."
        }
      }
    },

    "MouseOverSub": {
      "comment": "The end of the hovered-entity chain. TWO of its slots track the cursor, and the second is SETTLED as of 2026-08 - it just turns out to be worth nothing on its own. Both +0xA8 and +0xC8 are zero in every idle frame and non-null in every hovering one, so either would serve as 'is something hovered'; the interesting part was what the second one holds, since it took a fresh address nearly every frame (135 distinct values over 143 hovering frames in the first capture, changing even while the same entity stayed hovered) and matched no entity and no component. session-2026-08-hoverboss.rec captured its target and the answer is small and complete: THE OBJECT IS 16 BYTES, {vtable, pointer}. Its +0x00 is one single module address across the whole session - one class - and its +0x08 is the HOVERED ENTITY PLUS 0x100, on 126 of 126 frames, for a monster and for a ground item alike. So it is a per-frame handle wrapping an interior pointer into the very entity that +0xA8 already names, and it carries nothing +0xA8 does not. Everything past +0x10 of that object is NEIGHBOURS, not fields: those offsets hold several different module addresses across the session where +0x00 holds exactly one, and most of them point back into the same small-object arena. Decoding them as this object's members is the Inventories mistake in a new costume. It stays out of the fields because there is no reason to read it.",
      "fields": {
        "HoveredEntity": {
          "offset": "0xA8", "type": "ptr", "struct": "Entity",
          "invariant": { "kind": "plausiblePtr" },
          "comment": "The entity under the cursor, or null. CONFIRMED 2026-08: 143 of 143 non-null readings were addresses in the game's own AwakeEntities list that frame, over ten entities and four kinds - monsters, a chest, a checkpoint, a ground item - and null on the other 789 frames. Monsters are not special to it: anything the game lets the cursor pick up appears here."
        }
      }
    },

    "AreaLoadingState": {
      "comment": "Fields of the AreaLoadingState game state (index 1).",
      "fields": {
        "IsLoading": { "offset": "0x770", "type": "i32", "comment": "Non-zero while an area is loading." },
        "TotalLoadingScreenTimeMs": { "offset": "0xEC0", "type": "u32", "comment": "Cumulative loading-screen time; increases on area change." },
        "CurrentAreaDetailsPtr": { "offset": "0xF40", "type": "ptr", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    "UiRootStruct": {
      "fields": {
        "UiRootPtr": { "offset": "0x340", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "GameUiPtr": { "offset": "0xBE0", "type": "ptr", "invariant": { "kind": "plausiblePtr" } },
        "GameUiControllerPtr": { "offset": "0xBE8", "type": "ptr", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    // ── The in-game map: a SECOND screen-space system, independent of W2SMatrix ──
    // Verified against GameHelper2's Radar plugin (Plugins/Radar). Dots on the game's own
    // map are NOT projected with the camera matrix. They use a fixed isometric transform
    // driven by the map UI element's zoom and shift:
    //     deltaZ /= 10.86957                                  (world -> grid, = 250/23)
    //     screen  = mapCentre + ((dx - dy) * cos, (deltaZ - (dx + dy)) * sin)
    //     CameraAngle = 38.7 degrees; cos/sin fold in the map diagonal and the zoom
    //     large map zoom x 0.187812, minimap zoom x 0.748
    //     large map centre  = Center + Shift + DefaultShift
    //     minimap centre    = Position + Size/2 + DefaultShift + Shift
    //     deltaZ comes from Render.TerrainHeight, dx/dy are GRID deltas from the player
    // This is why markers projected with W2SMatrix do not line up with the game's own map
    // markers: the map is zoomable and this transform accounts for it, the matrix cannot.
    // IMPLEMENTED and confirmed in-game 2026-08 (see PoEformance.Game/Ui/MapRadar.cs).
    // Three PoE2 deviations from the reference, each verified against this game:
    //   - the LARGE map's accumulated position is already its CENTRE (the minimap's is its
    //     top-left, so only that one adds half its size);
    //   - the large map's UnscaledSize reads 0, so its diagonal is borrowed from the minimap
    //     (window diagonal as fallback);
    //   - with the minimap diagonal borrowed, the zoom takes NO correction factor - the one
    //     upstream applies exists to scale the WINDOW diagonal down, so it would shrink
    //     everything twice.
    "ImportantUiElements": {
      "comment": "Relative to the KB/M UiRootStructPtr (= ReadPtr(InGameState + 0x2F0)). Controller mode uses a different layout.",
      "fields": {
        "ChatParentPtr": { "offset": "0x640", "type": "ptr" },
        "LeftPanelPtr": { "offset": "0x6D8", "type": "ptr", "comment": "UNVERIFIED, from GameHelper2's ImportantUiElementsOffsets. Whichever left-side panel is open - character, skills, quests. Null while none is, so this is BOTH the address and half the answer; the other half is that the element it points at is only visible while its panel is showing." },
        "RightPanelPtr": { "offset": "0x6E0", "type": "ptr", "comment": "CONFIRMED against a real session 2026-08 (tests/fixtures/session-2026-08-panel.rec, PanelSessionTests): with the inventory open this resolves to a UiElement whose visibility walk says showing, while LeftPanelPtr is null and the tree and world map are present but hidden. The right-side one: inventory, stash, a vendor. Its EXTENT is still unknown - that recording predates the position/size read, and PoE2 lays the inventory out across the screen down to the hotbar rather than as a side column, so a fresh capture is what settles whether the element carries its own size or has to be measured from its children (see PanelReader.Where)." },
        "PassiveSkillTreePanel": { "offset": "0x730", "type": "ptr" },
        "MapParentPtr": { "offset": "0x7C8", "type": "ptr" },
        "WorldMapPanelPtr": { "offset": "0x988", "type": "ptr", "comment": "UNVERIFIED, same source. The world-travel map - the act screens, not the endgame atlas, which is its own panel at a child path." },
        "ControllerModeMapParentPtr": { "offset": "0xAA8", "type": "ptr" }
      }
    },

    "BigPanels": {
      "comment": "UNVERIFIED - the panels that take over the screen, ported from GameHelper2's IsAnyLargePanelOpen. Two kinds and the difference matters: the left panel, the right panel, the world map and the skill tree are POINTERS on ImportantUiElements, which is the sturdy half; the four below are CHILD PATHS, which is a position in somebody else's list and moves when a patch inserts a panel above them. A wrong path usually lands on nothing and reads as shut, which is harmless - but it can land on a real element that is always showing, and then the overlay is hidden forever with nothing to say why. That is what the readout in the status window and the switch beside it are for. The skill tree is the tree's NODE CONTAINER (child 2 of the panel) rather than the panel: in 0.5.x the per-node pointers read null, but the container's visible bit is reliable.",
      "fields": {},
      "consts": {
        "SkillTreeNodesChild": "2",
        "AtlasSkillsPath0": "25",
        "AtlasSkillsPath1": "0",
        "TemplePath0": "64",
        "TemplePath1": "0",
        "ExchangePath0": "114",
        "ExchangePath1": "20",
        "ExchangePath2": "6",
        "ExchangePath3": "1",
        "TrialPath0": "84",
        "TrialPath1": "0"
      }
    },

    "UiElementBase": {
      "comment": "CONFIRMED IN-GAME 2026-08: the map radar built on this walk places dots exactly where the owner's production AHK tool does, which exercises the parent chain, both scale factors and the visibility rule end to end. Fields every UiElement has. Offsets are the PoE2 0.5.x set verified by the AHK tool; they agree with GameHelper2's UiElementBaseOffset.cs everywhere except StringIdPtr, which drifted 0x140 -> 0x098 in PoE2 and would read the text/font-style field at the old offset. Base UI resolution is 2560x1600: every position and size here is in THAT space and must be scaled to the window (see UiScale).",
      "fields": {
        "Self": { "offset": "0x008", "type": "ptr", "comment": "Points at the element ITSELF - *(this+0x08) == this is a cheap validity check before trusting any other field." },
        "ChildrenFirst": { "offset": "0x010", "type": "ptr", "comment": "StdVector begin: array of child UiElement pointers." },
        "ChildrenLast": { "offset": "0x018", "type": "ptr", "comment": "StdVector end; child count = (Last - First) / 8." },
        "StringIdPtr": { "offset": "0x098", "type": "ptr", "comment": "StdWString - the element's identifier (\"life_orb\", \"InventoryPanel\"). PoE2 0.5.x; 0x140 is the stale 0.4.x layout and 0x0F8 is the text style." },
        "ParentPtr": { "offset": "0x0B8", "type": "ptr", "comment": "Parent element - the chain walked to turn a relative position into an absolute one." },
        "PositionModifier": { "offset": "0x0F0", "type": "f32", "comment": "StdTuple2D<float>, y at +0x0F4. Added to the PARENT position, but only when the CHILD's ShouldModifyPos flag is set." },
        "RelativePosition": { "offset": "0x118", "type": "f32", "comment": "StdTuple2D<float>, y at +0x11C. Position relative to the parent, in the 2560x1600 UI space." },
        "LocalScaleMultiplier": { "offset": "0x130", "type": "f32", "comment": "Extra scale this element applies. When it differs from the parent's, the accumulated position must be CONVERTED between the two scale spaces." },
        "Flags": { "offset": "0x180", "type": "u32", "comment": "Bit 10 = ShouldModifyPos, bit 11 = IsVisible. Visibility is only meaningful with the whole parent chain visible too." },
        "ScaleIndex": { "offset": "0x18A", "type": "u8", "comment": "Selects which scale pair applies: 1 -> (v1,v1), 2 -> (v2,v2), 3 -> (v1,v2), anything else -> unscaled." },
        "UnscaledSize": { "offset": "0x288", "type": "f32", "comment": "StdTuple2D<float>, y at +0x28C. Size in UI space, scaled the same way as the position." },
        "ItemPtr": { "offset": "0x4F8", "type": "ptr", "comment": "The item entity held by an inventory/stash slot element, 0 elsewhere." },
        "TextPtr": { "offset": "0x390", "type": "ptr", "comment": "StdWString - the text the element DISPLAYS. The identifying field for every widget whose StringId is empty (skill-bar slots, loot labels, dialogue rows), which is most of them: a UI browser without it shows a tree of blanks. AHK-verified live 2026-06-14." },
        "TextStylePtr": { "offset": "0x0F8", "type": "ptr", "comment": "StdWString - font style descriptor (\"Normal\", \"PathOfExile.Panel.Title\"). Named here because 0x0F8 is where StringIdPtr sat in 0.4.x, so a browser reading the old layout shows these as ids - the mistake this field makes obvious instead of puzzling." },
        "FontNamePtr": { "offset": "0x0C8", "type": "ptr", "comment": "StdWString - font family (\"Fontin\", \"Fontin Smallcaps\")." }
      },
      "consts": {
        "BaseResolutionX": "2560",
        "BaseResolutionY": "1600",
        "FlagShouldModifyPos": "0x400",
        "FlagIsVisible": "0x800",
        "MaxParentChainDepth": "16"
      }
    },

    "MapParentStruct": {
      "comment": "Children of MapParentPtr, read from the cache location inside the struct.",
      "fields": {
        "LargeMapPtr": { "offset": "0x28", "type": "ptr" },
        "MiniMapPtr": { "offset": "0x30", "type": "ptr" }
      }
    },

    "HudElement": {
      "comment": "The game's on-screen interface - the orbs, the bars, the buttons - as ONE UiElement with the parts as its children. CONFIRMED IN-GAME 2026-08 from this tool's own interface browser: a direct child of the UI root with StringId \"HUD\" and 18 children, named experience_bar, LifeOrbBackgroundPBRFrame, ManaOrbBackgroundPBRFrame, life_orb, mana_orb, magma_mana_orb, botleft_buttons_layout, HUDLeft, changes_note, HUDRight, chatButton, fade_from_black, Skip_Cutscene, and three the game does not name. THIS IS WHY THE MAP OVERLAY CAN MEASURE THE HUD instead of being told where it is: every part carries its own position and size like any other element, so the region the map keeps off is read rather than described. FOUND BY StringId, NOT BY INDEX. The index below is where to look FIRST and nothing more - an index into a list of 156 siblings is the most fragile thing this file could hold, and the failure mode is silent: a patch that inserts one element above HUD moves it, the wrong element is measured, and the map is kept off a rectangle that is not there. The scan for the id costs one string read per root child, once, and only when the cached address stops answering to \"HUD\".",
      "fields": {},
      "consts": {
        "ChildFromUiRoot": "97",
        "MostParts": "64",
        "MostRootChildren": "512"
      }
    },

    "MapUiElement": {
      "comment": "CONFIRMED IN-GAME 2026-08 via the map radar - dots track the map at every zoom level. A map-type UiElement: UiElementBase at 0x000, then its own fields. Matches GameHelper2 MapUiElement.cs. PoE2 4.5.x shifted all three by -0x38 when UiElementBase shrank (the old Zoom at 0x3E0 read 0.000).",
      "fields": {
        "Shift": { "offset": "0x368", "type": "f32", "comment": "StdTuple2D<float> - how far the user/game has shifted the map centre; y at +0x36C." },
        "DefaultShift": { "offset": "0x370", "type": "f32", "comment": "StdTuple2D<float> - resting offset, (0, -20) in PoE2; y at +0x374." },
        "Zoom": { "offset": "0x3A8", "type": "f32", "comment": "Current zoom, normally 0.5 - 1.5. THE value the world-to-screen projection cannot know about." }
      }
    },

    "WorldData": {
      "fields": {
        "WorldAreaDetailsPtr": { "offset": "0x98", "type": "ptr", "invariant": { "kind": "nonNullPtr" }, "comment": "WHAT IT POINTS AT IS THE AREA INSTANCE ITSELF, measured 2026-08: the value here equals InGameState.AreaInstanceData in every sampled frame of 21 of the 22 committed recordings. So WorldAreaDetails is not a separate object and its RowPtr(0xA0) is AreaInstance+0xA0 - the WorldAreas.dat row is reachable from either side, which is worth knowing when one of the two chains is unreadable. THE EXCEPTION IS THE ONE SESSION THAT CHANGES AREA (session-2026-08-actions.rec: 26 frames agreeing, 37 not), and it is the expected one rather than a counter-example - WorldData survives an area change while AreaInstance is rebuilt, so the two disagree across a transition. Anything comparing them has to tolerate that, and anything wanting 'the area the world is currently drawing' should prefer this one." },
        "CameraStructure": { "offset": "0x98", "type": "ptr", "comment": "INLINE camera struct base - do NOT dereference. GameHelper2's WorldDataOffset declares WorldAreaDetailsPtr and CameraStructurePtr at the SAME offset 0x98, the second as an inline struct, and its CameraStructure puts WorldToScreenMatrix at +0x108: 0x98 + 0x108 = WorldData+0x1A0, which is exactly the offset the AHK tool uses. (This field read 0xA0 before, arriving at the same 0x1A0 via +0x100; 0x98 is the referenced value.) No invariant: whatever floats sit here would validate anything." },
        "W2SMatrix": {
          "offset": "0x1A0", "type": "mat4x4",
          "comment": "World-to-screen camera transform = CameraStructure(0x98) + 0x108. CONFIRMED IN-GAME 2026-08 against a 123-entity scene: MatrixHunt ranked it first with a fixed-camera linearity of 0.943, the nearest decoy reaching 0.728, and 0x1E0 scored IDENTICALLY - the duplicate copy GameHelper2 documents, which corroborates rather than contradicts. Also matches the AHK tool's WorldData+0x1A0. Read with the GameHelper2 convention (System.Numerics Matrix4x4 + Vector4.Transform), i.e. each clip component is a dot with a COLUMN of the flat array: x from {0,4,8,12}, w from {3,7,11,15}. DRIFT HISTORY: 0x1A8 -> 0x1A0 (a patch shifted it -8 bytes; issue #158) -> 0x11C (2026-08, WRONG, reverted). NO STRUCTURAL INVARIANT ON PURPOSE. The removed one demanded a unit-length direction vector CONTIGUOUS at +0x30, and it did the worst thing an invariant can do: it rejected the truth and accepted a decoy. Under this column convention the direction row is STRIDED across {3,7,11}, so it is not contiguous at +0x30 at all - the invariant failed here, at the correct offset, and passed at 0x11C, where an unrelated block of four unit rows happens to match. Projecting the real scene through 0x11C collapses all 76 entities into 0.01 NDC (a monster 79 units from the player landing 0.00000 away), and the check meant to catch that - 'does the player land at screen centre?' - PASSED, because an inflated w drives every numerator to ~0 and centres everything. Unit-length rows are far too weak a fingerprint; frustum planes, basis blocks and inverse transforms all have them. The replacement test is semantic and lives in MatrixHunt: the player must be centred AND the rest of the scene must spread out, scored against real entities. AND THE DECOY NOW HAS A NAME: 0x11C is the second of the six FRUSTUM PLANES below, which run from 0x10C at a stride of 0x10 - so reading a mat4x4 there takes planes 1 to 4, and the unit vector the old invariant demanded at +0x30 was plane 4's normal. It was never 'an unrelated block'; it is the camera's own frustum, sixteen bytes before the matrix."
        },

        "FrustumCorners": {
          "offset": "0xAC", "type": "f32",
          "comment": "THE EIGHT CORNERS OF THE VIEW FRUSTUM, in WORLD units: eight vec3 packed back to back, 0xAC to 0x10B. Found 2026-08 while mining the recordings for what surrounds the matrix, and settled by a test the wrong answer fails rather than by resemblance: each corner of a frustum lies exactly ON three of its six faces, so project all eight through the six planes at 0x10C and count the zeros. AT 0xAC ALL EIGHT LIE ON THREE PLANES, IN ALL EIGHTEEN COMMITTED RECORDINGS; read four bytes later, at 0xB0, NONE of them does, in any recording. Eight points fitting six planes to the float is not something a misread block does once, let alone eighteen times. The remaining distances are the frustum's own extents and come out in matching pairs, which is what a convex hexahedron looks like from the inside."
        },

        "FrustumPlanes": {
          "offset": "0x10C", "type": "f32",
          "comment": "THE SIX CLIPPING PLANES OF THE CAMERA, at a stride of 0x10: a unit normal (three floats) then the plane's distance, with the normals pointing INWARD - a point is inside the frustum when n.p + d >= 0 for all six. WHY THIS IS A MEASUREMENT AND NOT A FINGERPRINT, given that this file already records unit length as the weakest possible evidence: (1) the eight corners at 0xAC fit these six planes exactly and fit nothing at a neighbouring alignment (see above); (2) THE PLAYER IS INSIDE ALL SIX IN ALL NINETEEN RECORDINGS, across six separate game launches and world positions from x=3299 to x=19168; (3) better than inside - the player's distance to the VERTICAL pair of side planes is the same number in every one of them (450.3 and 644.4, not one exception), which is what a frustum rigidly carried by a player-centred camera has to look like and what no other reading of these bytes would produce. THE HORIZONTAL PAIR IS NOT ONE NUMBER, and this used to say it was, on eighteen recordings of which two disagreed and were written off as the map being panned. A nineteenth made it three, which is where 'outlier' stops being honest: planes 0 and 1 take 1140.1/1140.1 in sixteen sessions and 1326.5/907.2 in three, and the two do not even sum alike (2280.2 against 2233.7), so it is not a pan trading one for the other. Something about the viewport differs between those captures and nothing here has identified what. Planes 4 and 5 are exact negatives of each other: they are the near and far plane, so the view direction is plane 4's normal and the depth is d[5] + d[4]. THAT DIRECTION IS A THIRD WITNESS. It reads (0.466531, 0.466531, 0.751464) in every recording - identical across all five launches, so the camera's orientation is fixed in this game - and its two horizontal components are EQUAL, i.e. the camera looks exactly along the world diagonal, which is independently what ScreenBasis measured for up-screen when it derived (0.7071, 0.7071) from the matrix by a completely different route. AND IT CROSS-CHECKS THE MATRIX, which is the reason to read it at all rather than merely to name it: the eight corners of the view volume ARE the eight corners of the viewport, so projecting them through W2SMatrix must land every one on an edge of normalised device space. It does, to 0.0000, in all eighteen recordings - two independent descriptions of one camera, read from two places sixteen bytes apart, agreeing to the float. That is the first check on this projection that needs no scene and no threshold anybody has to agree with, and MatrixHunt now leads its recommendation with it. THE CASE THAT MADE THAT NECESSARY: on session-2026-08-monsters.rec the hunt's own ranking puts 0x12C READ TRANSPOSED first, at a linearity of 0.9791 against the true matrix's 0.9539 - and 0x12C is PLANE 2 of this array. Followed, it would have moved the matrix onto a block of clipping planes, which is the 0x11C mistake arriving through the check that replaced the one 0x11C got past. The frustum column separates them at a glance. HOW OFTEN THE GAME REWRITES IT IS NOW SETTLED, and it is every frame. This was the last thing standing between the block and being usable: the first eighteen recordings swept WorldData 0x000-0x840 ONCE, at frame 5, so the frustum was constant in every replay of them for the same reason a photograph is, and a replay cannot tell that apart from a value the game never updates. tests/fixtures/session-2026-08-frustum.rec is the capture made after WorldReader started reading it beside the matrix every frame, and the recorder answers the question by construction: it drops a read whose bytes match the last one written, so a read in the file is a read that CHANGED. 669 stored reads, 669 distinct values, changing frame for frame with gaps that match the matrix's own exactly. The block is as live as the projection it belongs to. ONE CAVEAT THAT SURVIVES: the matrix and this are two separate reads, so they can straddle a game write - over 1108 frames the corner-to-NDC-edge agreement has a median of 8.5e-6 and two frames at 6.4e-2, which is tearing rather than drift. Verified by CameraFrustumTests."
        }
      },
      "consts": {
        "FrustumCornerCount": "8",
        "FrustumPlaneCount": "6",
        "FrustumPlaneStride": "0x10"
      }
    },

    "WorldAreaDetails": {
      "comment": "Reached through WorldData.WorldAreaDetailsPtr (0x98). TWO hops, not one: WorldData -> WorldAreaDetails -> the WorldAreas.dat ROW. Ported from the AHK tool, which uses exactly this chain in game.",
      "fields": {
        "RowPtr": { "offset": "0xA0", "type": "ptr", "struct": "WorldAreaDat", "invariant": { "kind": "nonNullPtr" }, "comment": "The WorldAreas.dat row for the area currently loaded." }
      }
    },

    // ── dat ROWS are computable, not searchable ──
    // Seven structs here are not engine objects at all - they are rows of the game's static
    // content tables, loaded into memory: WorldAreaDat (WorldAreas), BuffDefinition
    // (BuffDefinitions), MinimapIconRow (MinimapIcons), ItemVisualIdentityRow
    // (ItemVisualIdentity), QuestFlagsRow (QuestFlags), NpcsRow (NPCs) and
    // KeywordPopupsRow (KeywordPopups).
    // A row keeps the column ORDER the .dat file declares, PACKED,
    // with no alignment padding - which is why so many of these offsets are odd numbers.
    // poe-tool-dev/dat-schema publishes that column order for 1275 PoE2 tables, so for a
    // dat row the offset of any column is arithmetic. Column widths in memory:
    //     bool/i8/u8 1 | i16/u16 2 | i32/u32/f32 4 | enum-row 4 | string 8 (a UTF-16
    //     pointer) | reference to ANOTHER table's row 16 | reference to a row of the SAME
    //     table 8 | array of anything 16
    //     ...AND AN INTERVAL COLUMN COSTS TWICE ITS TYPE. dat-schema marks that with a FLAG
    //     rather than a type, which is exactly why it went unnoticed: the column reads i32 and
    //     prices as 4, and the row comes out four bytes short for every one of them. It is two
    //     values - Mods.Stat1Value..Stat8Value are a modifier's minimum and maximum roll.
    //     21 PoE2 columns carry the flag, in four tables, and NONE of them is in a table this
    //     file computes an offset in - so nothing shipped was ever wrong, only the checking.
    // A 16-byte foreign reference is a ROW reference followed by a TABLE reference: the
    // pointer to the referenced row sits AT the column start and the table it belongs to at
    // +8. OBSERVED 2026-08 in session-2026-08-questflags.rec, and which half is which is not
    // a matter of opinion there. NPCs column 4 (QuestFlags, computed start 0x18) holds one
    // pointer that lands EXACTLY on the 12-byte row grid of the QuestFlags rows array - row
    // 2170 of 5717, no remainder - and one that starts with a module pointer, which is a
    // vtable and so an engine object rather than a row. Two NPCs rows agree, a row of a third
    // table pointing at the same table agrees, and MinimapIcon has carried this order live
    // for months (IconRowPtr 0x20, TablePtr 0x28). A debugger added a fourth kind of witness
    // 2026-08: scanning ALL of memory for a pointer to one QuestFlags row turned up three
    // unrelated runtime structures holding it, and all three carry the IDENTICAL qword at +8 -
    // the table. Three holders that share nothing else agreeing on what sits eight bytes on is
    // not a layout that can be read the other way round.
    // THIS REVERSES WHAT THIS NOTE SAID BEFORE - "a TABLE reference followed by a ROW
    // reference, so the pointer sits at +8" - which was derived and never observed, from the
    // AHK tool's .datc64 layout and from GameHelper2 reading GrantedEffects.ActiveSkillDatPtr
    // at 0x57 where dat-schema computes that column starting at 0x4F. That second witness is
    // now the odd one out and wants re-checking rather than trusting: an 8-byte drift in
    // GrantedEffects' earlier columns explains it exactly, and a stale reference offset
    // agreeing with a wrong reading is not corroboration (Render.Name, below, cost a day to
    // that). The only offset in this file that rested on the old rule is
    // BuffDefinition.BuffVisualsKey, moved 0x5D -> 0x55 with it; nothing reads it.
    // Where these come from: derived here by elimination - out of sixteen plausible
    // combinations exactly one reproduces every dat-row offset in this file, and the two
    // that pin it down are BuffDefinition 0x55 and 0x67, both sitting behind an array, an
    // enum and two row references - and then found to agree, type for type, with the
    // .datc64 table the AHK tool has been extracting these files with for months
    // (tools/poe_tools.py, TYPE_SIZES_DATC64). Two of these were guessed wrong first, and
    // both wrong guesses survived the elimination because nothing in this file could
    // disprove them: the self-reference width (41 PoE2 tables have such a column, and in
    // WorldAreas it is column 13 of 82) and which half of a foreign reference holds the
    // pointer. Reading the reference first would have cost a minute.
    // scripts\dat-offsets.ps1 does the arithmetic; -SelfTest re-runs the check.
    // CONFIRMED FROM THE OTHER SIDE, 2026-08, and this is the check the width table had been
    // missing: -SelfTest only ever asked whether the computed offsets agree with offsets this
    // file already knew, which cannot catch a width that is wrong everywhere at once. The
    // STRIDE can. Rows of one table sit end to end in memory, so the gap between any two of
    // them is a multiple of the computed row size - and a wrong width table would put them on
    // the wrong grid. Twenty-three MinimapIcons rows harvested from the owner's recording
    // (Id "NPC" through "AbyssChestInactive", spanning 934 row indices and 0x8AA4 bytes) land
    // on a 0x26 grid without a single exception, and 0x26 is exactly what the widths compute
    // for that table's 9 columns. The same recording puts its WorldAreas rows ("MapRustbowl",
    // "G_Endgame_Town", the ExpeditionLogBook set) on a 0x300 grid, and 0x300 is what the
    // widths compute for that table's 82 columns. Two tables, two strides, no adjustment.
    //
    // AND THEN 123 TABLES AT ONCE, which is what closes this. The strides above were harvested
    // by hand, a table at a time, out of rows that happened to be in a recording. A loaded dat
    // table REPORTS ITS OWN ROW SIZE - the row store divides its rows by its by-Id index, see
    // DatRowStore - so walking the loaded-file table asks every table in memory the question in
    // one pass, with nothing computed on the game's side. Over the 131 tables of
    // session-2026-08-glossary.rec, and the 134 of session-2026-09-tables.rec: EVERY ONE of them
    // reports EXACTLY what the widths compute, from ModFamily's 8 bytes to Mods' 677 - 134 of
    // 134, with one of those needing a column list from a second source (see EndgameMaps below).
    // A width that is wrong for a common type cannot survive that: one byte off on 'bool' would
    // move about ninety of these, and a wrong reference width would move nearly all of them.
    // IT READ 123 OF 126 AT FIRST, and every one of the gaps was in the ASKING rather than in
    // the game - see below, because all three are traps the next person will walk into.
    // TWO TRAPS SAT BETWEEN THE GAME AND THE SCHEMA, and this note carried both as findings
    // about the GAME before either was caught. It said "three tables disagree, all with the game
    // bigger, which is what a reference lagging a patch looks like" and "five tables are not in
    // dat-schema at all". Neither was true, and both were flushed out by somebody asking whether
    // it was really sure.
    // (1) THE INTERVAL RULE, missing from the widths above. Mods computed 0x285 against 0x2A5
    // and AlternateTreeVersions 0x1A against 0x26 - Mods has eight interval columns and 8 * 4 is
    // 32, AlternateTreeVersions three and 3 * 4 is 12. A HYPOTHESIS THAT EXPLAINS THE SIGN OF
    // EVERY DISCREPANCY IS NOT THEREBY RIGHT: "the reference is behind" and "our arithmetic is
    // incomplete" both make the game bigger, and only one of them was testable from here.
    // (2) CAPITALISATION. The game's path and dat-schema's table name disagree on case, so an
    // exact-match lookup reports a table as unknown rather than as different: the game loads
    // AtlasPassiveSkillSubtrees where the schema says AtlasPassiveSkillSubTrees, and likewise
    // MTXTypes/MtxTypes, MTXPreviewCameras/MtxPreviewCameras,
    // CharacterShapeshiftBasicSkills/CharacterShapeShiftBasicSkills and
    // AtlasPassiveGrantedSkillsFrom{Subtree,SubTree}Points. All five agree on their row size to
    // the byte once matched. MATCH A TABLE NAME CASE-INSENSITIVELY, always - dat-offsets.ps1
    // does, because PowerShell's -eq is, and LoadedDatTables.FindAll does on purpose.
    // AND THE LAST ONE IS A MISSING TRAILING BOOL. EndgameMaps computed 0xEF where the game says
    // 0xF0, with no interval column in it, and a THIRD source settles it: repoe-fork/dat-export
    // (current/poe2/heuristics/schema/graphql) lists 28 columns where poe-tool-dev lists 27, the
    // extra being a bool at the very end, and its total is 0xF0 to the byte. So poe-tool-dev's
    // PoE2 copy of that table is one column short at the tail.
    // WHICH LEAVES 134 OF 134 EXPLAINED - every dat table these two captures found, with nothing
    // put down to "the reference is behind" that was not then found in a reference.
    // THREE SOURCES, AND THEY DISAGREE, so it is worth knowing what each is for.
    // poe-tool-dev/dat-schema is what scripts\dat-offsets.ps1 downloads: one file, every table,
    // and it agreed with the game on 133 of 134. repoe-fork/dat-export publishes a HEURISTIC
    // schema derived from the data itself, which is why it caught a trailing column nobody had
    // named - check it when a table disagrees with the game. jchantrell/dat-schema is a third
    // opinion and was the LEAST complete of the three here: 19 columns totalling 0x98 for
    // EndgameMaps, opening with an i32 the other two do not have. THE GAME IS THE ARBITER in all
    // of this - it reports its own row size and --tables prints it.
    // SO an offset computed in EndgameMaps is right up to the missing column and wrong after it,
    // and its row size cannot say where the break is. For any table the game's own row size is
    // the number to trust; --tables prints it.
    // A row's INDEX is therefore computable too: (row - anyKnownRow) / rowSize is exact.
    // NONE OF THIS APPLIES TO COMPONENTS. Life, Actor, Render, Positioned, Buffs,
    // StatusEffect, Entity and the UI structs have no .dat table behind them. ChestData
    // is the trap: it POINTS AT a Chests row but is not one, and checking it against that
    // table lands on offsets that are not even column boundaries.
    "WorldAreaDat": {
      "comment": "A row of WorldAreas.dat: what KIND of area this is. There is no IsHideout field - the reference derives it from the Id containing 'hideout' but not 'map', because hideout areas are named that way and map areas are not.",
      "fields": {
        "IdPtr": { "offset": "0x00", "type": "ptr", "comment": "Wide string, e.g. G1_2, MapRiverhold, HideoutFelled." },
        "NamePtr": { "offset": "0x08", "type": "ptr", "comment": "Wide string, the display name." },
        "Act": { "offset": "0x10", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 20 } },
        "IsTown": { "offset": "0x14", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 } },
        "HasWaypoint": { "offset": "0x15", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 } }
      }
    },

    "AreaInstance": {
      "comment": "DRIFT HISTORY, two waves so far: (1) +0x18 - PlayerInfo 0x580->0x598, TerrainMetadata 0x8A0->0x8B8; (2) 2026-08, owner-verified: +0x08 across the tail - PlayerInfo 0x598->0x5A0, AwakeEntities 0x6D8->0x6E0, SleepingEntities 0x6E8->0x6F0, TerrainMetadata 0x8B8->0x8C0 (a new 8-byte field was inserted below ~0x5A0). When ONE field here drifts, assume the whole tail moved by the same delta and check them all. Low fields (CurrentAreaLevel 0xC4, CurrentAreaHash 0x11C) did not move in either wave.",
      "fields": {
        "CurrentAreaLevel": {
          "offset": "0xC4", "type": "i32",
          "invariant": { "kind": "range", "min": 0, "max": 100 },
          "comment": "Monster level of the current area."
        },
        "CurrentAreaHash": { "offset": "0x11C", "type": "u32", "comment": "Instance hash - changes on every area transition; used as the per-area reset signal all over the tool." },
        "Environments": { "offset": "0x4C0", "type": "ptr", "comment": "UNVERIFIED since the 2026-08 +0x08 wave - sits between the stable low fields and the shifted tail; if the insertion point is below 0x4C0 this is 0x4C8 now. Confirm via the drift report before use." },
        "PlayerInfo": {
          "offset": "0x5A0", "type": "ptr",
          "comment": "INLINE LocalPlayerStruct base - do NOT dereference: the value AT this address is already ServerDataPtr (+0x00); LocalPlayerPtr is +0x20 (abs 0x5C0). Proven by the first live run 2026-08: dereferencing here validated ServerData as a struct base and the player chain 'broke'. Drift history: 0x580 -> 0x598 -> 0x5A0 (+0x08 wave). The invariants live on the LocalPlayerStruct rows."
        },
        "AwakeEntities": {
          "offset": "0x6E0", "type": "ptr",
          "invariant": { "kind": "nonNullPtr" },
          "comment": "EntityListStruct: AwakeEntities std::map head is its first field (+0x00). Was 0x6D8 (2026-08 +0x08 wave)."
        },
        "SleepingEntities": { "offset": "0x6F0", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "Was 0x6E8 (2026-08 +0x08 wave)." },
        "TerrainMetadata": {
          "offset": "0x8C0", "type": "ptr",
          "comment": "TerrainStruct (was 0x8A0, then 0x8B8, now 0x8C0 - 2026-08 +0x08 wave). Source: GameHelper2 AreaInstanceOffsets.cs. NOTE: unlike most ptr fields this is an inline struct base in some builds - treat as base address, not pointer, when reading TerrainMetadata fields. INLINE IS THE CASE HERE, and the recordings say so outright: the eight bytes at 0x8C0 hold a MODULE address, which is a vtable and not a heap pointer, and the very next slot holds this AreaInstance's own address - a back-pointer to the owner, where GameHelper2's TerrainStruct has an unnamed field at +0x08."
        }
      }
    },

    "LocalPlayerStruct": {
      "fields": {
        "ServerDataPtr": { "offset": "0x00", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "LocalPlayerPtr": {
          "offset": "0x20", "type": "ptr",
          "invariant": { "kind": "stringContains", "needle": "Metadata/Characters", "hops": ["0x00", "0x08"], "stringAt": "0x08" },
          "comment": "The local player entity. Invariant follows Entity->EntityDetails(+0x08)->Path(+0x08) and expects a Metadata/Characters/... path - the strongest possible 'this is really the player' check."
        }
      }
    },

    "ServerData": {
      "comment": "Behind LocalPlayerStruct.ServerDataPtr - i.e. the VALUE at AreaInstance+PlayerInfo, not a second dereference. The blob the server sends about this character: page-aligned, four vtables at its head. Only the one field below is decoded here; the inventories and the league name live in it too and are read elsewhere.",
      "fields": {
        "QuestFlagOwnerPtr": {
          "offset": "0x60", "type": "ptr", "invariant": { "kind": "plausiblePtr" },
          "comment": "First hop of the quest-flag chain. WHAT THIS OBJECT IS is not known - it carries five vtables at its head, so a class with multiple bases, and nothing here has identified it. Named for where it leads rather than for what it is, which is honest about the state of it."
        }
      }
    },

    "QuestFlagOwner": {
      "comment": "Second hop of the quest-flag chain. Same caveat as above: unidentified class, kept because the route through it is measured.",
      "fields": {
        "QuestFlagSetPtr": { "offset": "0x188", "type": "ptr", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    "QuestFlagSet": {
      "comment": "A CHARACTER'S SET QUEST FLAGS, and the end of the hunt the QuestFlagsRow comment spent six sessions on. It is a SPARSE BITSET over QuestFlags.dat row numbers, held as a sorted vector of 9-byte records: a u8 chunk index, then 64 bits little-endian. Bit b of chunk c is row c*64+b, so a u8 index reaches row 16383 against the table's 5717 rows. The vector is exact-sized - end equals end-of-allocation - so inserting a chunk REALLOCATES THE WHOLE BUFFER, and that single fact is what defeated every earlier search: setting a flag in a fresh chunk does not flip a bit in place anywhere, it moves the entire set to a new address and leaves the old copy behind unchanged. MEASURED on a 62-second session (tests/fixtures/session-2026-08-questflags-set.rec, QuestFlagSetTests): 25 records growing to 30, chunk indices strictly increasing in every sample, and across every sample not one bit ever cleared - a progress set only gains. Both mechanisms were caught in that one recording: row 644 arrived as a NEW chunk (0x0A), row 1771 was set IN PLACE in an existing one (0x1B). NAMED, which is what makes it certain rather than plausible: rows 11, 22 and 46 of the set resolve through the QuestFlags ByIdIndex to CompletedSkillGemTutorial, CompletedLifeFlaskTutorial and EnteredHideout.",
      "fields": {
        "Chunks": { "offset": "0x248", "type": "stdVector", "comment": "begin/end of the record array. The element is 9 bytes, so this is not vectorSane-checkable at any of the usual element sizes." }
      },
      "consts": {
        "RecordSize": "9",
        "BitsPerRecord": "64",
        "MaxRecords": "4096"
      }
    },

    "TerrainMetadata": {
      "comment": "Base = AreaInstance + TerrainMetadata offset. Walkable grid: each byte holds 2 cells (even x = low nibble, odd x = high nibble); nibble != 0 means walkable. GridLandscapeData / Layer3 / Layer4 were probed for a fog-of-war grid and are STATIC terrain-type data - the explored state is GPU-side and NOT readable (hunt closed 2026-07-06, do not reopen without new evidence).",
      "fields": {
        "TotalTilesX": { "offset": "0x18", "type": "i64", "invariant": { "kind": "range", "min": 1, "max": 4096 } },
        "TotalTilesY": { "offset": "0x20", "type": "i64", "invariant": { "kind": "range", "min": 1, "max": 4096 } },
        "TotalTilesPlusOneX": {
          "offset": "0x40", "type": "i64",
          "comment": "The tile counts again, each plus one; Y at +0x48. GameHelper2 calls it TotalTilesPlusOne and nothing here uses it, but it is CONFIRMED against real memory (2026-08) and cheap to keep for one reason: it is a free consistency check on the two fields above, which nothing else in this struct can corroborate. In the two recordings whose sweep happens to cover it the area reads 39 x 45 tiles and this pair reads 40 x 46, exactly. The other sixteen never read the bytes, which is silence and not disagreement."
        },
        "TileDetailsPtr": {
          "offset": "0x28", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 56, "maxCount": 16777216 },
          "comment": "StdVector<TileStructure>, each 0x38 bytes."
        },
        "TileCornerData": {
          "offset": "0x50", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 1, "maxCount": 16777216 },
          "comment": "THREE BYTES PER TILE CORNER, and BYTE 0 IS A GROUND TYPE. Indexed by corner, one more than the tile count each way: 16416 bytes over a 71x75 area is exactly (71+1)*(75+1)*3, 11163 over a 60x60 is (60+1)*(60+1)*3. CONFIRMED 2026-09 on two complete arrays out of one recording - 5472 of 5472 corners and 3721 of 3721, not a sample. Byte 0 indexes GroundTypeFiles: in an Archives area listing FOUR slots it takes exactly the values 0-3 and in a Vaal area listing SIX it takes exactly 0-5, every slot used, nothing outside the list either time, so the range tracks the list length rather than being a fixed enumeration. The values also form CONNECTED REGIONS - drawn as characters the Vaal area shows a water course through a chamber of street and bridge inside a field of building-inside - which is what terrain looks like and what a mis-read field cannot fake. This is the reading GridLandscapeData was wrongly credited with; that nibble is a fixed 0-5 constant and this is the real per-corner ground type. Byte 1 is mostly zero with 16 and 32 appearing, which look like flags; byte 2 takes only 3 and 11, and 11 is outside lists of four and six, so it is not a .gt index - a height or another table. READ BY TerrainGroundTypes, which takes byte 0 as the per-tile ground type and refuses to draw unless every corner names a slot the list holds AND the types separate on walkability; CornerProbe still histograms all three bytes under --debug. The corner correspondence matters beyond naming ground: a room file carries a ground type per corner of every slot (RePoE/poe/file/arm.py), so a room is a corner stamp that could be searched for in this array - the one route to placing a room that nothing has ruled out."
        },
        "GroundTypeFiles": {
          "offset": "0x68", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 64 },
          "comment": "The area's own ground-type files, and the list TileCornerData's byte 0 indexes. Eight-byte pointers to file objects whose path is a stdWString at +0x08, the same shape TileStruct.TgtFilePtr has. MEASURED 2026-09 in tests recording 4d24fd2e with the terrain struct found by its OWN fields (tile counts at +0x18/+0x20 agreeing with a 0x38-stride tile vector at +0x28): an 87x81 Badlands area lists SEVEN slots - null, bone_fill, trims1, bone_abyss, badlands_noburrow, waypoint_ground, badlands - a 60x60 Vaal area SIX, and a live Titan Grotto FIVE (TitanEdge, abyss, TitanGrottoEntrance, TitanWalkwayGround). THE FIRST SLOT IS NULL IN EVERY AREA SEEN. READ BY TerrainReader once per area, for the ground-type layer and for the corner probe alike. A NULL SLOT IS KEPT IN PLACE: a corner value indexes this list by position, so dropping the leading null would shift every value above it onto another type's name - the bug that kept the first version of the layer off the map entirely. WHAT IT IS NOT: the list GridLandscapeData indexes. That was the theory this offset was hunted for and it is dead - in the Grotto 9190252 of 9212535 cells carry a nibble beyond the five slots that area lists, nearly the whole grid. The value 5 dominates there AND opens the Badlands landscape grid, in an area with seven slots, so it does not track the list at all: it is a fixed constant, which is what this file's own 'nibbles 0-5' note was describing. See docs/architecture.md for the whole route, including what a room file turned out to contain."
        },
        "GridWalkableData": { "offset": "0xD0", "type": "stdVector", "invariant": { "kind": "vectorSane", "elementSize": 1, "maxCount": 67108864 } },
        "GridLandscapeData": { "offset": "0xE8", "type": "stdVector", "comment": "Static terrain-type nibbles. NOT fog-of-war, and NOT an index into GroundTypeFiles either - that was tried in 2026-09 and the game refused it: in a Titan Grotto 9190252 of 9212535 cells carried a value beyond the five slots that area lists. The dominant value is 5, in an area with five slots AND in a Badlands area with seven, so it does not follow the list; 5 is a fixed constant, and the 0-5 in the original note is a fixed range rather than a per-area one. It IS the same length as GridWalkableData and presumably the same packing (two cells per byte, even x in the low nibble), but what the values MEAN is unknown - and the per-value walkable shares that would have said were never actually measured, because the readout that printed them fed % to ImGui's printf and lost every second number. Nothing reads this today, and the reading it was wanted for now has a home: the per-corner ground type lives in TileCornerData at +0x50, byte 0. See docs/architecture.md." },
        "BytesPerRow": { "offset": "0x130", "type": "i32", "invariant": { "kind": "range", "min": 1, "max": 16384 } },
        "TileHeightMultiplier": { "offset": "0x134", "type": "i16" }
      }
    },

    "MinimapIcon": {
      "comment": "The component an entity carries when the GAME ITSELF marks it on the map - which makes it the authoritative answer to 'is this a point of interest', including quest targets. Source: GameHelper2 RemoteObjects/Components/MinimapIcon.cs.",
      "fields": {
        "IconRowPtr": { "offset": "0x20", "type": "ptr", "struct": "MinimapIconRow", "comment": "Row in MinimapIcons.dat. Its first field is the icon's name. CONFIRMED LIVE (2026-08, owner, in the dissector): the row reads Id \"NPC\" on an NPC, at the same address the recording independently resolved." },
        "TablePtr": {
          "offset": "0x28", "type": "ptr",
          "comment": "The TABLE the row above belongs to - a dat-file object whose +0x08 is a pointer to its path, read live as \"Data/Balance/MinimapIcons.dat\". FOUND 2026-08 by following the pointer next to the row, and worth having because it answers the one question a row cannot answer about itself: the dissector can say \"dat row, Id X\" from the layout alone but not WHICH TABLE, and the table name is what turns a row into a computed column layout (scripts\\dat-offsets.ps1 -Table MinimapIcons). Neither reference decodes it - GameHelper2 has no offsets file for this component at all and reads only the 0x20. If the same pointer-pair shape turns up beside other row pointers (ItemBaseComponent.UniqueIviRow, ChestData.StrongboxDatPtr), it is the same thing."
        }
      }
    },

    "DatTable": {
      "comment": "One of the game's static content tables as it sits in memory - what MinimapIcon.TablePtr points at, and the second half of every 16-byte foreign reference. The path NAMES the table, which is the missing half of every dat row this tool finds. THE TWO INTS BESIDE IT ARE THE PATH'S OWN HEADER, and this file had them written down as a mystery for months: \"0x1D and 0x1F as ints\". 0x08 is simply a std::wstring, and ReadStdWString puts size at +0x10 and capacity at +0x18 OF THE STRING - which is 0x18 and 0x20 here. 0x1D is 29, the length of \"Data/Balance/MinimapIcons.dat\" to the character; the 0x1F beside it is the capacity, and reads 31 for both tables seen so far, a 32-character buffer less its terminator. Worth having as a field of its own rather than as trivia, because the LENGTH is one read while the text is a pointer further away: a recording that never followed the pointer still carries the number, and a length identifies a table on its own more often than it sounds - QuestFlags below is the only 12-byte-row table in the game with a 27-character path. A TABLE IS A LOADED-FILE RECORD, and that is what turns every table the game has loaded into something reachable from a STATIC rather than only from an object that happens to point at one. FileRecord.Name and DatTable.Path are not merely the same shape at the same offset - they are the same field of the same object. MEASURED 2026-08 in tests/fixtures/session-2026-08-sweep.rec, in both directions at once: the table an NPCs row names at +0x20 (0x31826080AD0, whose Path reads \"Data/Balance/QuestFlags.dat\", 27 characters, and whose row grid the row half at +0x18 lands on) is ALSO one of the 8406 records the FileRoot walk enumerates, reached bucket -> slot -> record with nothing assumed. It is not one coincidence either: of the four tables that recording holds a foreign pointer to - Stats, GroundEffects, BuffDefinitions, QuestFlags - every one is a record in the file table. So the route is FileRoot -> LoadedFilesRoot -> bucket -> FileRecordSlot.Record -> here, and RowStorePtr from there; Game/Files/LoadedDatTables.cs walks it and PointerPeek.DescribeTable decides which records really are tables. MOST OF THE GAME'S TABLES ARE NOT ON IT, and the fraction is the finding rather than any one absence. A live walk turns up 134 tables among 6914 files, and 157 of those records are .dat files at all - against about 1020 PoE2 tables in the community schemas. FIFTEEN PER CENT. WorldAreas, MinimapIcons, NPCs and ItemVisualIdentity - the four THIS PROJECT READS ROWS FROM - are in none of the 6913 record names session-2026-09-tables.rec holds (--tables names every record that is NOT a table, which no other capture does), while Stats, Mods, BaseItemTypes and QuestFlags are. CONFIRMED FROM THE ROW SIDE TOO, so it is not a name that failed to read: the same capture holds MinimapIcons ROWS - the Ids Waypoint, StashPlayer and MapDevice, at addresses 159 and 154 row-widths apart on the 0x26 grid - and no record the walk accepts brackets them. The table is in memory and outside the walk's reach at once. WHAT THAT SPLIT IS NOT is a story about which tables get loaded: all eight are core tables the client cannot start without, which is why the QuestFlags hunt never once had trouble reading its table. A first draft of this note called the four absences a coin flip at 15% coverage, which was worse than wrong - the four PRESENT ones were picked BECAUSE they were visible in the listing, so the sample was chosen after the fact and says nothing. TWO THINGS COULD HAVE PRODUCED THE FRACTION - the table tracking only what the resource loader pulls in, or our walk seeing a slice of a larger table - AND THE SECOND IS NOW RULED OUT. This note argued for it twice and was wrong about it twice. First on the facts: it said BucketCount 0x10 was ported from GameHelper2, \"a PoE1 tool\", which is FLATLY FALSE and contradicts the first rule file of this project - GameHelper2 is a PoE2 tool, its GameOffsets/GameProcessName.cs maps every process name it knows to \"Path of Exile 2\", and LoadedFilesRootObject.TotalCount = 0x10 is therefore a PoE2 number, not a PoE1 one carried over. Then on the reasoning: with that invented doubt in hand it called the slice explanation \"the more economical reading\". IT WAS ECONOMICAL WITH A FACT IT HAD NOT CHECKED. THE PROBE HAS RUN, 2026-09-01, on a live client: PreloadReader.BucketsBeyondTheCount found nothing past the last bucket that looks like one, so the count holds and --tables says so. Sixteen buckets is the whole table. WHAT IS LEFT is the resource-loader explanation, and with it the open question of why four core tables travel through the loader and four do not - that is now the thing to answer, rather than a rival explanation to weigh it against. UNTIL THAT RUNS, do not plan on finding a particular table here - the row-pointer route through a component is the only route to a table this walk does not turn up. WHAT THIS LIST REALLY IS points the same way: 157 of the 6914 records are .dat files at all, against 1219 .tok, 903 .ao and 462 .ast - it is the RESOURCE SYSTEM's list (the hover note above puts FileRoot 0xFA08 from the object that turned out to be exactly that), and the content tables on it are the ones that travel through the resource loader. AND BEING ON IT IS NOT BEING PARSED: 23 of those 157 have nothing usable at RowStorePtr, GrantedEffectsPerLevel and Languages among them, so a table can be present and rowless. Find returns nothing rather than throwing for all of this. AND THE ROUTE RUNS, END TO END, 2026-08-31 (session-2026-08-glossary.rec): FileRoot -> 6907 records -> the KeywordPopups record -> RowStorePtr at +0x28 -> 1026 rows of 0x48, read as English. That last hop had no fixture until then, because the preload walk reads a 32-byte string header at +0x08 and stops one byte short of +0x28, so nothing had ever read a file record's row store; it was the same RowStorePtr already confirmed from the MinimapIcon and NPCs side on the same kind of object, and now it is confirmed on this route as well. 131 of those 6907 files are dat tables, which is the size of the thing this opens up.",
      "fields": {
        "Path": { "offset": "0x08", "type": "stdWString", "comment": "\"Data/Balance/MinimapIcons.dat\". Declared as a bare PathPtr before, which read the same characters and left the two ints next to it unexplained." },
        "RowStorePtr": { "offset": "0x28", "type": "ptr", "struct": "DatRowStore", "invariant": { "kind": "plausiblePtr" }, "comment": "The rows themselves and the indices over them. This is the \"another pointer at 0x28 into the same table blob\" that used to be listed as unread." }
      }
    },

    "DatRowStore": {
      "comment": "What DatTable.RowStorePtr points at: a table's rows, plus one index by Id and one by HASH32. THREE CONTAINERS OF FOUR POINTERS EACH - begin, end, end again, end-of-allocation - so they stride 0x20 apart, NOT the 0x18 of a std::vector, and reading them as std::vectors walks off by 8 at the second one. The duplicated third pointer is what says the container is not std::vector; it held the identical value in all three, in the one table read so far. Counts come out equal and exact for all three (5717 rows, 5717 by-Id entries, 5717 by-HASH32 entries on QuestFlags), which is what says the two indices are DENSE, entry-per-row arrays in row order rather than bucket arrays: a bucket array would be capacity-sized and mostly empty. Where the buckets actually live is open - the capacity/grow-at/load-factor triples beside each index describe a table of 8192 slots at 0.8, and no pointer to 8192 of anything is in this struct. THE ROW SIZE FALLS OUT OF THIS, which is the part worth having. A by-Id entry is a fixed 0x18 whatever the table, and there is exactly one per row - so the index says how many rows there are, and the rows array divided by that says how big one is. A table therefore reports its own row size, with no dat-schema and no download: (rowsEnd - rowsBegin) / ((byIdEnd - byIdBegin) / 0x18), which is 68604 / 5717 = 12 on QuestFlags. Until now that number could only be COMPUTED from the community schema's column list and then checked against a stride by hand, which is how the width table was verified three times (MinimapIcons 0x26, WorldAreas 0x300, NPCs 0xBF). This turns that into something the game answers directly, for every table it has loaded.",
      "fields": {
        "Rows": { "offset": "0x00", "type": "stdVector", "comment": "The rows, back to back, at the table's own row size - so (end - begin) / rowSize is the row count, and rowSize comes from dat-schema (see the column-width note above). No vectorSane invariant on purpose: the element size is per-table and this struct does not know which table it belongs to." },
        "ByIdIndex": { "offset": "0x20", "type": "stdVector", "invariant": { "kind": "vectorSane", "elementSize": 24, "maxCount": 1000000 }, "comment": "One 0x18 entry per row: the Id's characters at +0x00, its LENGTH IN CHARACTERS at +0x08 (an i64, so the 4 bytes at +0x0C read 0), and the row it belongs to at +0x10. The characters pointer is the same one the row's own Id column holds. ENTRY N HOLDS ROW N, which was an inference from the counts coming out equal and is now an observation: a debugger scanning the whole address space for a pointer to row 851 landed inside this array, and the eight bytes after that pointer - the next entry's key, since the hit sits at +0x10 of a 0x18 entry - spell the Id of row 852. CanSeeAngeInHideout followed by P2InterludeBaryaObtained, and both names came out of a recording taken hours before the debugger looked." },
        "ByIdCapacity": { "offset": "0x40", "type": "i64", "comment": "8192 on QuestFlags, against 5717 entries - so a capacity in ENTRIES, and the allocation confirms it: end-of-allocation is begin + 8192 * 0x18 exactly." },
        "ByIdGrowAt": { "offset": "0x48", "type": "i64", "comment": "6553 = 8192 * 0.8, i.e. capacity times the load factor below, precomputed." },
        "ByIdLoadFactor": { "offset": "0x50", "type": "f32", "comment": "0.8. The four bytes above it are not part of it." },
        "ByHashIndex": { "offset": "0x58", "type": "stdVector", "invariant": { "kind": "vectorSane", "elementSize": 16, "maxCount": 1000000 }, "comment": "One 0x10 entry per row: the row's HASH32 column at +0x00, four bytes of nothing, and the row at +0x08. The spare four bytes are UNINITIALISED rather than reserved - they read as UTF-16 text fragments (0x005F0065, 0x00410000), which is what a reused allocation looks like, and a field decoded out of them would be leftovers from a string blob. CONFIRMED LIVE AS A PREDICTION, not as a reading: a whole-address-space scan for a pointer to row 851 landed in here too, this layout says the entry must begin eight bytes earlier, and the four bytes there therefore had to hold that row's HASH32. 0x0A4F7695, taken from a recording, is what the debugger found at 0x41ED84F3540. Entry N holds row N here as well, and between them the two indices account for two hits per row of any scan that looks for pointers to a table's rows - which is why HeapScan is handed both container ranges to exclude." },
        "ByHashCapacity": { "offset": "0x78", "type": "i64" },
        "ByHashGrowAt": { "offset": "0x80", "type": "i64" },
        "ByHashLoadFactor": { "offset": "0x88", "type": "f32" }
      },
      "consts": {
        "ContainerSize": "0x20",
        "ByIdEntrySize": "0x18",
        "ByIdEntryRowAt": "0x10",
        "ByHashEntrySize": "0x10"
      }
    },

    "DatFileImage": {
      "comment": "THE DECOMPRESSED .dat FILE ITSELF, still resident alongside the parsed rows. Found 2026-08 the long way round: a debugger scanned all of memory for the HASH32 of one QuestFlags row and returned three places - the row, its by-hash index entry, and one more about 1.9 MB BELOW the row array, which nothing in this project could account for. Reading it as a file image is what explains it, and the arithmetic is exact rather than approximate: with a u32 row count first and the rows behind it, the hash of row 851 falls at base + 4 + 851*12 + 8 = base + 0x27F0, which puts the base at an address ending 0010 - the same shape the row array's own allocation has. PREDICTED, THEN READ: the u32 at that base had to be the row count, and it reads 5717, the number the row array and both indices already agreed on. WHAT IS ACTUALLY IN IT is narrower than the name suggests, and the correction is worth more than the guess was. A dat file on disk puts eight 0xBB bytes between the fixed-size rows and the variable-length section, so the bytes at base + 4 + count * 12 were predicted to be that separator. THEY ARE NOT: they read D7 01 00 00 1D 02 00 00, a pair of small integers, and the pairs continue. So this buffer is not a verbatim copy of the file - the fixed-size section is here and the variable section is not, which fits a loader that keeps the raw rows and parses the strings out into the blob that sits beside the row array 1.9 MB away. What the rows in here hold was settled by one read: row 851's Id column, at base + 4 + 851 * 12, holds 46052 - a small number, so a raw file OFFSET rather than the fixed-up pointer the parsed array carries. AND THE TWO HALVES SUBTRACT TO SOMETHING REAL. The parsed row's Id points at 0x41ED845B3F4; take the raw offset off it and the variable section's base is 0x41ED8450010, which lands on the same 0010 ending as the parsed rows (0x41ED8430010) and the file rows (0x41ED8250010) - three allocations of one table, all three shaped like allocations. THAT SUBTRACTION IS THE USEFUL PART, because it generalises: for any loaded table, one row's parsed string pointer minus the same row's raw offset gives the base of the variable section, and from there every string in the table is readable straight out of the file image without walking the parsed array at all. Confirmed on a second row before being written down: row 852's offset had to be 46052 + 42, because the recording measured the gap between those two strings as length * 2 + 4 without knowing anything about file offsets, and it reads 46094. WHAT IS NOT KNOWN YET is what reaches it. No field of DatTable has been seen holding this address, and finding one is a single scan for a pointer to the base - worth doing, because a field there would make every loaded table's raw rows readable by offset instead of by luck.",
      "fields": {
        "RowCount": { "offset": "0x00", "type": "u32", "invariant": { "kind": "range", "min": 1, "max": 4000000 }, "comment": "Rows in the file, and the same number DatRowStore's three containers count. Read as 5717 on QuestFlags, which is how the whole reading was confirmed." }
      },
      "consts": {
        "RowsAt": "0x04"
      }
    },

    "QuestFlagsRow": {
      "comment": "A row of QuestFlags.dat: EVERY quest flag the client knows, by name - \"a1q1-KilledHillock\", \"Act4TownIntroComplete\", \"BreachstoneAreaEntered\", \"EnteredHideout\". 5717 of them in 0.5.x. FOUND 2026-08 by the owner in the dissector, from a VaalTimeScientist's NPC component. THE TABLE SAYS SO ITSELF: DatTable.Path reads \"Data/Balance/QuestFlags.dat\" straight out of the recording. That was found last rather than first, and the three numbers that had already agreed before anyone followed the pointer are kept here, because they are what the next unnamed table will have to be identified by. (1) The rows are 0x0C apart, and QuestFlags is one of 26 PoE2 tables whose columns compute to a 12-byte row. (2) The path LENGTH beside the pointer reads 27, and of those 26 tables exactly one has a 27-character path - so the name was predicted from a number, and then read. (3) An NPCs row reaches it through the NPCs.QuestFlags column, which dat-schema declares as a foreign reference to QuestFlags, at the offset the column widths compute. The Ids reading like quest flags is the fourth witness and the weakest, since that is what suggested the answer in the first place. WHAT THIS IS NOT: a character's progress. There is no value, no bit and no state anywhere in the row or beside it - the table is identical for every character and is the game's list of flag NAMES. WHERE THE SET FLAGS LIVE IS ANSWERED - see QuestFlagSet above, found 2026-08 from an outside report of the chain 0x5A0/0x60/0x188/0x248. They are a SPARSE BITSET over the row numbers of this table, off ServerData, and they hold no pointer, no hash and no string. That is why everything below - which is kept in full, because it is the record of a search that was rigorous and still wrong - could not find them: every sweep looked for a REFERENCE to a row, and the set stores only a row NUMBER. The differential missed it for a second reason worth keeping separately: the chunk vector is exact-sized, so setting a flag in a new chunk reallocates the whole set and flips no bit in place anywhere, which is exactly the 'no isolated bit turning on' the control run reported. WHAT SURVIVES OF THE OLD CONCLUSION, unharmed: every reference to a flag that --questflags has ever found in running memory is a CONDITION, not a state. The fresh-character run settles it - a brand-new character in the first town holds references to A2PerennialKingSlain, HaveAscendancy, G3InThePast and Visited-G3_10, none of which it can possibly have set, so those pointers are rules about when something applies. Six sessions, two characters, about 130 MB of reads swept for row pointers, HASH32 values, Id-string pointers, index entries, bitsets and index lists: no per-character set anywhere reachable from the game state. AND THE FLIP WAS WATCHED. The obvious way to reopen this was to catch a flag being set live, so it was done properly: three recordings in one game session - one, a second with nothing changed as a CONTROL, then a quest step completed (The Runeseeker, Speak to Farrow) and a third. The control is what makes it mean anything: 3,762 pages were readable in all three and identical across the pair where nothing happened, and 144 of those moved after the quest step. Among every byte that changed, there is not ONE new reference to a QuestFlags row - no pointer, no HASH32 - and no isolated bit turning on in anything shaped like a sparse bitset. THAT IS STILL NOT A PROOF OF ABSENCE - it is about REACHABILITY from InGameState, AreaInstance, ServerData and the player entity, and about the 15 MB the three runs happened to have in common. But it is the strongest form of the question this project can ask, asked and answered. AND THE ROW ITSELF WAS WATCHED, from outside this project entirely. A hardware breakpoint on a row's Hash32 - the one address in a debugger trail that can be trusted without re-identifying it, because dat tables are loaded once and never freed while the heap around them changes hands - stayed SILENT through ordinary play. The client does not read a flag's hash at runtime, so a lookup keyed on this column is out. A scan of all memory for that hash VALUE says it again from the other side: three places hold 0x0A4F7695 and every one of them is static - the row itself, its by-hash index entry, and the resident file image - so nothing at runtime keys a flag by hash either. What that does not touch is the two representations that never read the row at all: a set of ROW POINTERS, tested by comparing addresses, and a BITSET indexed by row number, which holds neither a pointer nor a hash nor anything else this project has searched for. AND THEN THE POINTER SHAPE WENT TOO. A scan of all memory for a pointer to one flag row returned eight places: the row's two indices, and six holders. Every one of the six is a LONE pointer - not a single neighbouring qword in 0x80 bytes either side lands on the row grid, in any of them. A set of set-flags cannot look like that. What they look like instead is rules, and three of the four heap holders say so in the plainest way available: the qword at +8 is the same value in all three, the QuestFlags table pointer, which makes them foreign references of exactly the form NPCs and AreaMarker carry. Two of those three are the SAME structure twice over, one with its table halves filled in and one with them zeroed, holding identical numbers at identical offsets - and at +0x60 both hold an NPCs row 382 bytes from the one in the fixture, which is 2 * 0xBF to the byte. A flag paired with an NPC is a rule about that NPC. THE ONE HOLE LEFT IN IT is that nobody knows whether the scanned flag is SET for this character; if it is not, its absence from a hypothetical pointer set proves nothing. Closing that needs a scan over all 5717 rows at once rather than one row at a time, which is what HeapScan does. AND THEN THE WHOLE ADDRESS SPACE WAS SEARCHED, which is the one thing every earlier sweep could not do. Anchored on the table, --heapscan covered 8204 MB across 1256 regions and spent its budget only after reaching two terabytes out - the entire neighbourhood the game allocates in - and found 5958 pointers to QuestFlags rows. Every one of them is definition data, and the shapes say so without needing a single name read: the references are scattered over 1994 megabytes with 1557 of those holding exactly ONE, the long uniform runs come at strides of 0x18, 0x30, 0xEC, 0x184 and 0x69C - record sizes, not pointer packing - a fifth of the listed hits are not even 8-aligned, which only packed dat rows can be, and NEVER_SET turns up in six regions including the densest at 927. A flag that is never set for anybody cannot be in a list of set flags. THE DECIDING MEASUREMENT is the packing: a set held as pointers is pointers back to back, 8 or 16 bytes apart, hundreds of them for any character past act one. The longest such run anywhere in that scan is THREE, and each of those threes is adjacent columns inside one dat row. So the pointer representation is not merely unreachable, it does not exist - and unlike every earlier negative here, that does not depend on which roots were walked. What is left is a bitset indexed by row number, an index list, or nothing client-side at all, and no amount of looking for references can settle it - only watching memory change at the moment a flag is set. Do not reopen without something genuinely new: a different root, the client being seen to READ a flag it was never sent, or a live differential that catches the write. REOPENED 2026-08 ON A REPORTED CHAIN, and it qualifies on the first of those three: an outside report gives 0x5A0, 0x60, 0x188, 0x248 as ending at 'the start of the questflag vector'. The first number names the root the report left out - 0x5A0 is AreaInstance.PlayerInfo, whose VALUE is already ServerDataPtr - so the route is ServerData -> +0x60 -> +0x188 -> +0x248, and it is an INDEX LIST, which is one of exactly two representations this hunt left standing and the one no reference search could ever have found: a vector of row NUMBERS holds no pointer, no hash and no string, so all 130 MB of sweeping above was looking for the wrong shape. WHAT THE RECORDINGS SETTLE, three hops of four (QuestFlagChainTests replays it): ServerData resolves in every fixture and is page-aligned with vtables at its head; +0x60 resolves in four of them onto an object carrying five vtables; +0x188 resolves in one, onto an ordinary heap object. The fourth hop is beyond EVERY recording this project holds - nothing has read within 0x1000 of it - which is the hunt's own explanation for six failed sessions restated: the reads never went there. Settling it needs the game and one command: --peek 'GameStates,88,290,5A0,60,188,248' --peekwatch --record qf.rec, then complete a quest step and watch the vector's end pointer move. NOTHING IS WRITTEN INTO A STRUCT UNTIL THAT RUNS - the chain is a lead with three hops checked, not a finding.",
      "fields": {
        "Id": { "offset": "0x00", "type": "utf16Ptr", "comment": "-> the flag name as raw UTF-16, not a std::wstring. The strings sit back to back in one blob in row order, each followed by four bytes of terminator and padding - verified across 64 consecutive rows, where the gap to the next string is (length * 2 + 4) every time." },
        "Hash32": { "offset": "0x08", "type": "u32", "comment": "The table's own HASH32 column, straight from the file rather than computed at load: FNV-1a, FNV-1, djb2, sdbm, murmur3, CRC-32 and Adler-32 were all tried over the name in UTF-16 and UTF-8, raw and lower-cased, and none reproduces it. Not a loose end - dat-schema calls the column HASH32 because nobody knows the algorithm either. DatRowStore.ByHashIndex is keyed on exactly this value." }
      },
      "consts": { "RowSize": "0x0C" }
    },

    "KeywordPopupsRow": {
      "comment": "A row of KeywordPopups.dat: THE GAME'S GLOSSARY, and the table that resolves the [Key|Text] markup its own texts are written in. FOUND 2026-08 by the owner in the dissector, on a hand-followed trail; identified here two ways that cannot both be wrong. (1) THE CONTENT. Every row is an Id, a display term and a popup text - \"CriticalDamageBonus\" / \"Critical Damage Bonus\" / \"Multiplies the damage dealt by [Critical|Critical Hits]...\" - and that Definition names ANOTHER ROW OF THIS TABLE by its Id: row \"Critical\" carries the term \"Critical Hits\", which is the right half of the markup to the character. A table whose text is keyed on its own Id column is what a glossary is. (2) THE ARITHMETIC. Nine consecutive rows in the same screenshot sit on a 0x48 grid without an exception (+0x000, +0x048, +0x090 ... +0x240), and of all 1275 PoE2 tables in dat-schema exactly one has a 0x48 row that STARTS WITH FIVE STRING COLUMNS: KeywordPopups, at 5 * 8 + 2 * 16. The two 16-byte columns are the foreign references ItemReference and ModReference, both null in every row seen - which is precisely the four empty qwords the dissector shows at +0x28..+0x40, and null foreign references are a far more specific thing for four zeroed qwords to be than padding. WHAT THE OTHER TWO STRING COLUMNS ARE is not known here and is not known to dat-schema either, which leaves them unnamed. They are empty in every row seen, and both hold the SAME pointer in EVERY row - the data section's deduplicated empty string - which is what an empty string column looks like from outside and is a third witness to the column count. Not declared as fields because nothing can be said about them. THE STRING POOL, from the same screenshot: UTF-16, back to back, four zero bytes between them (\"Critical\" at 0x...B750, \"Critical Hits\" at 0x...B764 = 8 chars + 4, the next at 0x...B782 = 13 chars + 4) - the same packing QuestFlagsRow.Id documents, on a second table. CONFIRMED LIVE 2026-08-31 by the owner, and the whole route with it (tests/fixtures/session-2026-08-glossary.rec, GlossaryTableTests): 131 dat tables among 6907 loaded files, KeywordPopups found by name, and THE GAME ITSELF REPORTS 0x48 - the row store divides its rows by its by-Id index, so the row size that identified this table from a screenshot is now arithmetic the client did, with no dat-schema involved. 1026 rows, path length 30, row 0 is \"Test\" (\"This test case is designed to be overwitten by other content\", the game's own typo) and row 1025 is \"PowerRune\". TWO THINGS THE SCREENSHOT GOT WRONG, both corrected by that recording and worth keeping because both were read off OUR OWN RENDERING rather than off the game. (1) THERE IS NO DOUBLED PERCENT. This said a literal percent is doubled (\"+100%%\"); the raw column holds \"+100%\", and of the 236 definitions containing a percent not one has it doubled. ImGui takes a label as a format string, so ImGuiText.Escape doubles every '%' before drawing - the dissector was showing its own escaping. (2) A DEFINITION MAY BE EMPTY BUT Critical's IS NOT. 260 of the 1026 rows carry no definition and 251 no Term, so the empty case is real; Critical is simply not one of them - it holds several paragraphs. MARKUP: [Id|Term] renders as the part after the pipe and [Id] as the Id itself, both naming a row of this same table - 596 definitions carry markup, holding 2096 brackets of which 913 have no pipe, and 324 of the 328 keys referenced are Ids here. A SECOND MARKUP shares the column: the 33 Expedition rune rows are rich text instead (\"<rgb(219,217,206)>{Fire Rune}\", \"<font:'fontin'>{...}\", opening \"<<ExpedRuneFire>>\"), and braces occur in those 33 rows and nowhere else, so the two do not overlap. ROW SIZE IS NOT TRUSTED FROM HERE - the table reports its own, see DatRowStore, and KeywordGlossary refuses a table that does not report 0x48.",
      "fields": {
        "Id": { "offset": "0x00", "type": "utf16Ptr", "comment": "-> raw UTF-16, not a std::wstring. The ENGINE key, English on every client: \"Critical\", \"CriticalDamageBonus\", \"JaggedGround\", \"Totem\", \"Taunt\", \"Empowered\", \"Power\", \"Armour\", \"Burning\". This is what the left half of a [Key|Text] markup names, so it is what a lookup is keyed on - never Term, which is localised." },
        "Term": { "offset": "0x08", "type": "utf16Ptr", "comment": "-> raw UTF-16. What the player reads: \"Critical Hits\", \"Jagged Ground\", \"Totems\", \"Monster Power\". Equals the right half of the markup, which is how the table was identified. Localised: display it, never match on it." },
        "Definition": { "offset": "0x10", "type": "utf16Ptr", "comment": "-> raw UTF-16, and MAY BE EMPTY - 260 of the 1026 live rows carry no popup text at all, so a keyword can have a term and nothing to say about it. Contains markup of its own, into this same table. NO LENGTH TRAVELS WITH IT, which is a trap rather than a detail: a raw pointer ends at its terminator, so whatever cap a reader passes is where a long definition silently gets cut, and the cut takes the MARKUP in the tail with it - reading this table at a 512 cap made it look like it refers to 317 keywords when it refers to 328. MEASURED at a 2048 cap: the longest definition is Flammability at 1429 characters, and not one comes back at the cap, so 1429 is the table's real maximum in 0.5.x rather than a number a reader stopped at. 55 definitions are longer than 512." }
      },
      "consts": { "RowSize": "0x48" }
    },

    "NpcsRow": {
      "comment": "A row of NPCs.dat, and the reason the QuestFlags table was reachable at all. Row size 0xBF: 191 bytes over 18 columns, and the stride between the two rows in the fixture is 191 to the byte - the same independent check the MinimapIcons 0x26 and WorldAreas 0x300 strides gave the column-width table, now on a third table. Rows are NOT aligned (both sit at addresses ending in 6 and 5), which is what packed columns look like from outside.",
      "fields": {
        "Id": { "offset": "0x00", "type": "utf16Ptr", "comment": "The engine identifier, e.g. \"Metadata/NPC/Hideout/VaalTimeScientist\". The Metadata column at 0x10 holds the SAME pointer, not a copy." },
        "Name": { "offset": "0x08", "type": "utf16Ptr", "comment": "The display name - \"Zolin\", \"Zelina\". Localised, so classify on Id. ShortName at 0x38 holds the same pointer on both rows seen." },
        "Metadata": { "offset": "0x10", "type": "utf16Ptr" },
        "QuestFlagsRowPtr": { "offset": "0x18", "type": "ptr", "struct": "QuestFlagsRow", "comment": "The flag this NPC hangs off - the ROW half of the foreign reference, at the column start. See the order note above; this column is where it was settled." },
        "QuestFlagsTablePtr": { "offset": "0x20", "type": "ptr", "struct": "DatTable", "comment": "The TABLE half, +8 from the column start." },
        "ShortName": { "offset": "0x38", "type": "utf16Ptr" },
        "Act": { "offset": "0x40", "type": "i32", "comment": "Read 10 on both hideout NPCs, which is not an act number anyone plays through - treat the column name as dat-schema's, not as verified here." }
      },
      "consts": { "RowSize": "0xBF" }
    },

    "Npc": {
      "comment": "Component: an entity that talks. SEEN ONCE (2026-08, in session-2026-08-questflags.rec, on Metadata/NPC/Hideout/VaalTimeScientist) and not on any other entity, so treat the offset as one observation rather than as confirmed. Its shape is the one Chest already has - a component pointing at a shared data object that carries the dat row - and the row it lands on is the NPCs row for this entity's own metadata path, which is the check that makes a single sighting worth writing down.",
      "fields": {
        "NpcDataPtr": { "offset": "0x18", "type": "ptr", "struct": "NpcData", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    "NpcData": {
      "comment": "Shared per-NPC-type data, one per metadata path rather than one per entity. Only the row is decoded.",
      "fields": {
        "NpcsRowPtr": { "offset": "0x10", "type": "ptr", "struct": "NpcsRow", "invariant": { "kind": "plausiblePtr" } }
      }
    },

    "MinimapIconRow": {
      "comment": "A row of MinimapIcons.dat. The name is the game's own category for the marker (\"Waypoint\", \"QuestObject\", \"RewardChestExpedition\"). The computed layout is 9 columns, row size 0x26: Id 0x00, MinimapIconRadius 0x08, LargemapIconRadius 0x0C, two bools, MinimapIconPointerMaxDistance 0x12, an unnamed i32 0x16, Name 0x1A, an unnamed i32 0x22. Read live 2026-08 on the \"NPC\" row: radii 1 and 1, pointer distance 250.",
      "fields": {
        "NamePtr": { "offset": "0x00", "type": "ptr", "comment": "The table's Id column, which is the engine identifier and stays English. Classify on THIS, never on the Name column at 0x1A. That column is SOMETIMES EMPTY AND SOMETIMES NOT, which is the trap: NPC, Portal and Shrine all hold the same pointer there - the shared empty string, sitting below every real string in the blob - and reading those three is enough to conclude the column is unused. It is not. Rows 888, 892 and 896 carry \"Morning Bell\", \"The Captain's Chair\" and \"Shark Pit\" (seen live 2026-08, at n*0x26+0x1A from the AbyssPitInactive row). So it is usable as a nicer LABEL only with a fallback to Readable(Id), and it is worth remembering how the wrong answer was reached: three samples that agreed." }
      }
    },

    "TileStruct": {
      "comment": "0x38 bytes each, inside TileDetailsPtr. WARNING from the AHK port: the tile ARRAY index and the TileIdX sub-cell byte are different things - a case-insensitive variable collision between them once placed every landmark at the map origin. MEASURED ACROSS 2336 TILES of two areas (2026-09, RoomProbe windows in a recording), which is what the rest of the struct turns out to be: +0x00 is a pointer in every single tile and +0x08 in every one that names a file; +0x10, +0x18 and +0x20 are ONE INLINE std::vector - begin, end, capacity - carried by 889 of the 2336 and absent (all three zero) in the other 1447; +0x28 reads zero in all 2336. The vector holds 16-byte elements, 1 to 7 of them, each a pointer and a number, and every one of those pointers leads to an object of a SINGLE type (vtable module+0x345BF80, with a second vtable at its own +0x18 and an inline vector of its own at +0x20). What that object is remains open; what it is NOT is a room - no tile of the 2336 reaches a .arm file object through any slot, one hop, or the vector's contents.",
      "fields": {
        "SubTileDetailsPtr": { "offset": "0x00", "type": "ptr" },
        "TgtFilePtr": { "offset": "0x08", "type": "ptr" },
        "TileHeight": { "offset": "0x30", "type": "i16" },
        "TileIdX": { "offset": "0x34", "type": "u8" },
        "TileIdY": { "offset": "0x35", "type": "u8" },
        "RotationSelector": { "offset": "0x36", "type": "u8" }
      }
    },

    "TgtFile": {
      "fields": {
        "TgtPath": { "offset": "0x08", "type": "stdWString", "comment": "The tile path, e.g. Art/Models/Terrain/..." }
      }
    },

    "StdMap": {
      "comment": "MSVC std::map header, laid out INLINE where it appears (AreaInstance.AwakeEntities is such a struct, not a pointer to one: reading a ptr at its offset yields Head because Head is its first field). Size is the element count. AwakeEntities and SleepingEntities sit 0x10 apart, matching this 16-byte layout.",
      "fields": {
        "Head": { "offset": "0x00", "type": "ptr", "comment": "Sentinel node. Its Parent (+0x08) is the tree root; the sentinel itself is never an element." },
        "Size": { "offset": "0x08", "type": "i64", "comment": "Element count - the sanity bound for a traversal." }
      }
    },

    "StdMapNode": {
      "comment": "MSVC std::map red-black tree node. Entities live in one keyed by entity id.",
      "fields": {
        "Left": { "offset": "0x00", "type": "ptr" },
        "Parent": { "offset": "0x08", "type": "ptr" },
        "Right": { "offset": "0x10", "type": "ptr" },
        "IsNil": { "offset": "0x19", "type": "u8" },
        "KeyId": { "offset": "0x20", "type": "u32" },
        "ValueEntityPtr": { "offset": "0x28", "type": "ptr" }
      }
    },

    "Entity": {
      "fields": {
        "EntityDetailsPtr": { "offset": "0x08", "type": "ptr", "invariant": { "kind": "nonNullPtr" } },
        "ComponentsVec": {
          "offset": "0x10", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 256 },
          "comment": "Vector of component pointers, indexed by ComponentLookup. begin = +0x10, end = +0x18."
        },
        "ComponentsVecLast": { "offset": "0x18", "type": "ptr", "comment": "End pointer of ComponentsVec (component count = (end - begin) / 8)." },
        "Id": { "offset": "0x88", "type": "u32" },
        "Flags": {
          "offset": "0x8C", "type": "u8",
          "comment": "Bit 0 clear = entity valid (GameHelper2 EntityOffsets.cs; was 0x84). NEEDS IN-GAME VERIFY on the 0.5 client - revert to 0x84 if validity regresses."
        }
      }
    },

    "EntityDetails": {
      "fields": {
        "Path": {
          "offset": "0x08", "type": "stdWString",
          "comment": "The metadata path, e.g. Metadata/Monsters/... Everything classifies entities by this string."
        },
        "ComponentLookupPtr": { "offset": "0x28", "type": "ptr", "invariant": { "kind": "nonNullPtr" } }
      }
    },

    "ComponentLookup": {
      "fields": {
        "Bucket": { "offset": "0x28", "type": "ptr", "comment": "Hash buckets of (namePtr, index) entries mapping component name -> ComponentsVec index." }
      }
    },

    "ComponentLookupEntry": {
      "comment": "One hash-bucket entry (0x10 bytes): a component name pointer and the index of that component in the entity's ComponentsVec. Index is a 32-BIT int at +0x08 (the AHK reference reads it as \"Int\"); reading it as 64-bit combines it with the next field and yields garbage for every entry whose following 4 bytes are non-zero - which drops most components (found 2026-08 by tracing a real recording: only entries whose high dword happened to be 0 decoded).",
      "consts": { "Size": "0x10" },
      "fields": {
        "NamePtr": { "offset": "0x00", "type": "ptr" },
        "Index": { "offset": "0x08", "type": "i32" }
      }
    },

    "StdBucket": {
      "comment": "MSVC hash-bucket array behind ComponentLookup.Bucket. Data/DataLast bracket an array of ComponentLookupEntry; Capacity is the bucket count. Ported from the AHK tool's PoE2Offsets.StdBucket.",
      "fields": {
        "Data": { "offset": "0x00", "type": "ptr" },
        "DataLast": { "offset": "0x08", "type": "ptr" },
        "Capacity": { "offset": "0x20", "type": "i32" }
      }
    },

    "Render": {
      "comment": "Component: world position + model bounds + the name the game shows.",
      "fields": {
        "Name": {
          "offset": "0x160", "type": "stdWString",
          "comment": "The readable name - 'Elder Madox' on Metadata/NPC/League/Affliction/ElderMadoxMapIntro. FOUND LIVE (2026-08, owner, in the dissector): a pointer with size 11 one qword on - exactly the length of the text it points at - and capacity 15 after that. A std::wstring, and the layout ReadStdWString already expects. CORRECTED ONCE, and the correction is the useful part: it was first entered as 0xA0, read straight off the dissector's row numbers, which are relative to whatever the VIEW starts at rather than to the component. That view began at Render+0xC0, proved by its own contents - the row at view+0x78 held 14548.91/15711.96, which is CurrentWorldPosition at Render+0x138, and 0x138-0xC0 is 0x78. So every row was 0xC0 low. Read a dissector row as an offset only after checking where the view starts. It also fits: 0x160..0x178 is empty space between CharacterModelBounds (ends 0x150) and TerrainHeight (0x1B0). CONFIRMED IN-GAME (2026-08) across a whole area, and it carries more than expected: NPCs ('Elder Madox', 'Alva'), chests ('Vaal Chest', 'Pot'), and - the useful surprise - area transitions, which name WHERE THEY GO ('Shoreline Hideout', 'Vaal Ruins') on both the portal entity and the terrain piece that is one. Scenery, effects and ground items read empty, which is why every consumer falls back to the metadata path. THE ONE EXCEPTION IS YOUR OWN CHARACTER, which reads the class - 'Sorceress' - and not the name you chose. That is worth knowing twice over: GameHelper2 has this field commented out as 'ClassName' at 0xA0, which is what you would call it having looked at the player and nothing else, and 0xA0 is also exactly where a misread dissector row first put it here. A stale offset agreeing with a wrong reading is not corroboration."
        },
        "CurrentWorldPosition": {
          "offset": "0x138", "type": "f32",
          "comment": "x; y at +0x13C, z at +0x140."
        },
        "CharacterModelBounds": { "offset": "0x144", "type": "f32" },

        "RotationCurrent": {
          "offset": "0x188", "type": "f32",
          "invariant": { "kind": "range", "min": 0, "max": 6.2832 },
          "comment": "WHICH WAY THIS ENTITY IS FACING, in radians, 0..2pi (never negative - measured min 0.000, max 6.282 over 1151 samples). FOUND 2026-08 (owner, dissector on the player's Render + tests/fixtures/session-2026-08-rotation.rec, 53 s standing still and turning). The reference has this pair and could not place it: GameHelper2's Render.cs carries RotationCurrent/RotationFuture COMMENTED OUT at 0xC0/0xC4, which are PoE1 offsets - CurrentWorldPosition moved 0x80->0x138 in PoE2 and this moved with it. It is also the mechanism the game itself uses for aiming rather than any target pointer: nothing in GameHelper2 has a target-entity field at all, while the game's own stat table has action_required_target_facing_angle_tolerance_degrees and active_skill_facing_angle_turn_duration_ms. A skill fires when the actor has turned to within a tolerance of an ANGLE. THE CONVENTION, SETTLED 2026-08 against tests/fixtures/session-2026-08-rotation-clickmove.rec: ZERO POINTS ALONG WORLD -Y, and the angle runs the same way round as atan2(dy, dx). So the direction an entity faces is (sin a, -cos a), and a heading converts as a = atan2(dy, dx) + pi/2. Measured on the 108 samples in that recording where the facing was settled (Current == Future, so it is pointing where it means to rather than catching up) and the player was properly moving: mean offset 90.46 deg, MEDIAN 89.76, 5th-95th percentile 89.48-91.08, and 94% of steps within 5 degrees of pi/2. Turned round the other way - predicting the step from the angle - the same samples come out at a median error under half a degree, with 6 outliers that are all a new click reversing the path inside one 47 ms sample. THE OBVIOUS WAY TO GET HERE DOES NOT WORK, and that is worth as much as the answer: THE CHARACTER DOES NOT FACE WHERE IT WALKS. It faces the MOUSE CURSOR, so this only came out of a recording made with movement bound to the mouse, where the two coincide. In tests/fixtures/session-2026-08-rotation-walking.rec (WASD) the player walks a straight line due +X for eleven consecutive steps while the angle sweeps 365 degrees, and fitting angle against heading across its 153 steps gives a consistency of 0.35 same-sense and 0.08 mirrored, where 1.0 would be a relationship. Both are noise; either would have produced a confident, wrong convention. FacingTests asserts that negative on purpose, because trying atan2 of the path is the first thing anybody does and it returns a number rather than an obvious failure."
        },
        "RotationFuture": {
          "offset": "0x18C", "type": "f32",
          "invariant": { "kind": "range", "min": 0, "max": 6.2832 },
          "comment": "WHERE IT IS TURNING TO - the same angle one step ahead, which is the aim rather than the pose. WHICH OF THE PAIR LEADS WAS MEASURED, not assumed, and it is the whole value of the field: over the 115 samples in which the two differ, this one predicts the NEXT sample's RotationCurrent to within 0.070 rad and wins that comparison 109 times (95%), while RotationCurrent predicts its own next value only to 0.235 rad. The control settles it the other way round too - RotationCurrent predicts the next RotationFuture in 6% of samples. So the follower lands where the leader already was. The two are EQUAL in 90% of samples: a settled facing reads once, and a difference between them means a turn is in progress. Turns are short - 31 of them in 53 s, median 94 ms, longest 610 ms - which is the window any telegraph drawn off this has to live inside. THE THIRD MOVER, at 0x190, is not an angle (0.095..61.8) and moves on every turn, scaling roughly with how far there is left to turn: a turn rate or a remaining-turn quantity, unidentified, and nothing reads it. Those three are the ONLY floats in the whole 0x250-byte block that change at all, which is what makes this a find rather than a candidate - there is no decoy to pick wrongly. REPLICATED ON A SECOND SESSION that shares none of the first one's situation - the walking recording, 487 samples, never standing still: the leader relation comes back at 97% (195 of 201) with the control at 3%, against 95% and 6% standing still. Two sessions, two behaviours, one answer."
        },

        "TerrainHeight": { "offset": "0x1B0", "type": "f32" }
      }
    },

    "Life": {
      "comment": "Component. DRIFT HISTORY: vital bases shifted in 4.5.x (Health 0x1A8->0x1B0, Mana 0x1F8->0x208, ES 0x230->0x248); confirmed in-game via component probe. Matches GameHelper2 Life.cs. Each vital is a Vital sub-struct. THREE MORE VITALS ARE LISTED BELOW UNREAD - see their comments and the pool-cell note above ComponentPools for why 0x420 is what makes them credible rather than merely copied.",
      "fields": {
        "Health": { "offset": "0x1B0", "type": "ptr", "struct": "Vital", "inline": true, "comment": "Vital sub-struct base, not a pointer - read Vital fields relative to this offset. The \"inline\" flag says exactly that, so the browser unfolds it instead of showing eight bytes as an address." },
        "Mana": { "offset": "0x208", "type": "ptr", "struct": "Vital", "inline": true },
        "EnergyShield": { "offset": "0x248", "type": "ptr", "struct": "Vital", "inline": true },
        "Ward": {
          "offset": "0x2E8", "type": "ptr", "struct": "Vital", "inline": true,
          "comment": "UNREAD HERE, from GameHelper2's LifeOffset. NOT VERIFIABLE FROM THE COMMITTED RECORDINGS and that is a statement about the files, not about the offset: no build has ever read past EnergyShield's Current, so every byte from 0x278 to the end of the component is absent from all eighteen sessions. What the recordings DO say is that there is room: the Life components are pool-allocated 0x420 apart (618 of 618 gaps divide by it), which puts this, Divinity and Spirit comfortably inside the object with 0x88 to spare. A capture that reads them is the whole remaining step."
        },
        "Divinity": { "offset": "0x338", "type": "ptr", "struct": "Vital", "inline": true, "comment": "UNREAD HERE, same provenance and same caveat as Ward." },
        "Spirit": {
          "offset": "0x380", "type": "stdVector",
          "comment": "UNREAD HERE, same provenance and same caveat as Ward - but the one of the three worth capturing first, because SPIRIT IS A POE2 RESOURCE with no PoE1 counterpart: it is what reservations and persistent minions are paid for, so 'how much spirit is free' is a question this tool cannot answer at all today. GameHelper2 declares it a StdVector rather than a VitalStruct, so it is a LIST of something and not a pool with a Max and a Current; what the elements are is unknown here."
        }
      },
      "consts": {
        "PoolCell": "0x420"
      }
    },

    "Vital": {
      "comment": "Sub-struct of Life (per vital). THE PERCENTAGE IS AGAINST THE UNRESERVED POOL, not against Max - GameHelper2's VitalStruct: reservedTotal = ceil(ReservedPercent / 10000 * Max) + ReservedFlat, then percent = round(100 * Current / (Max - reservedTotal)). Getting that wrong is not subtle: with half of mana reserved by auras, a FULL mana globe reads 50% against Max, so anything thresholded on it fires forever. THE FIRST EIGHT BYTES ARE NOT A VTABLE, which is what GameHelper2 has there: they read 0x0000333C00003335 for health and 0x00006A3000006A30 for both mana and energy shield, identical on all 136 monsters of the map session - two u32s, the same pair for every entity in the game, so a type tag or a pair of Stats.dat row ids rather than an address. The vtable-shaped slot is 0x08 (below), and the header is the one place this sub-struct differs from the reference.",
      "fields": {
        "OwnerLifeComponent": {
          "offset": "0x08", "type": "ptr",
          "comment": "POINTS BACK AT THE LIFE COMPONENT THIS VITAL BELONGS TO - the value is the component's own address, exactly, for all three vitals of all 136 monsters in tests/fixtures/session-2026-08-map.rec. GameHelper2 names it PtrToLifeComponent and it is worth having for the same reason UiElementBase.Self is: *(vital+0x08) == lifeComponent is a free, unambiguous 'am I really looking at a vital' check before any number here is believed, and unlike a range check on Current it cannot be passed by a plausible-looking wrong offset. Sitting at +0x08 also anchors the rest of the sub-struct: the fields below are measured relative to a base this confirms."
        },
        "ReservedFlat": { "offset": "0x10", "type": "i32", "comment": "Flat amount reserved, subtracted from Max directly." },
        "ReservedPercent": { "offset": "0x14", "type": "i32", "comment": "Reserved share in HUNDREDTHS OF A PERCENT: divide by 10000 to get a fraction (5000 = 50%). Named ReservedFraction here before it was read; the reference name and scale now match." },
        "Regen": { "offset": "0x28", "type": "f32" },
        "Max": { "offset": "0x2C", "type": "i32", "comment": "GameHelper2 calls this Total." },
        "Current": { "offset": "0x30", "type": "i32" }
      }
    },

    "Positioned": {
      "comment": "Component: where the entity stands in the GRID world and how it is moving. Only Reaction is read here so far. KNOWN TO EXIST BUT NOT YET PLACED (2026-08): ExileCore2's PoE2 PositionedComponentOffsets additionally names RawVelocity, PrevPosition, TravelStart / TravelTarget / TravelProgress, GridPosition, Rotation and Scale - names only, its offset values are decoded at runtime. Velocity and travel target are the movement-prediction half of any evasion logic, so they are the hunt AFTER the Actor's action fields. ExileCore2 also shows a separate Pathfinding COMPONENT (WantMoveToPosition, DestinationNodes) - an entity's movement goal lives there, distinct from the Actor's skill destination.",
      "fields": {
        "Reaction": {
          "offset": "0x1E0", "type": "u8",
          "values": { "1": "friendly" },
          "comment": "(reaction & 0x7F) == 1 means friendly. Feeds isFriendly everywhere. Only the one value is named, deliberately: the low seven bits carry more than a side and nobody here has read what the others mean, so every other number stays a number rather than being labelled from a guess."
        }
      }
    },

    "Targetable": {
      "comment": "Component: whether the game will let the player interact with this thing at all - which is also its answer to whether the thing is really in the world. Offsets located via the chest closed-vs-opened diff probe (v4.5.1.1.4). THE WHOLE FLAG BLOCK SITS 0x18 BELOW WHERE GameHelper2 PUTS IT, and that is not one reading but two: the reference has IsTargetable at 0x51 and IsTargetedByPlayer at 0x53, and both were found here independently, in-game, at 0x69 and 0x6B. Two anchors, one delta - so the reference's remaining flags can be placed by arithmetic rather than hunted for, which is what the last two fields below are.",
      "fields": {
        "IsTargetable": {
          "offset": "0x69", "type": "u8",
          "invariant": { "kind": "range", "min": 0, "max": 1 },
          "comment": "The ONLY byte that flips closed(1)/opened(0) across 20+2 chests; also 1 for living monsters, 0 for corpses. Drives highlighting, corpse detection, the kill counter - and now whether a place is drawn at all, since a thing the game will not let you touch is usually a thing that is not there. THAT LAST USE IS CONFIRMED IN GAME FROM BOTH SIDES (2026-08, owner, in the dissector), which is the strongest kind of check this project can make: the quest NPC that was being drawn in an empty map read 0 here, and the SAME NPC standing visibly in the world later read 1. A value that moves with the thing it claims to describe. Worth stating because the entity gives no other sign - it is awake, its validity flag is clear, it has a world position and the game's own NPC minimap icon."
        },
        "IsHighlightable": {
          "offset": "0x6A", "type": "u8",
          "comment": "PLACED BY ARITHMETIC, NOT SEEN: GameHelper2's 0x52 plus this struct's 0x18, so it lands exactly between the two flags that WERE verified in-game. The one flag of the group with an obvious use - it is what the game paints an outline on when the highlight key is held, which is a different question from IsTargetable and a better one for 'would a player see this'. UNREAD IN EVERY COMMITTED RECORDING, and that is a fact about the files rather than about the offset: the reader asks for exactly the four bytes it already knows about, so 0x6A has never been in a capture. One byte more per Targetable read settles it."
        },
        "IsTargetedByPlayer": { "offset": "0x6B", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 }, "comment": "Hover-diff confirmed: only the attacked monster's byte flipped 0->1. Seen again 2026-08 on an NPC with the cursor on it, reading 1 while the game showed its name banner." },
        "MeetsQuestState": {
          "offset": "0x6E", "type": "u8",
          "comment": "PLACED BY ARITHMETIC, NOT SEEN: GameHelper2's TargetableOffsets 0x56 plus the 0x18 this struct sits below it. The reference's own note is '4 -> true', so it is a state number and NOT a bool - do not read it as one until somebody has watched it. Worth having written down because the name is the exact problem it answers: an NPC that belongs to a quest nobody has taken is in the entity list all the same, fully formed, with a position and a minimap icon, and the overlay drew a person who was not there ('Lurking Creature', AbyssJusticeOracleIdentifier, 2026-08). READ TWICE, AND IT DID NOT MOVE (2026-08): 1 while that NPC was absent from the world, and 1 again with the same NPC standing in it. So the byte does not track this NPC's presence, and the name is the only thing suggesting it tracks a quest at all. Not verified - if anything, weakened. The reference's own note is '4 means true', and 1 is not 4 in either reading, so there is no contradiction and no evidence either. Nothing reads this field; IsTargetable answered the case that motivated it, from both sides."
        },
        "HiddenFromPlayer": {
          "offset": "0x71", "type": "u8",
          "comment": "GameHelper2's 0x59 plus the same 0x18. CORRECTED: this was entered at the reference's raw 0x59 while its two neighbours had already been verified 0x18 further on, so it was reading a byte belonging to nothing - unused, which is the only reason it never showed. Reference note: '2 -> False'. OBSERVED ONCE, 0, on the absent quest NPC - so whatever hides that one, it is not this. At least it now reads a plausible bool, which 0x59 did not."
        }
      }
    },

    "Actor": {
      "comment": "Component: animation + skills + cooldowns + THE CURRENT ACTION. The action fields were found 2026-08-29 by --actionhunt against tests/fixtures/session-2026-08-actions.rec, and they are the ones no reference could supply: neither GameHelper2 (main) nor the AHK tool reads any of them for PoE2, and ExileCore2 - which proves they exist, its GameOffsets2 metadata naming ActionPtr, SimpleActionPtr, ActionId and AnimationControllerPtr, its API exposing CurrentAction.Skill/.Destination - decodes its offset values at runtime, so it contributed names and PoE1's shape (ActionPtr 0x1A8 -> wrapper with Skill 0x150 and Destination 0x170, ActionId 0x208, all below AnimationId) and no numbers. THE TWO ACTION SLOTS ARE MUTUALLY EXCLUSIVE, which is what makes them a pair rather than two findings: over 42 acting frames, 0x240 was set for exactly the 15 running frames and null for all 27 casting ones, and 0x238 exactly the other way round. Both point at the same LAYOUT (see ActionWrapper), so whichever way ExileCore2's two names map onto them, they are one mechanism. ActionId itself is still NOT found: 0x380 and 0x2A0 clear the hunt's id test on this recording, but 0x380 is the locomotion-LAYER field already noted below and neither was shown to carry action flags rather than a movement state. CORROBORATED BY A SECOND SESSION (2026-08-29, tests/fixtures/session-2026-08-fight.rec, a different area later the same day, 1383 sampled frames against the first session's 1312): the hunt re-derived 0x240 from scratch as the only pointer slot that separates acting from idle (set on 91% of acting frames, 0% of idle ones, 60 toggles), 0x2A0 again as a short id, and the destination pair again at ActionWrapper+0x150 inside that slot's block - this time over 43 arrivals rather than four, with a scale-free fit returning 10.78 world units per cell against the 10.87 the project's own grid factor gives. Two independent sessions is the difference between a measurement and a coincidence; FightSessionTests asserts the re-derivation.",
      "fields": {
        "SkillActionPtr": {
          "offset": "0x238", "type": "ptr", "struct": "ActionWrapper",
          "invariant": { "kind": "plausiblePtr" },
          "comment": "-> ActionWrapper for a SKILL: set while casting, NULL while moving and while idle. Null is the normal resting state, so a reader must treat 0 as 'not casting' rather than as a failed read. Over the fixture: non-null on all 27 casting frames (OrbOfStorms, Spark x2, Flamewall x2) and on none of the 15 running frames."
        },
        "MoveActionPtr": {
          "offset": "0x240", "type": "ptr", "struct": "ActionWrapper",
          "invariant": { "kind": "plausiblePtr" },
          "comment": "-> ActionWrapper for a MOVE: set while walking or running to a place, NULL while casting and while idle. THE STRONGEST EVIDENCE IN THE WHOLE FIND lives here, because the game settles it rather than any structural argument: the recording holds SEVEN move actions, five of them long enough to follow and four of those run to completion, and in every one of the four the player came to rest at exactly TargetGrid + (0.5, 0.5) cells - residuals 0.4999..0.5000 across all eight numbers, i.e. an error of 0.00 world units against a destination read up to a second earlier. The fifth was interrupted (the actor covered 448 of the action's 698 units and the action ended), which is what an abandoned click looks like and not a bad read. OriginGrid is confirmed the same five times: the actor was 20 to 34 world units from it on each move's first frame, i.e. standing on the square the move started from. A pair that says where somebody will stop, four times, exactly, is a destination. WHAT THE HUNT ITSELF COULD NOT SEE, worth knowing before trusting its silence: its report found no destination at all on this session, because its sampler skipped frames the cheap read does not - it saw one arrival where a plain per-frame read sees four - and its scorer demands three. The hunt found the POINTERS; the arithmetic that confirmed the pair was done afterwards, offline, against the same file."
        },
        "ActionId": {
          "offset": "0x2A0", "type": "i16",
          "values": { "0": "none", "2": "skill", "512": "seen on monsters, neither wrapper slot", "4096": "move committed, not yet moving", "4098": "move and skill at once", "4224": "move", "4608": "move + 0x200", "5248": "move + 0x400" },
          "comment": "WHAT KIND OF ACTION IS RUNNING, as a flags short: 0 with no action, 2 for a skill, 4224 (0x1080) for a move. Found 2026-08-29 in the same session as the pointers, and it earns its place beside AnimationId rather than duplicating it - THE ACTION OUTLIVES AND PRECEDES THE ANIMATION. Two frames of that recording (f727-728, ~100 ms) carry a skill action with a real target while AnimationId reads 0 = Idle and the locomotion layer at 0x380 reads 0 too: something was committed that the animation never showed. For a warning system that is the whole point, because a monster committing to an attack with no distinct animation is invisible to an animation-only reader. It is a SHORT, which is also what PoE1 used (ExileApi's ActorComponentOffsets has `short ActionId` at 0x208) - the dword here reads 0x400000 / 0x400002 / 0x401080, so the high half is something else and must not be read along. The three values seen are all the session contained; other bits certainly exist (0x1080 is already two bits) and nothing here says what they mean, so treat an unlisted value as 'an action, kind unknown' rather than as none. SETTLED AS A FLAGS WORD 2026-08-29 by tests/fixtures/session-2026-08-monsters.rec, which is the first recording of MONSTERS acting (4659 acting sightings, 54 monsters). Seven values turn up - 0x0002, 0x1080, 0x0200, 0x1000, 0x1480, 0x1200, 0x1002 - and they decompose rather than needing a list: EVERY id carrying 0x0002 had the SKILL wrapper slot filled, EVERY id carrying 0x1000 had the MOVE slot filled, and 0x1002 (which has both) had both. So ActionReader tests the BITS, and five values that would otherwise be strangers decode correctly. Two details worth the ink: 0x1000 WITHOUT the 0x0080 beside it reads AnimationId 0 = Idle on all 11 sightings, which is the same 'committed but not yet moving' moment the player session found showing up as its own id; and 0x0200 appears with NEITHER slot filled (14 sightings, animations 66/146/147), so it is an action with no target to read and must not be decoded as one."
        },
        "CurrentSkillPtr": {
          "offset": "0x3A0", "type": "ptr",
          "invariant": { "kind": "plausiblePtr" },
          "comment": "-> the skill object being cast; null while not casting. WHAT IT IS has not been read, only what it IDENTIFIES, and the correlation is exact: across 27 casting frames of three different skills, each animation id mapped to one pointer and each pointer to one animation id - 3 ids, 3 pointers, no crossover (OrbOfStorms 0x445506AC640, Spark 0x445278D0840, Flamewall 0x44550676230). So it answers 'which skill is this' for a monster whose animation id means nothing to us, which is the half AnimationId cannot do. THAT 1:1 CLAIM IS NOW CORRECTED AND IT WAS TOO STRONG - a rule drawn from 27 frames of one session. Over tests/fixtures/session-2026-08-monsters.rec there are FOUR objects for THREE animation ids: 445278D0840 and 445278D0DA0 BOTH play 299. Each object still plays exactly one animation; it is the other direction that fails, so the pointer is FINER than the skill - an instance, or one of two skills behind an animation. Use it as a key for 'is this the same cast as last frame', never as a key for 'which skill is this'. SkillObjectTests pins all of it. IT FOLLOWS THE CAST, NOT THE COMMITMENT, and that limit is the useful part: through the two frames where SkillActionPtr is set with no animation, this is still null. The skill object appears when the animated cast starts, so the earliest warning a reader can give comes from ActionId and the wrapper's target, and this only names the skill once it is under way. Whether it leads to a GrantedEffects row, an ActiveSkillDetails entry or an engine object is STILL unread, but the block itself is now mapped: 0x200 of each of the four objects is in the monsters fixture, most pointers inside point back INTO the object (embedded vectors pointing at their own storage), and the ones that LEAVE it are at 0x000, 0x008, 0x010, 0x1F0 and 0x1F8. No recording follows any of those - SkillObjectTests asserts that dead end - so naming the skill needs a fresh recording made by --skillhunt, which follows them two hops out looking for a dat row's id string. TWO NEGATIVE RESULTS worth having before that session: the ActionWrapper does NOT carry this pointer anywhere in its captured 0x200 (PoE1 had the skill at wrapper+0x150, which in PoE2 is TargetGrid), and of 122 frames with a skill action committed only 53 had a skill object at all - so this cannot be the whole answer for a warning that fires before the cast is under way."
        },
        "AnimationId": {
          "offset": "0x8B0", "type": "i32",
          "invariant": { "kind": "range", "min": 0, "max": 8192 },
          "comment": "DRIFT HISTORY: was 0x8A0, shifted +0x10. The old offset FROZE at 0 while acting - the 'changes' symptom. Confirmed via ActorProbe: 0x8B0 cycles Idle(0)/FixedRun(195)/DodgeRoll(268) and skill CastTypes. THE VECTORS BELOW DID NOT ALL STAY PUT, and the sentence that used to end this comment said they did: ActiveSkills and Cooldowns genuinely did not move - both were proven in place by content - while DeployedEntities moved by this same +0x10, in the same upstream commit as this field. It was lumped in with the other two because it read empty, which is what an unverified field looks like when nothing was deployed; see its comment. WHAT 0x380 ACTUALLY IS, measured 2026-08-29 rather than left as 'a locomotion-LAYER field, not this': it mirrors this field for MOVEMENT (195 while 195 here) but collapses every cast to a single 503, whatever the skill - so it is the animation LAYER's id, coarser than this one and never a substitute for it. It also reads 0 during the skill action that had no animation at all (see ActionId), which is what places it on the animation side of the split rather than the action side."
        },
        "ActiveSkills": {
          "offset": "0xB08", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 16, "maxCount": 512 },
          "comment": "Full granted-skill table (42 entries for a 9-gem char is CORRECT - it includes non-equipped granted effects)."
        },
        "Cooldowns": {
          "offset": "0xB20", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 256 },
          "comment": "Count stays at the number of cooldown-capable skills; live timers are inside each entry's cdList, not the list size. The entry layout is ActiveSkillCooldown below - it was missing, so this vector pointed at bytes nothing in the file described."
        },
        "DeployedEntities": {
          "offset": "0xC28", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 24, "maxCount": 256 },
          "comment": "The player's own totems/minions/mines, as entity ids - what threat logic needs in order to STOP counting them as threats. DRIFT HISTORY: was 0xC18, shifted +0x10, and the correction is the same one AnimationId above already carries. GameHelper2 moved BOTH in ONE commit (97d84cc, 'Adds Condition for Command skills not on cooldown'): AnimationId 0x8A0->0x8B0 and DeployedEntityArray 0xC18->0xC28, while ActiveSkills 0xB08 and Cooldowns 0xB20 were left untouched. Three of those four fields are independently confirmed here: AnimationId at 0x8B0 in-game (see its comment), and the two vectors NOT moving, in-game, by CONTENT - ActiveSkills@0xB08 decoded 42 entries with 10/10 valid detail pointers while +0x10 gave count=155587 and garbage; Cooldowns@0xB20 decoded 4 entries with real datIds and clean 8000/10000 ms timers (AHK ActorVectorProbeRun, 0.45.13.181). This field is the ONLY one of that commit nobody ever checked, and the reason is the trap: the probe ran with NO minions or totems out, so the vector was empty at both candidate offsets and neither could be told from the other. The note that stood here - 'Empty (begin=end) with no minions/totems out, that is not a drift' - restated that untested case as a finding. It is precisely the symptom a 0x10-short read produces FOREVER, including with a full army out, so it could never have caught the drift it was dismissing. CONFIRMED IN GAME 2026-08-29 (tests/fixtures/session-2026-08-deployed.rec, a session the owner recorded with a totem out - the one thing that had always been missing). Over 1208 frames, 329 decoded entries the ENTITY MAP KNOWS and every single one of them at THIS offset; not one at 0xC18 or 0xC38. The 0x18 stride decodes with no remainder. And the old offset is not an empty vector, it is NOT A VECTOR: begin reads 0 at 0xC18 on every frame, so 'empty with nothing deployed' was never even the right description of what it was doing. THE OTHER 879 FRAMES ARE NOT EVIDENCE AGAINST IT: they read the same single entry here whose id the entity map has already dropped, which is a totem expiring - the reading going stale, not the offset being wrong. WHAT IS PROVEN IS THE OFFSET AND THE STRIDE AND NO MORE: EntityId is checked against the entity map, which is the game confirming it, while SkillsDatId, DeployedObjectType and Counter are decoded at their documented places and nothing validates them (the sample's SkillsDatId read -2063138751, which is not obviously a dat row id). DeployedEntitiesProbe still runs every session at this offset and its +/-0x10 neighbours, so a re-drift announces itself; it decides by CONTENT rather than by a plausible-looking count, which is the check that let 0xB08 and 0xB20 be proven."
        }
      },
      "consts": {
        "DeployedEntitySize": "0x18"
      }
    },

    "DeployedEntity": {
      "comment": "One entry of Actor.DeployedEntities: a totem, minion or mine the player put into the world. GameHelper2's DeployedEntityStructure. THE ELEMENT GREW FOR PoE2, 20 bytes to 24 (0x14 -> 0x18), which is a second and INDEPENDENT way to read 'no deployed entities' off a perfectly correct pointer: a reader that checks the vector's byte length against its element size rejects the whole vector when the two do not divide, so an undersized element makes the count read 0 rather than read wrong. Both halves of that trap - the offset and the stride - therefore fail with the identical, harmless-looking symptom, which is why this entry records the stride next to the offset instead of leaving it to whoever first decodes an entry. EntityId cross-references the entity map, and that is the check worth making: an id that names a real entity is the game settling the question, where a plausible count is not.",
      "fields": {
        "EntityId": { "offset": "0x00", "type": "u32" },
        "ActiveSkillsDatId": { "offset": "0x04", "type": "i32" },
        "DeployedObjectType": { "offset": "0x08", "type": "i32" },
        "Counter": { "offset": "0x10", "type": "i32" }
      },
      "consts": {
        "Size": "0x18"
      }
    },

    "ActionWrapper": {
      "comment": "WHAT AN ACTOR IS DOING RIGHT NOW, and where it is aimed - the object both Actor.SkillActionPtr and Actor.MoveActionPtr point at. Found 2026-08-29 (--actionhunt, tests/fixtures/session-2026-08-actions.rec, 42 acting frames). THE TWO KINDS SHARE THIS LAYOUT, which is most of the reason to believe it: OriginGrid held the caster's own square on all five casts AND the run's starting square on the move, while TargetGrid held a different aim point per cast AND the square the runner then stopped on. One struct, two uses, both fields behaving as their names say in each. PoE1's ActionWrapper had Target (an entity) at 0xB0, Skill at 0x150 and a float Destination at 0x170; PoE2 has moved all of it and changed the destination's TYPE - see TargetGrid. Nothing here is a port. THE BLOCK IS MOSTLY UNREAD: only 0x200 bytes were captured and only these two pairs are identified. A target ENTITY pointer, which PoE1 carries and which would say WHO a monster is attacking rather than only where, has not been looked for - it is the obvious next thing to want.",
      "fields": {
        "TargetGrid": {
          "offset": "0x150", "type": "i32",
          "comment": "WHERE THE ACTION IS AIMED, as a GRID pair: x here, y at +0x154. INTEGER GRID CELLS, not world floats - the one thing about this find nobody would have guessed from PoE1, where the same idea is a float Vector2 of world units. THE CELL'S CENTRE IS THE PLACE, not its corner: world = (cell + 0.5) * 250/23, and that half is measured, not assumed. Over the four completed move actions of session-2026-08-actions.rec the player settled at exactly grid + (0.500, 0.500), every axis of every arrival inside 0.4999..0.5000, so with the half cell the prediction is exact to 0.00 world units and without it every prediction is 7.69 units short in the same direction. A residual that never varies is quantisation. (250/23 = 10.8696 is the project's cell size - a terrain tile is 250 world units across 23 cells - and lives in MapView.WorldToGrid; ActionReader does this conversion once so no caller has to know.) THE MOVE CASE IS THE PROOF, because the game decides it. THE CAST CASE is corroboration rather than proof: five casts gave five different targets, all within a few cells of the caster, while OriginGrid stayed on the caster's own square - consistent with an aim point and not independently checked. THAT CHECK HAS NOW RUN, on monsters rather than on the player, and it passes: over 1649 monster SKILL actions in tests/fixtures/session-2026-08-monsters.rec the bearing from OriginGrid to TargetGrid agrees with Render.RotationCurrent to a MEDIAN OF 1.6 DEGREES, 94% of them inside thirty - a field found a month earlier by a different method on a different recording, so this is two unrelated readings agreeing. THE MOVE CASE IS SETTLED ON MONSTERS TOO, and far more strongly than it ever was on the player: 210 monster moves ran to completion and ended on this destination, 185 of them EXACTLY (median miss 0.00 world units, worst 10.87 = one cell), across 39 distinct monsters of eleven kinds nobody had aimed a probe at. DO NOT expect a MOVE's bearing to match the facing, though - it does not, at 25.9 degrees median, and measuring it from the monster's current position makes it worse (32.5). A monster faces its quarry and walks around obstacles, exactly as the player faces the cursor rather than the path; the facing says what it is aimed at and this says where it is going. It could not be run on this fixture because nothing in that build read the facing bytes, so they are not in the file - the standing rule that a recording holds only what the running build read. THE FACING IS NOW IN THE FILE: session-2026-08-fight.rec carries it on 1383 of 1390 frames, so the bearing check can run as soon as a recording holds an ACTING MONSTER - which that one does not, for the reason FightSessionTests records."
        },
        "AnimationRow": {
          "offset": "0x220", "type": "ptr",
          "invariant": { "kind": "plausiblePtr" },
          "comment": "-> THE ANIMATION'S OWN ROW in Data/Balance/Animation.dat, whose FIRST field is a pointer to its id string. Found 2026-08-29 by --skillhunt against tests/fixtures/session-2026-08-skills.rec, a session in which the owner deliberately cast six different skills. PROVEN A ROW ARRAY INDEXED BY ANIMATION ID, which is what makes it a reading rather than a coincidence: over the six ids seen (299, 407, 472, 474, 501, 889) the row address is base + id * 106 EXACTLY - the same 106-byte stride across every gap, including a jump of 388 ids. A companion pointer at 0x228 (duplicated at 0x238, as this one is at 0x230) leads to the dat FILE object, whose path at +0x008 reads 'Data/Balance/Animation.dat' - so the table this indexes is named by the game itself. WHAT IT IS NOT, and the hunt was looking for it: the SKILL's id. Five of the six names match data/animations.tsv exactly, which is a hand-maintained file extracted from the AHK tool, so these are animation names. The sixth disagreed: the game calls 889 ElementalWeakness where the shipped table said InteractLeanWell. That read as one stale row from a six-row sample and was not - reading the WHOLE array (--animdump, base = row - id*106) showed three rows inserted at 584, 599 and 904, shifting 500 of the file's 1084 rows, every one of them fitting a shift exactly. data/animations.tsv is now generated from this pointer rather than hand-maintained. THE SKILL ID IS STILL NOT REACHED - within 0x400 of this wrapper the ONLY dat file referenced is Animation.dat, and two hops out of Actor.CurrentSkillPtr reached no text at all."
        },
        "OriginGrid": {
          "offset": "0x180", "type": "i32",
          "comment": "WHERE THE ACTION STARTED FROM, same grid units: x here, y at +0x184. On every one of the five casts this was (998, 1275), exactly the standing caster's own square, and on the move it was (1045, 1262) = world (11359, 13717) against a first sampled running frame at (11339, 13730) - the click's square, a moment before the sampler saw the run. Worth having beside TargetGrid rather than deriving the actor's position from Render: the pair together IS the action's line, in one coordinate system, read from one place, at the moment the action was committed - which is what a telegraph wants to draw."
        }
      },
      "consts": { "WorldPerGridTimes23": "250" }
    },

    "ActiveSkillStructure": {
      "comment": "One entry of Actor.ActiveSkills, Size apart: a pointer to the skill's details plus one pointer nothing uses. Ported from GameHelper2's ActiveSkillStructure and the AHK tool's PoE2Offsets - two working PoE2 readers that agree - but NOT yet read by anything in this codebase; declared so the action hunt and any future skill reader share one layout.",
      "fields": {
        "ActiveSkillPtr": { "offset": "0x00", "type": "ptr", "struct": "ActiveSkillDetails" }
      },
      "consts": { "Size": "0x10" }
    },

    "ActiveSkillCooldown": {
      "comment": "One entry of Actor.Cooldowns, and the reason it is here is that the vector had no element type at all - a decoded pointer to undescribed bytes. UNVERIFIED, ported from GameHelper2's ActiveSkillCooldown, and the recordings cannot help: no build has read past the vector header, so all eighteen sessions hold the three pointers and none of the entries. The layout is also the reference's WEAKEST, because it declares two overlapping readings of the same struct (an id at 0x08 and again at 0x38, a cooldown time at 0x34) rather than one - so treat the offsets below as where to LOOK. What makes it worth looking: the live remaining cooldown is not here but inside CooldownsList, which is a vector per skill, so 'is this skill ready' is a two-hop question and not a field. THE ONE THING THAT WOULD SETTLE IT CHEAPLY is a capture taken while a long-cooldown skill is used and recovers, matched against the id in ActiveSkills - the same shape of protocol --actionhunt already runs.",
      "fields": {
        "MaxUses": { "offset": "0x30", "type": "i32" },
        "TotalCooldownTimeInMs": { "offset": "0x34", "type": "i32" },
        "ActiveSkillsDatId": { "offset": "0x38", "type": "i32", "comment": "Which skill this entry is for - the join back to ActiveSkills. GameHelper2 also names an id at 0x08 in the same struct; one of the two is stale and nothing here can say which." },
        "CooldownsList": { "offset": "0x10", "type": "stdVector", "comment": "The live timers. A vector per skill, which is why the entry count stays flat while cooldowns come and go." },
        "OwnerActorPlusOffset": { "offset": "0x28", "type": "ptr", "comment": "Back-pointer into the Actor component, at some offset from its base - the reference names it PtrToActorComponentPlusOffset and does not say what the offset is. Worth checking first of everything here, because a back-pointer is the one field in this struct that can be VERIFIED without knowing what any of the others mean: read it, subtract the actor's address, and either the difference is the same constant for every entry of every monster or the layout is wrong. That is exactly how Vital.OwnerLifeComponent was settled." }
      },
      "consts": { "Size": "0x48" }
    },

    "ActiveSkillDetails": {
      "comment": "What one granted skill is. Same provenance as ActiveSkillStructure (GameHelper2 + AHK tool, agreeing). CastType IS THE SAME ENUM AnimationId CARRIES while that skill is being cast - the AHK drift log observed 299 SparkAdditive, 472 Flamewall, 474 OrbOfStorms as live player AnimationIds, and all three are rows of data/animations.tsv. That identity is what answers 'which skill is casting right now' without an action pointer: match AnimationId against the player's own CastTypes. The action hunt prints that match as a live cross-check, which doubles as the first in-game verification of these two structs.",
      "fields": {
        "UseStage": { "offset": "0x08", "type": "i32" },
        "CastType": {
          "offset": "0x0C", "type": "i32",
          "comment": "READ ZERO ON EVERY ENTRY of a real 41-skill player table (2026-08-29, session-2026-08-actions.rec), so this offset is either wrong for PoE2 or these are the granted effects the reference itself skips - GameHelper2 discards entries whose UnknownIdAndEquipmentInfo >> 0x10 is below 0x8000 as having 'no usecase'. The three cast types the player demonstrably used that session (474 OrbOfStorms, 299 SparkAdditive, 472 Flamewall, all read live from AnimationId) appear NOWHERE in the first 0x100 bytes of any entry, which is the finding: the wider search that would settle it needs a recording made by a build that reads the whole block, and this one only read four bytes here. Until then Actor.CurrentSkillPtr identifies a cast without this table at all. --skillhunt NOW SEARCHES FOR THIS FIELD BY WHAT IT CONTAINS rather than by where a reference put it: while a skill is being cast the actor's AnimationId IS that skill's cast type, so it scans every entry's first 0x100 for the live animation id and keeps the offsets that hit exactly ONE entry. Over several different skills one offset should be left standing."
        },
        "GrantedEffectsPerLevelDatRow": { "offset": "0x48", "type": "ptr", "comment": "-> the skill's GrantedEffectsPerLevel row; the reference resolves the skill NAME through it." },
        "TotalUses": { "offset": "0xE4", "type": "i32" },
        "TotalCooldownTimeInMs": { "offset": "0xE8", "type": "i32" }
      }
    },

    "LoadedFilesRoot": {
      "comment": "What the FileRoot static points at: an ARRAY of BucketCount buckets, each BucketSize apart. GameHelper2's LoadedFilesRootObject, whose TotalCount is 0x10. The name says hash map and the layout says otherwise - each bucket is a plain vector with a capacity beside it, so walking one needs no hashing.",
      "fields": {},
      "consts": {
        "BucketCount": "0x10",
        "BucketSize": "0x38"
      }
    },

    "LoadedFilesBucket": {
      "comment": "One bucket. Data is a StdVector of FileRecordSlot; Capacity is one LESS than the real capacity, and is only read as a sanity gate - the vector's own first/last say how many there are.",
      "fields": {
        "Data": { "offset": "0x00", "type": "stdVector" },
        "Capacity": { "offset": "0x18", "type": "i32" }
      }
    },

    "FileRecordSlot": {
      "comment": "One slot in a bucket's vector. Three pointers; only the middle one leads anywhere. An EMPTY slot is ordinary - a hash table is mostly empty - so a null or unreadable record here is not an error.",
      "fields": {
        "Record": { "offset": "0x08", "type": "ptr" }
      },
      "consts": { "Size": "0x18" }
    },

    "FileRecord": {
      "comment": "One loaded file. AreaChangeCount is the STAMP the game put on it when it loaded, and nothing re-stamps it - so the files carrying the newest stamp in the table are the ones the current area brought in. MEASURED LIVE (2026-08), and it disagrees with the reference: GameHelper2 puts the stamp at 0x40 and has 0x38 commented out as an UnknownConstant, and here it is the other way round. With the counter static reading 13, a sweep of 3999 records found 13 at +0x38 in 465 of them and NOWHERE at +0x40, where all 3999 held a flat 2. 465 records carrying the current area's stamp is what a freshly loaded map looks like; a field reading the same number in every record is a constant, not a stamp. GameHelper2 skips stamps below 3 because the first couple of areas of a session load the whole menu with them, and that is kept. A RECORD FOR A .dat FILE IS A DatTable - the same object, not a parallel one, so this table is also the index of every content table the game has loaded and the only route to one that starts at a static. The evidence is written up on DatTable; the consequence here is that FileRecord.Name and DatTable.Path are one field, and that this struct is deliberately not the whole record - a .dat record carries RowStorePtr at +0x28, which no walk of this table has ever read.",
      "fields": {
        "Name": { "offset": "0x08", "type": "stdWString", "comment": "The file's path, e.g. \"Data/Balance/QuestFlags.dat\" - and DatTable.Path is this same field. TWO THINGS DECORATE IT, so never match a whole path literally: a LANGUAGE PREFIX (\"en:Data/Balance/ClientStrings.dat\", in session-2026-08-deployed.rec) on the localised copy of a table, and an '@' variant suffix that PreloadReader.Tidy drops. Match the last segment - PointerPeek's table Name does exactly that, and gets \"ClientStrings\" out of the prefixed form for free." },
        "AreaChangeCount": { "offset": "0x38", "type": "i32" }
      },
      "consts": { "IgnoreFirstAreas": "2" }
    },

    "AtlasPanel": {
      "comment": "The atlas panel is a fixed CHILD PATH from the game-UI root - 22, 0, 6 - and its children are the nodes, the you-are-here marker and the region buttons mixed together. They are told apart by the UiElement Flags word (0x180) with the visible bit (0x800) masked off, which acts as a type fingerprint. THE PATH IS CONFIRMED against a real session 2026-08 (tests/fixtures/session-2026-08-atlas-panel.rec, PanelSessionTests): with the atlas open it lands on a visible UiElement carrying dozens of 36x36 children at scattered positions, which is what the node list looks like. The FINGERPRINTS below are still unverified, ported from GameHelper2 (which credits yokkenUA's Atlas plugin). ITS OWN SIZE IS NOT THE SCREEN IT COVERS, and that cost a bug: UnscaledSize reads 3008x1600 with ScaleIndex 2, which scales BOTH axes by the height factor - 2707x1440 on a 3440x1440 window, leaving the right 733 pixels uncovered while the atlas is plainly drawn across them. Its children sit from -2629 to +877, far outside their parent, because the panel is a viewport onto a map that pans. Anything asking which screen the atlas covers must take the whole window; see PanelReader.WholeScreen. At 16:9 the same numbers overflow the width and the shortfall is invisible.",
      "fields": {
        "ConnectionsVector": { "offset": "0x5A8", "type": "stdVector", "comment": "EVERY line on the atlas, once, on the PANEL - not a per-node neighbour list. Drift history: this project first read it at the same offset on each NODE element, where a node's own bytes occasionally pass for two pointers a small distance apart, so most nodes reported no connections at all and a few reported invented ones. The symptom was a route drawn to the right map by a way nobody can walk. Entries are 0x14 bytes: an unknown i32, then the source grid pair, then the target grid pair." }
      },
      "consts": {
        "PathFromUiRoot0": "22",
        "PathFromUiRoot1": "0",
        "PathFromUiRoot2": "6",
        "VisibleMask": "0x800",
        "MapNodeFingerprint": "0x542EF3",
        "MistNodeFingerprint": "0x442EF3",
        "CurrentNodeMarkerFingerprint": "0x502EF3",
        "OceanRegionButtonRow": "2",
        "ConnectionEdgeStride": "0x14",
        "ConnectionEdgeSource": "0x04",
        "ConnectionEdgeTarget": "0x0C"
      }
    },

    "AtlasNode": {
      "comment": "UNVERIFIED, same provenance as AtlasPanel. One node of the endgame atlas, which is a UiElement with its own data hanging off it. THE DATA IS NOT IN THE ELEMENT: the reference reads [node+0x10] (the children vector's first pointer) and then +0x20 into that, and the biome, status and map id live at the END of that chain, while the grid position sits on the element itself. Status is a bit field, not a number: 0x02 completed, 0x01 accessible, neither means locked.",
      "fields": {
        "GridPosition": { "offset": "0x320", "type": "i32", "comment": "x here, y at +0x324. On the node ELEMENT, not on its data. The same offset on a region button is a row pointer, which is why the fingerprint has to be checked first." },
        "ContentVector": { "offset": "0x350", "type": "stdVector", "comment": "Content tokens for a rendered node, four bytes each. Only a node the game has drawn has them." },
        "BadgeVectorBegin": { "offset": "0x368", "type": "ptr", "comment": "A vector of BYTES, one per badge, not of pointers: each is an EndgameMapContent ROW and the content id is the row plus 100. It is filled from the server's cell state rather than from the drawing, so it survives fog and culling - which is why it is worth having as well as the badge children." },
        "BadgeVectorEnd": { "offset": "0x370", "type": "ptr" }
      },
      "consts": {
        "DataStoragePtr": "0x10",
        "DataPtr": "0x20",
        "RitualModsChild": "0x3B8",
        "BadgeChild0": "0",
        "BadgeChild1": "0",
        "BadgeContentId": "0x188",
        "BadgeRowToContentId": "100",
        "CompletedBit": "0x02",
        "AccessibleBit": "0x01"
      }
    },

    "AtlasRitual": {
      "comment": "UNVERIFIED, same provenance as AtlasPanel and with the same warning doubled: these were reverse-engineered by yokkenUA against a client of the day, from live-memory observation plus Ghidra analysis of AtlasPanel_ritualLineToggleNode and ritualLineNextCandidates, and NOTHING here has been seen working against this client. They hang off the atlas panel element, so a wrong panel path makes every one of them read rubbish - check the atlas itself first. The ritual line is the 'Head of the King' line: page mode 6, a line id that seeds the reward roll, a vector of clicked-but-unconfirmed grid positions and one of committed ones, plus a precomputed table of which nodes may follow which.",
      "fields": {
        "LineMode": { "offset": "0x637", "type": "u8", "comment": "Non-zero while the panel is in ritual-line mode (page mode 6). Everything else here is meaningless when it is zero." },
        "LineId": { "offset": "0x63C", "type": "u32", "comment": "Seed word 0 of the reward roll. Changes when the line is re-rolled." },
        "PendingVector": { "offset": "0x648", "type": "stdVector", "comment": "Grid positions clicked but not yet confirmed. Pairs of int32." },
        "CommittedVector": { "offset": "0x660", "type": "stdVector", "comment": "Grid positions already on the line. Its COUNT is seed word 1 of the roll." },
        "CandidateTableBegin": { "offset": "0x590", "type": "ptr" },
        "CandidateTableEnd": { "offset": "0x598", "type": "ptr", "comment": "The precomputed next-candidate table the game binary-searches. Entries of 0x44 bytes: node x,y then five (x,y,extra) triples, (0,0) meaning an empty slot." }
      },
      "consts": {
        "CandidateEntryStride": "0x44",
        "MaxCandidates": "5",
        "StatsFirstHop": "0x320",
        "StatsSecondHop": "0x1B0",
        "StatsHolder": "0x3A20",
        "StatsBegin": "0x408",
        "StatsEnd": "0x410",
        "StatsStride": "0x28",
        "StatsValueOffset": "0x08",
        "PickCounterPath0": "22",
        "PickCounterPath1": "2",
        "PickCounterPath2": "0",
        "PickCounterFingerprint": "0x502EE1",
        "TextOffset": "0x4C0"
      }
    },

    "AtlasNodeData": {
      "comment": "UNVERIFIED, same provenance. What the two-hop chain off a node element leads to.",
      "fields": {
        "MapDataPtr": { "offset": "0x2A0", "type": "ptr", "comment": "-> wrapper -> string header -> buffer: the locale-independent map id, e.g. MapUniqueReactor_04." },
        "ContentName": { "offset": "0x290", "type": "stdWString" },
        "BiomeId": { "offset": "0x2CE", "type": "u8" },
        "StatusBits": { "offset": "0x2CF", "type": "u8" }
      }
    },

    "Chest": {
      "fields": {
        "ChestDataPtr": { "offset": "0x160", "type": "ptr", "struct": "ChestData" },
        "IsOpened": { "offset": "0x168", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 } }
      }
    },

    "ChestData": {
      "fields": {
        "IsLabelVisible": { "offset": "0x21", "type": "u8" },
        "StrongboxDatPtr": { "offset": "0x50", "type": "ptr" }
      }
    },

    "Monster": {
      "comment": "The whole component is 0x30 bytes - that is its measured pool cell, so an offset past it is not in the object. See the ComponentPools note. IT HAS NO FIELDS ON PURPOSE, and the empty list is the finding rather than a gap: 0x27 sat here as 'IsBoss' for months, copied from Sikaka/POE2Radar and never once read, and in 2026-08 it was asked and REFUTED. The evidence is in two recordings and it took both, which is the part worth keeping. session-2026-08-hoverhunt.rec read the byte 14,462 times, always zero, across Normal, Magic and Rare - and that settled NOTHING, because no unique monster was in the area and zero on every non-unique is exactly what a working boss flag reads. session-2026-08-hoverboss.rec was then made in front of a map boss: Metadata/Monsters/MudBurrower/MudBurrowerHeadBossMAP2__@70, Unique rarity, 142 sightings, and the byte is ZERO ON THE BOSS TOO. A flag that is clear on a monster with 'Boss' in its own metadata path is not a boss flag. Nothing broke when it went, because nothing used it: MonsterSigns derives IsBoss from rarity >= Unique and always has. Do not put 0x27 back without a capture that shows it set on something. The rest of the component is still undecoded, and --hoverhunt records all 0x30 bytes of it in both files, so the next candidate can be looked for offline.",
      "consts": { "PoolCell": "0x30" },
      "fields": {}
    },

    // ── The four the danger model needs and NEITHER REFERENCE HAS ──────────────
    // Worth stating as a fact about the references rather than a gap in this file, because the
    // obvious next move is to go and look and the answer is already known: GameHelper2 registers
    // layouts for 21 components (its ComponentOffsetTypes) and none of these four is among them.
    // It treats them as MARKERS - its own note in OffsetHelperEngine.cs calls them "components
    // present on entities but with no registered layout", and Entity.cs uses DiesAfterTime purely
    // as "is this a temporary monster". The AHK tool does the same: DecodeDiesAfterTimeComponentBasic
    // reads the two header fields and stops. So there are NO candidate offsets to verify here, and
    // nothing to copy. --sweep exists for that: a blind read of the whole component, decoded
    // afterwards against the file.
    //
    // WHAT IS KNOWN ALREADY, measured from the committed recordings without reading a byte of any
    // of them - the pool cell, who carries them, and how long those live. The lifetimes are the
    // part that matters, because a countdown inside one of these has to reach zero when the game
    // stops listing the entity, and that is a check the game settles rather than an argument.

    "LimitedLifespan": {
      "comment": "On short-lived visual entities - Metadata/Effects/Effect, BeamEffect, ServerEffect - and on Breach monsters, which is where most of the 463 in the sweep capture came from. THE BEST-MEASURED CELL OF ANY COMPONENT HERE: 0x60, from 524 pooled gaps of which 524 divide it. Carriers are many but brief: up to 39 at once, median lifetime 0.5 s. NO TIMER IN IT, and that is a measured result rather than a gap - tests/fixtures/session-2026-08-sweep.rec holds 52,803 readings over 463 entities, 457 of which both appeared and vanished inside the file, and the name promises a lifespan that is not there in any of the three forms it could take. Nothing counts down to zero at expiry. No slot correlates with WHEN the entity dies (a deadline) at r>0.95, and none with HOW LONG it lives (a duration) either. Everything that varies at all - +0x28 through +0x40 - is set once per entity and never moves, and +0x28 is a plausible pointer on all 463 while +0x2C reads 792 or 793 on every one, so that pair is one 64-bit pointer into a table rather than two numbers. The lifespan is presumably behind it. THE COMPONENT IS STILL USEFUL WITHOUT BEING DECODED: its mere presence marks an entity as temporary, which is exactly how both references use it.",
      "consts": { "PoolCell": "0x60" },
      "fields": {}
    },

    "DiesAfterTime": {
      "comment": "The one of the four that is not an effect. The carriers vary more than one recording suggested: totems (Metadata/Monsters/Totems/DarkEffigyTotem) in the deployed capture, but Archnemesis daemons and monster mods - FrostWalkerDaemon, ProximalTangibility, ShockedGroundDaemonParent - in the sweep. CELL 0x50, on THIN EVIDENCE: seven gaps, all divisible, where LimitedLifespan rests on 524. Treat it as the best estimate rather than a measurement, which is why --sweep falls back to shorter reads instead of trusting it. NO TIMER IN IT EITHER, from 5310 readings over 45 entities, 38 of which expired inside the file: nothing counts down, nothing correlates with the death time, nothing with the lifetime. THE OBJECT IS ALMOST ENTIRELY EMPTY - 0x50 bytes of which the header, two constants and three slots are all that is ever non-zero, and of those +0x20/+0x24 is one plausible pointer on all 45. It is a marker with a pointer in it, which is how both references use it and, on this evidence, all it is.",
      "consts": { "PoolCell": "0x50" },
      "fields": {}
    },

    "GroundEffect": {
      "comment": "THE GAME'S OWN GROUND-EFFECT COMPONENT, and the road to that plain statement went through a wrong turn that is kept here because it was instructive. It was first read as a hazard marker; then re-read as marking only a decorative decal with nothing to do with damage; and the second reading was the wrong one. Both of its supports collapsed. (1) A screenshot showed a ring on an Abyssal Arsenal, but its countdown read 0.0 s - and this schema itself records that a countdown sits at 0.0 for a measured 0.38 s after expiring, so that was a SPENT effect, not a harmless one. (2) 5880 of 5916 readings were attributed to a hideout, but those frames carry area level 0 and area HASH 0: a LOADING state in which the area NAME is still the previous area's. They were never hideout decorations. Two mis-readings pointing the same way felt like corroboration and neither was evidence. WHAT THE GAME'S OWN DATA SAYS, which settled it: GroundEffectTypes has 53 rows and EVERY one is a real effect kind applying a real buff - IgnitedGround, ChilledGround, ShockedGround, CausticCloud - with no decorative row at all (row 26 is literally called Unused). The rows the recordings show are Spores, OrionMeteor, CrownOfThorns and Profane. So carrying this component means the game considers the entity one of its ground-effect kinds. It still does NOT follow that every one damages the player - Consecration and Haste are in the same table - so the buff a row applies is what a consumer must look at, and the row index below is how to reach it. Note that the GroundOnDeath monster mods, which really do burn a player, carry no GroundEffect at all AND are refused by the noise filter Daemon class before their components are read. Cell 0xC0, from 65 pooled gaps of which 63 divide it. DECODED 2026-08 (--sweep, 3697 frames, 72 entities). Undecoded slots that vary per entity: +0x60 is a float, 0 or 1.6; +0x64 and +0x68 both MOVE within one entity's life (+0x68 runs 0 to about 0.9) and are running state rather than properties - asking whether a value moves inside a single entity is the check that tells the two apart, and it costs one pass over a capture.",
      "consts": { "PoolCell": "0xC0" },
      "fields": {
        "TypeRow": {
          "offset": "0x48", "type": "u32",
          "comment": "WHICH KIND OF GROUND THIS IS - a row index into the game's own GroundEffectTypes table, which is where the question 'does this hurt' is actually answered. The DAT schema (repoe-fork/dat-export, current/poe2) gives GroundEffects a GroundEffectTypesKey, and GroundEffectTypes carries Id, Stat, BuffDefinition1 and BuffDefinition2 - so damage is a property of the TYPE, expressed as the buffs it applies, and is not a flag anywhere on the instance. That is why years of reading this component for a hazard bit found nothing: the bit does not exist here. WHAT MAKES IT THE TYPE AND NOT ANOTHER NUMBER: it settles one frame after the entity appears and then never moves. IT IS NOT CONSTANT FROM BIRTH, and the first version of this note claimed it was - on 106 of 106 entities in tests/fixtures/session-2026-08-sweep.rec, which was an accident of the capture rather than a fact about the game: that recording was made in a hideout whose decorations already existed when it started, so not one BIRTH was ever recorded. A map capture (tests/fixtures/session-2026-09-groundtypes.rec) caught two, and NEITHER is constant: entity #693 reads 16 on its first listed frame and 18 for the rest of its life; #719 reads 10, then 18. Same address throughout, so it is not entity-id reuse. The likeliest reading is a pooled component cell still holding its previous occupant's value until the server fills it a tick later - 16 and 10 are plausible OTHER type rows rather than garbage - but what is MEASURED is only that the first frame differs and everything after it does not. A CONSUMER THAT NEEDS CERTAINTY MUST IGNORE AN ENTITY'S FIRST FRAME. The property still separates a type from running state, which is the job: +0x64 and +0x68 move continuously throughout a life, where this moves once and holds. The two fields that looked like better candidates both fail that test - +0x64 and +0x68 move WITHIN one entity's life (+0x68 runs 0 to about 0.9), so they are running state however cleanly they separate a hideout from a map. Asking whether a value moves inside one entity is what tells a property from a state, and it costs one pass over a capture. Observed settled values: 12, 17 and 20 in a hideout, 18 in a map - DISJOINT, which is what makes the field worth reading at all, since the entity path is the same generic string on every ground effect in the game. The map ones carry short countdowns (6 s) where the hideout ones run for minutes or carry none. The table itself has 53 rows of 64 bytes, confirmed on a real install at data/balance/groundeffecttypes.datc64 - which is also the check that the vendored column layout in data/ground-tables.json is right, since 64 is exactly what it computes. NO INVARIANT ON PURPOSE, the same reason InGameState.MouseOverHostPtr carries none: recordings committed before anything read this slot cannot serve the read, and 'unreadable' would redden a baseline replay that is behaving correctly. RESOLVED BY GroundEffectTypeTable in the Features layer, which reads the table out of the install and hands back the row's Id - so the overlay label says what a patch of ground IS rather than repeating the generic entity path."
        },
        "RadiusCandidate": {
          "offset": "0x38", "type": "f32",
          "invariant": { "kind": "range", "min": 0, "max": 500 },
          "comment": "A CANDIDATE THAT NOW LOOKS UNLIKELY, kept because deleting a field is also a claim. The name was always the disclaimer; the evidence has since moved against it. Across 5916 readings it takes only THREE distinct values - 18.670750 (5576 times), 18.664923 (298) and 18.657303 (42) - differing in the last digits. A per-effect radius that is the same constant on 94 percent of readings is not describing individual areas: it is a fixed value for one kind of object, or not a radius at all. It is in the right range for the units Render.CurrentWorldPosition uses, which is the whole of the case for it. HOW IT WAS TESTED, since a plausible shape is not a measurement: the overlay projects a ring of exactly this radius onto the ground, so one screenshot answers whether it hugs the patch. The screenshot that came back showed the ring on an Abyssal Arsenal at r=18.65 - which answered something more important than the radius, namely that the component is not about damage at all. THE MAP RECORDING SETTLED IT, AGAINST THIS FIELD. The raw bytes were read rather than the filtered value, which is the check that should have come first: in tests/fixtures/session-2026-09-groundtypes.rec every ground entity holds 0x4EC34228 here, which is 1.63794637E9 - and in session-2026-08-sweep.rec every one holds 0x41955DB2, which is 18.6707497. CONSTANT WITHIN A CAPTURE AND DIFFERENT BETWEEN THEM, and 1.6 billion is not a dimension under any reading. So this is not a per-effect radius and not a global one either; it looks like a shared constant of some other kind - a time base, a seed, an id - and nothing should size a ring from it. WORTH RECORDING BECAUSE SOMEBODY ELSE HIT THE SAME WALL: a long-time PoE1 reverse engineer, asked about damaging ground, said they could reach the effect from the components but had trouble with the area of effect, and guessed that every entity is a square of always the same dimension. The constant-within-a-capture behaviour is consistent with that guess; two different constants are not. THE SIZE OF A GROUND EFFECT REMAINS UNKNOWN - no field found so far carries it, and the overlay draws a ring at a size the user chooses. The earlier idea - walk towards the effect and note where damage starts - was a bad one and is worth keeping as such: ground effects expire, the scene is rarely survivable, and the game does not permit that kind of pixel-precise movement. Verify against something the game DRAWS, not against something it does to you."
        },
        "SecondsRemaining": {
          "offset": "0x58", "type": "f32",
          "invariant": { "kind": "range", "min": 0, "max": 600 },
          "comment": "HOW LONG THIS PATCH OF GROUND STILL BURNS, in seconds, counting down - ON THE EFFECTS THAT HAVE A TIMER AT ALL, which is the first thing to know about it. Across the 72 effects in the sweep capture, 33 held NaN here for their whole life and 39 held a real number, and NOT ONE crossed between the two: it is a property of the effect, not a phase it passes through, so an absent value means 'this one does not expire on a clock' rather than 'the read failed'. The ones without a timer are also the long-lived ones - 59 to 104 s against the timed ones' handful of seconds. A consumer must therefore treat null as ordinary; the overlay rings those patches anyway and simply shows no number, because they burn exactly as much. CONFIRMED against the game's own behaviour rather than by its shape: over 1445 readings on 54 effects that both appeared and vanished inside the capture, 'now + this value' predicts the frame the game stops listing the entity with a median error of -0.38 s and a 5th-95th percentile band of -0.44 to -0.30 s. THE BIAS IS THE FINDING, not noise: the spread is 0.14 s across 1445 readings, so the value reaches zero a consistent 0.38 s BEFORE the entity is delisted - the game keeps it around for a despawn beat after the timer expires. A value that merely decayed would not hold a constant offset to a wall clock that tightly. It falls at 0.913/s measured end-to-end, which is the same fact seen the other way round: the last reading is taken slightly after zero. WHY THIS AND NOT THE OBVIOUS ALTERNATIVE: an alpha or fade would also fall to zero, and would not predict a delisting time from thirty seconds out."
        }
      }
    },

    "Beam": {
      "comment": "The boss beam that made steering necessary, on Metadata/Effects/BeamEffect and ServerBeamEffect. Cell 0xA0, and the weakest-measured of the four - 88 pooled gaps and only 69 divide it, where LimitedLifespan is 524 of 524; the small gaps are all multiples of 0xA0 and the misses are long jumps, so it is probably right and is not proven. DECODED 2026-08 from tests/fixtures/session-2026-08-sweep.rec (63 beams). IT HOLDS A LINE, and every value in the object is set once and never changes while the beam lives - which fits a thing that exists for half a second. Two more slots are understood well enough to warn about rather than to name: +0x7C repeats the TARGET, identical to +0x64 on the median and the 90th percentile, so it is a second copy rather than a second point and decoding it as one would invent a beam that is not there; +0x88 is a float taking only 200, 250 and 400, which looks like a range until it is checked - the actual beam length exceeds it on 709 of 1098 readings, so it is not one. What it is remains open.",
      "consts": { "PoolCell": "0xA0" },
      "fields": {
        "SourceX": {
          "offset": "0x58", "type": "f32",
          "comment": "Where the beam starts. x; y at +0x5C, z at +0x60. It is the beam entity's OWN position, exactly, on 63 of 63 - which is what makes the pair below trustworthy: one end is a value this tool already had from a different component, so the layout is anchored rather than guessed."
        },
        "TargetX": {
          "offset": "0x64", "type": "f32",
          "comment": "Where the beam ends - THE ONE WORTH HAVING, because the far end is what a player has to be out of. x; y at +0x68, z at +0x6C. 17 to 1116 world units from the source, median 400. CONFIRMED BY A CONTROL RATHER THAN BY PLAUSIBILITY: the far end lands within 30 units of an entity in the game's own list on 98% of 1098 readings, and the MIDPOINT OF THE SAME LINE - same beam, same crowd, no reason to be anybody - manages 18%. Landing near something is cheap in a fight; landing near something five times more often than the middle of your own line is not. The convergence says the same thing again: 60 distinct source points across the capture and only 33 distinct targets, with three separate beams from three positions all ending on one point. One control that did NOT discriminate, recorded so it is not mistaken for a second confirmation: another beam's far end from the same frame also scores 97%, which follows from the convergence rather than contradicting it."
        }
      }
    },

    "TriggerableBlockage": {
      "comment": "The barrier a trial or an encounter puts across a doorway. COPIED FROM GameHelper2 (TriggerableBlockageOffsets), not yet seen in this game - the entity browser listed it as a component nobody here had written a byte of, and the reference already had it. Verify by standing at a closed barrier and watching the row flip when it opens.",
      "fields": {
        "IsBlocked": { "offset": "0x30", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 }, "comment": "1 while the way is shut." }
      }
    },

    "Shrine": {
      "comment": "COPIED FROM GameHelper2 (ShrineOffsets), not yet verified here. Two more fields sit commented out in that file and are worth the look if this one proves right: EntityIdWhoLastPickedTheShrine at 0x20, and a pointer to the Shrines dat row at 0x30 - the latter would name the shrine, since that row starts with its Id string.",
      "fields": {
        "IsUsed": { "offset": "0x24", "type": "u8", "invariant": { "kind": "range", "min": 0, "max": 1 }, "comment": "1 once somebody has taken it." }
      }
    },

    "Inventories": {
      "comment": "Component: what an entity itself carries - a monster's equipment, a chest's contents. NOT the ServerData 'Inventory' further down, which is the player's stash and backpack reached through PlayerInventories; the two share a word and nothing else. NOWHERE IN EITHER REFERENCE - GameHelper2's Objects/Components/ holds 21 files and no inventory among them - so all of this was read off the live dissector (2026-08, owner, on a VultureDemon@75) with nothing to corroborate it. THE COMPONENT OWNS A VECTOR WITH INLINE STORAGE, and that is why most of it reads as empty: begin/end/capacity at +0x20/+0x28/+0x30 point back INTO the component itself, at +0x38, where 16 slots run to +0xB8, and the rows go empty at exactly the address 'end' holds. A begin pointer landing inside the structure you are looking at is the tell for inline storage - the empty rows after it are unused slots, not undecoded fields, and reading them as fields is a day lost. WHAT THE ENTRIES ARE IS STILL OPEN: they were followed live and none is a dat row, so the search that went looking for one is closed, not unfinished. THE 'ARRAY OF SUB-OBJECTS' READING WAS WRONG, and this is the correction (2026-08, from the recordings). What repeats at +0x150 is the NEXT ENTITY'S Inventories component: 0x150 is the pool cell, not a sub-object stride. Everything the old reading rested on - the same module pointer at +0x000 and +0x150, the same vector at +0x020 and +0x170, the same inline buffer at +0x038 and +0x188 - is exactly what two components of one class lying side by side in a pool look like, and there is no reading of one object's own bytes that can tell the two apart. WHAT TELLS THEM APART IS THE ENTITY LIST, which is outside the object: over 22,363 sightings across every committed recording, the address one cell on is named as its OWN Inventories component by a DIFFERENT entity 16,560 times and by the SAME entity NEVER. In the 64 frames where the neighbour's header happened to be in the recording, its OwnerEntity holds that other entity. That also closes the open question about +0x158: it is the neighbour's OwnerEntity and names the neighbour, which is why it never matched this entity. See the ComponentPools note for the same measurement on nine other components.",
      "consts": { "PoolCell": "0x150", "InlineBuffer": "0x38", "InlineSlots": "16" },
      "fields": {
        "EntriesVec": {
          "offset": "0x20", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 16 },
          "comment": "begin, with end at +0x28. Pointers, 8 bytes each. maxCount is the inline capacity, so a count above 16 means this is not the vector any more."
        },
        "EntriesVecLast": { "offset": "0x28", "type": "ptr", "comment": "Vector end; count = (Last - First) / 8." },
        "EntriesCapacityEnd": { "offset": "0x30", "type": "ptr", "comment": "End of the inline buffer: begin + 0x80. Its distance from begin is what says the storage is inline and 16 slots wide." }
      }
    },

    // ── COMPONENTS ARE POOLED, AND THE CELL IS EVIDENCE ────────────────────────────
    // Measured 2026-08 across all eighteen committed recordings, by walking every entity's
    // component table and sorting the addresses each component name resolved to. The gaps
    // are not arbitrary: for most components EVERY gap is a multiple of the smallest one,
    // which is what a slab allocator handing out fixed cells looks like and what nothing
    // else does.
    //
    //   Actor    0x0CE0 (500/500)   Life          0x0420 (618/618)   Positioned  0x0550 (1866/1866)
    //   Render   0x0630 (1764/1764) Animated      0x0380 (1780/1780) Stats       0x0210 (753/753)
    //   Buffs    0x0190 (786)       Pathfinding   0x05A0 (724/724)   Inventories 0x0150 (588)
    //   OMP      0x02F0 (635)       StateMachine  0x01B0 (637)       Transitionable 0x0140
    //   Targetable 0x00A0           Chest         0x01F0             MinimapIcon 0x0070
    //   WorldItem  0x00D0           InteractionAction 0x0080         Preload     0x0030
    //   Monster  0x0030             BaseEvents    0x0030             Functions   0x0040
    //   LimitedLifespan 0x0060      Projectile    0x0040             Beam        0x00A0
    //   GroundEffect 0x00C0         BuffOrbs      0x0090             NPC         0x0080
    //   Player   0x05C0             PlayerClass   0x0180             ControlZone 0x0100
    //
    // WHAT IT IS FOR, and it is the only thing in this project that can say anything about a
    // field NOBODY EVER READ. A recording holds only the bytes a running build asked for, so
    // an offset out of a reference normally has exactly two states here: read and confirmed,
    // or absent and unanswerable. The cell adds a third: an offset BEYOND it cannot be in the
    // object at all, and one inside it has room. That is what turns Life.Ward (0x2E8),
    // Divinity (0x338) and Spirit (0x380) from copied numbers into candidates - Life's cell is
    // 0x420, so all three fit with 0x88 to spare, and had the cell come back 0x280 they would
    // have been refuted without a single byte of them being read.
    //
    // AND IT COST A WRONG CONCLUSION ITS FOOTING. Two components of one class lying side by
    // side are indistinguishable from one component containing two identical sub-objects, if
    // all you look at is the object: same vtable one cell on, same vectors, same inline
    // buffers. Inventories was read that way and the reading was wrong (see its comment). The
    // discriminator is outside the object - ask the ENTITY LIST who owns the address one cell
    // on. Over 22,363 Inventories sightings it is another entity's component 16,560 times and
    // the same entity's NEVER, and the same test comes back the same way for Life (9,733),
    // Buffs (19,165), Positioned (52,472), Render (31,816) and Actor (4,648), with zero
    // same-entity repeats anywhere. It also explains two loose ends at a stroke: Inventories
    // +0x158 (the neighbour's OwnerEntity, so of course it names somebody else) and the pair
    // of live-looking pointers at Actor +0xF18/+0xF20, which are 0xCE0 + 0x238 and
    // 0xCE0 + 0x240 - the next actor's SkillActionPtr and MoveActionPtr.
    //
    // The measurement is ComponentPoolTests; it replays the fixtures and needs no game.

    // ── WHAT COMPONENTS THE GAME ACTUALLY ATTACHES ─────────────────────────────────
    // The component table names its own entries, so this is a LIST the game hands over
    // rather than a hunt. Counted over every committed recording, as distinct entities
    // carrying each component (2026-08). Components with no struct in this file are marked
    // (*) - not a to-do list, but the set of questions that CAN be asked.
    //
    //   Positioned 3664   BaseEvents 3646   Animated 3361   Render 3360   StateMachine 1726
    //   Stats 1606   Buffs 1588   Life 1543   Pathfinding 1537   Targetable 1520
    //   Functions 1216   Preload* 1138   ObjectMagicProperties 1112   Actor 1081
    //   Inventories 1066   BuffOrbs* 1066   Monster 1051   Transitionable 506
    //   InteractionAction 505   LimitedLifespan* 501   WorldItem 268   MinimapIcon 260
    //   Projectile* 204   Beam* 126   TriggerableBlockage 94   Chest 65   ControlZone* 48
    //   GroundEffect* 44   Wheels* 43   NPC 42   HideoutDoodad* 17   Player 15
    //   PlayerClass* 15   Portal* 12   CritterAI* 12   DiesAfterTime* 9
    //   GlobalAudioParamEvents* 5   ProximityTrigger* 4   PetAi* 3   Brackets* 2
    //   AreaTransition 2   Timer* 1
    //
    // FOUR OF THE UNMODELLED ONES ARE THE OPEN QUESTIONS IN docs/architecture.md, which is
    // the reason to write the list down at all. The danger model is stuck on not knowing how
    // long a hazard lasts or how big it is: LimitedLifespan sits on 501 entities (effects AND
    // monsters), DiesAfterTime on the totems, GroundEffect on the standing hazards, and Beam
    // on Metadata/Effects/BeamEffect - the boss beam that made steering necessary in the first
    // place. Projectile rides 204 entities including the player's own Spark, where
    // ProjectileWatch currently derives a direction and a speed by watching one move between
    // frames. NONE OF THEM CAN BE DECODED FROM THE COMMITTED FILES: no build has read a byte
    // of any of them, so all eighteen recordings are silent about their contents and the cells
    // above are the only thing known. That is the standing rule stated once more - a feature
    // has to be running while a recording is made - and here it names exactly which switches
    // to have on: the entity walk already resolves these components, so a capture with the
    // Projectiles and Effects switches on and a build that reads the component bodies would
    // answer all five at once.

    "Component": {
      "comment": "The two fields EVERY component starts with, whatever it is. Worth having as a layout of its own because it is what orients you in one nobody has decoded: the first row says WHICH TYPE this is and the second says whose it is, so a window of unknown bytes already has two rows that mean something. Confirmed live on a DemonicApparitionPortal's Transitionable, where OwnerEntity held exactly the entity address the browser was showing. Named ComponentHeader in the AHK tool.",
      "fields": {
        "StaticPtr": {
          "offset": "0x00", "type": "ptr",
          "comment": "The component's TYPE descriptor - identical across every instance of the same component, so it fingerprints the type. Two rows sharing this value are the same kind of thing."
        },
        "OwnerEntity": { "offset": "0x08", "type": "ptr", "comment": "The entity this component belongs to. CORROBORATED FROM THE RECORDINGS 2026-08, by an argument that does not depend on this offset being right: components are pooled, so the address one cell past a component is a DIFFERENT entity's component of the same class, and in the 64 sightings where that neighbour's header happened to be in a recording this field held exactly the entity the entity list names as its owner. It reads unread far more often than not - no build has ever read a component header - so the sample is small and one-sided, and it is the SAME answer the live dissector gave on a DemonicApparitionPortal's Transitionable." }
      }
    },

    "Transitionable": {
      "comment": "Component: the open/closed/activated state of a thing that changes - doors, levers, shrines, barricades. Both references agree on this offset (the AHK tool reads it as a short, GameHelper2 as an int), which is as close to certain as an offset gets here.",
      "fields": {
        "CurrentState": { "offset": "0x120", "type": "i16" }
      }
    },

    "StateMachine": {
      "comment": "Component: an entity's named states, and which one it is in. From the AHK tool's decoder. The names are not stored with the values: StatesPtr leads to an array of StdString at StateNamesBase, each StateNameSize apart, indexed by the state's number.",
      "fields": {
        "CurrentState": { "offset": "0x120", "type": "i16", "comment": "Same offset as Transitionable.CurrentState - the AHK decoder reads it through that constant." },
        "StatesPtr": { "offset": "0x158", "type": "ptr" },
        "StatesValuesFirst": { "offset": "0x160", "type": "ptr", "comment": "StdVector begin." },
        "StatesValuesLast": { "offset": "0x168", "type": "ptr", "comment": "StdVector end." }
      },
      "consts": { "StateNamesBase": "0x10", "StateNameSize": "0xC0" }
    },

    "Animated": {
      "comment": "Component: the model an entity actually loaded. Worth having because it tells apart entities that SHARE a metadata path but look different - the ExpeditionMarker flag variants were the case that needed it. The path is two hops away: ModelInfoPtr -> AnimatedModelInfo.ModelFileRecordPtr -> FileInfoValue.Name. Both references agree.",
      "fields": {
        "AnimatedEntityPtr": { "offset": "0x280", "type": "ptr" },
        "ModelInfoPtr": { "offset": "0x358", "type": "ptr", "struct": "AnimatedModelInfo" }
      }
    },

    "AnimatedModelInfo": {
      "comment": "Behind Animated.ModelInfoPtr. Leads to the file record of the loaded .ao model.",
      "fields": {
        "ModelFileRecordPtr": { "offset": "0x18", "type": "ptr" }
      }
    },

    "FileInfoValue": {
      "comment": "A GGPK file record. Name is the file's path - here, the .ao model.",
      "fields": {
        "Name": { "offset": "0x08", "type": "stdWString" }
      }
    },

    "Pathfinding": {
      "comment": "Component: how a monster moves. From the AHK tool, which probed it in-game.",
      "fields": {
        "Flying": { "offset": "0xE5", "type": "u8", "comment": "Non-zero on flying entities - they ignore the walkable grid, so a route to one means nothing." },
        "BaseSpeed": { "offset": "0xEC", "type": "i32" }
      }
    },

    "AreaTransition": {
      "comment": "Component on portals and zone exits. HYPOTHESIS from Sikaka/POE2Radar, carried over UNVERIFIED by the AHK tool - and neither field says where the transition LEADS, which is the thing actually worth having. Treat as a starting point, not as known.",
      "fields": {
        "GracePeriod": { "offset": "0x18", "type": "i32" },
        "TeleportDelay": { "offset": "0x1C", "type": "i32" }
      }
    },

    "BaseEvents": {
      "comment": "NOT WORTH DECODING, and that is the finding rather than a gap. The AHK tool dumped this in-game and found engine dispatch plumbing: vtables in the module's own range and intrusive linked-list nodes, with no named-field data. A decoder could only ever surface handler counts. The one useful signal is the ENTITY POINTERS it embeds - an NPC's BaseEvents references other entities - so look at those in the dissector rather than writing a reader for this."
    },

    "Functions": {
      "comment": "NOT WORTH DECODING - engine dispatch plumbing, same finding as BaseEvents. Proven in-game by the AHK tool, not assumed."
    },

    "InteractionAction": {
      "comment": "NOT WORTH DECODING - engine dispatch plumbing, same finding as BaseEvents. Proven in-game by the AHK tool, not assumed."
    },

    "Buffs": {
      "comment": "Component: every buff and debuff currently on the entity. A StdVector<StatusEffect*> - POINTERS, which each have to be dereferenced, exactly as GameHelper2 reads it. CORRECTED 2026-08 against session-2026-08-buffs.rec, and this entry used to say the opposite: that PoE2 stores the entries INLINE at 0x50 stride, 'a deliberate divergence from GameHelper2', on the strength of the AHK tool reading them that way. Both were wrong, and the recording settles it three ways. (1) ARITHMETIC: across 999 frames the vector's span is 56, 64, 72, 80, 88 or 96 bytes - always a multiple of 8, never of 0x50 except where 80 coincides. A vector of 0x50 structs cannot have a span of 56. (2) THE BACK-POINTER: dereference the qword the inline reading calls entry[0].BuffDefinitionPtr and its own +0x00 holds THE BUFFS COMPONENT ADDRESS - it is a StatusEffect pointing at its owner, not a .dat row. (3) COUNTS: over the same frames the inline reading yields 218 buffs in total and the pointer reading 8185, i.e. about 8 per frame against a character who visibly had that many. What the inline reading actually did was floor a span of 56-96 down to 0 or 1, so the tool reported no buffs at all most of the time and one garbage name otherwise - which is what 'HasBuff never matches' looked like from the outside. The AHK tool (ahk/PoE2ComponentDecoders.ahk, DecodeBuffsComponentBasic) still reads it inline and has the same bug.",
      "fields": {
        "StatusEffectFirst": { "offset": "0x160", "type": "ptr", "comment": "StdVector begin: the first StatusEffect POINTER, not the first StatusEffect." },
        "StatusEffectLast": { "offset": "0x168", "type": "ptr", "comment": "StdVector end; count = (Last - First) / StatusEffectPointerSize." }
      },
      "consts": { "StatusEffectPointerSize": "0x08" }
    },

    "BuffDefinition": {
      "comment": "The static description a StatusEffect points at, and A ROW OF BuffDefinitions.dat - so its offsets are computable rather than searchable, see the note above WorldAreaDat. BuffType 0x04 marks a FLASK buff, which is what makes 'is this flask still active' answerable without name matching. ROW SIZE 0x15F IS THE GAME'S OWN NUMBER, not a computation: the loaded-table walk reads it out of the row store (3217 rows, session-2026-08-glossary.rec), and dat-schema's 55 columns compute the same 0x15F. That matters more here than on most rows, because every offset below except Name was DERIVED from the column widths and none of them is on the drift report's chain - the total agreeing is the one check that covers the columns nothing reads.",
      "fields": {
        "Name": { "offset": "0x00", "type": "utf16Ptr", "comment": "-> raw UTF-16 string, NOT a StdWString, e.g. \"flask_effect_life\". This is the table's Id column, i.e. the ENGINE identifier, and it is what a RULE matches: it stays English on a localised client, where matching a display name would break every rule the moment somebody changed their game's language. DisplayName below is the readable one, shown but never matched." },
        "Description": { "offset": "0x08", "type": "utf16Ptr", "comment": "Column 1 of the same row - the buff's own description text. Read to CORROBORATE DisplayName as much as to show it: this row's layout is computed rather than observed, and two independent strings landing correctly at once is unlikely by accident, so a wrong offset reads as obvious rubbish in the rule editor's buff picker rather than as a quiet lie." },
        "DisplayName": { "offset": "0x12", "type": "utf16Ptr", "comment": "Column 4, the READABLE name - \"Flame Wall\" where the Id says \"fire_wall\". VERIFIED LIVE 2026-08-25 by the owner: the buff picker resolved arcane_surge -> \"Arcane Surge\", skill_instance_wildshard_stack -> \"Wildshard\", lightning_infusion -> \"Lightning Infusion\", fire_infusion -> \"Fire Infusion\" (and some rows - track_movement, archmage_reservation - carry an empty display name, which is the column being empty, not the offset being wrong). Originally COMPUTED FROM THE COLUMN LAYOUT, and that derivation held: the same arithmetic over dat-schema's BuffDefinitions columns (string 8, bool 1, i32 4, enumrow 4, foreignrow 16, array 16) reproduces BuffVisualsKey at 0x55 and BuffCategory at 0x67 EXACTLY, and both of those are already in production here. Two independent hits are what make the third one evidence rather than a guess. One caveat carried from dat-schema: it marks this column NOT localized, so it is a design-time English name, and the string the game paints on the buff bar may instead be BuffVisuals.BuffName, which IS localized. That is the other reason rules match the Id and this is only ever displayed." },
        "BuffVisualsKey": { "offset": "0x55", "type": "ptr", "invariant": { "kind": "plausiblePtr" }, "comment": "STILL DERIVED, NOT OBSERVED - declared, never read, never seen in a live game. 0x55 is where the BuffVisual COLUMN starts, and a foreign reference holds the ROW pointer at the column start (see the order note above WorldAreaDat, settled 2026-08 on NPCs.QuestFlags). MOVED BACK HERE FROM 0x5D, which is where the old +8 rule put it, on the strength of that observation - and the reference this disagrees with is still worth respecting: GameHelper2 reads GrantedEffects.ActiveSkillDatPtr at 0x57 where dat-schema computes that column starting at 0x4F, which is the +8 rule and cannot be reconciled with what the fixture shows unless GrantedEffects' earlier columns have drifted by 8. So this field is now the cheapest live test of a rule the whole column arithmetic rests on: read a real BuffDefinition, follow this pointer, and see whether it lands on a row (a pointer to text) or on an engine object (a module pointer, i.e. a vtable). Nothing checks it today - the drift report walks GameState -> InGameState -> AreaInstance/WorldData -> LocalPlayerStruct and this row is not on that chain." },
        "BuffType": { "offset": "0x67", "type": "u8", "comment": "0x04 = flask buff. The column is really called BuffCategory and is an i32; reading the low byte works and is what the reference does, but the upper three bytes are not padding - they are part of the value." }
      },
      "consts": { "BuffTypeFlask": "0x04", "RowSize": "0x15F" }
    },

    "StatusEffect": {
      "comment": "One active buff or debuff, INLINE in the Buffs vector at 0x50 stride.",
      "fields": {
        "BuffDefinitionPtr": { "offset": "0x08", "type": "ptr", "comment": "-> BuffDefinition, which carries the name and the type." },
        "TotalTime": { "offset": "0x18", "type": "f32" },
        "TimeLeft": { "offset": "0x1C", "type": "f32", "comment": "Seconds remaining. The signal for 'this flask is still doing its job'." },
        "SourceEntityId": { "offset": "0x28", "type": "u32" },
        "RawStage": { "offset": "0x2C", "type": "u32", "comment": "The buff's internal stage counter, for effects that ramp up while they run. RAW is the load-bearing word: this is NOT the stage the game shows, and its scale is per-skill. GameHelper2 named it in commit 9a459ac and converts Whirling Slash (buff \"spear_sandstorm\") with (RawStage - 15) / 3 - it starts at 15 and steps by 3. So a consumer needs a calibration per skill, not one shared formula, and the only skill anyone has verified is that one. Second trap from the same commit: that buff does NOT sit on the player. The skill spawns its own effect entity (path contains sandstorm_swipe/sandstorm_swipe_storm) and the buff hangs off THAT entity, so reading only the player's Buffs never sees it." },
        "Charges": { "offset": "0x40", "type": "i16", "comment": "SIGNED - the reference reads a short." },
        "FlaskSlot": { "offset": "0x42", "type": "i16", "comment": "RAW slot 0-4 for a flask buff, i.e. belt slot 1-5; anything outside that range means this buff did not come from a flask. Signed short, not a byte." },
        "Effectiveness": { "offset": "0x48", "type": "i16", "comment": "Percentage delta: the effective value is 100 + this." }
      }
    },

    "Stats": {
      "comment": "The component. It holds no stat pairs itself - it holds POINTERS to StatsInternal sub-structures, and the pairs live in those. Written down because the layout invited exactly one wrong reading and got it: StatsInternalStatsVector was declared here as though 0xF8 were an offset into the component, and reading it that way returns a zeroed field on every entity, which then looks like 'this entity has no stats'. Verified against a flame wall in a recorded session: Stats+0xF8 and Stats+0x100 both read 0x0, while the AHK tool reaches the same data through StatsByItems and StatsByBuffAndActions. Offsets from that tool, which is battle-tested against PoE2.",
      "fields": {
        "StatsByItems": { "offset": "0x160", "type": "ptr", "struct": "StatsInternal", "comment": "-> StatsInternal: what the entity's gear gives it." },
        "CurrentWeaponIndex": { "offset": "0x168", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 8 } },
        "ShapeshiftPtr": { "offset": "0x170", "type": "ptr", "comment": "Non-null while shapeshifted." },
        "StatsByBuffAndActions": { "offset": "0x1C8", "type": "ptr", "struct": "StatsInternal", "comment": "-> StatsInternal: what buffs and actions give it. The one a skill's own numbers would be in." }
      }
    },

    "StatsInternal": {
      "comment": "A bag of (stat id, value) pairs, pointed at by the Stats component. The ids are the game's own, out of its Stats table - 347 is base_skill_effect_duration, 351 is skill_effect_duration.",
      "fields": {
        "StatsVector": {
          "offset": "0xF8", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 8, "maxCount": 8192 },
          "comment": "Vector of (key u32, value i32) pairs, inline at an 8-byte stride."
        },
        "StatsVectorLast": { "offset": "0x100", "type": "ptr", "comment": "End of the vector; count = (Last - First) / 8." }
      }
    },

    "Mods": {
      "comment": "Component on items and rare/magic monsters.",
      "fields": {
        "Identified": { "offset": "0x90", "type": "u8" },
        "Rarity": { "offset": "0x94", "type": "i32", "values": { "0": "Normal", "1": "Magic", "2": "Rare", "3": "Unique", "5": "Currency" }, "invariant": { "kind": "range", "min": 0, "max": 10 }, "comment": "Names from the tool's own ItemRarity (Rarities.FromRaw accepts 0..3; 5 is currency). The range invariant stays wider than the map on purpose - a number nobody has seen must not be rejected, and it keeps its digits on screen." },
        "StatsFromMods": { "offset": "0x148", "type": "stdVector", "comment": "The item's RESOLVED stats as (stat id, value) pairs - what the game shows on the item, already summed across its mods. The per-mod vectors say which mods are on it; this says what they add up to." },
        "AllMods": { "offset": "0xA0", "type": "stdVector" }
      }
    },

    "ObjectMagicProperties": {
      "comment": "Rarity and mods, for the things that carry this INSTEAD of a Mods component - monsters, and on the item side flasks, gems and some magic items. Which of the two an item has cannot be told from its path, so a reader tries both and keeps whichever decodes better. The rarity range stays 0-10 because monsters use more of it than items do. Ground drops: currency and fragments carry no rarity component at all - classify those by path (contains /Currency/), not by a rarity read of -1. The two offsets below were reached separately by the AHK tool (imm0r/PoEformance) and by this project, which is as close to confirmation as an offset gets without the game.",
      "fields": {
        "Rarity": { "offset": "0x144", "type": "i32", "values": { "0": "Normal", "1": "Magic", "2": "Rare", "3": "Unique", "5": "Currency" }, "invariant": { "kind": "range", "min": 0, "max": 10 } },
        "AllMods": { "offset": "0x150", "type": "stdVector", "comment": "Five vectors in a row - implicit, explicit, enchant, and two league ones - each 0x18 bytes." },
        "StatsFromMods": { "offset": "0x1F8", "type": "stdVector", "comment": "The resolved (stat id, value) pairs, as the Mods component has at 0x148." }
      }
    },

    "WorldItemComponent": {
      "comment": "On a ground-drop WRAPPER entity (Metadata/MiscellaneousObjects/WorldItem). The wrapper has no rarity/art of its own.",
      "fields": {
        "InnerItem": {
          "offset": "0x28", "type": "ptr",
          "invariant": { "kind": "stringContains", "needle": "Metadata/", "hops": ["0x00", "0x08"], "stringAt": "0x08" },
          "comment": "The real ITEM entity (path/rarity/Mods/RenderItem). Confirmed in-game 2026-06-23; keep a 0x08..0xA0 sweep as the patch-shift fallback."
        }
      }
    },

    "Stack": {
      "fields": {
        "StackSizeDataPtr": { "offset": "0x10", "type": "ptr", "comment": "Shared per-base-type StackSizeData descriptor (two Wisdom stacks resolve to the same pointer)." },
        "Count": { "offset": "0x18", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 100000 } }
      }
    },

    "StackSizeData": {
      "comment": "Per-context stack caps, verified in-game 2026-07-04. The container-type signal is NOT in the inventory struct's first bytes - display logic picks the smallest cap that still fits the current count.",
      "fields": {
        "MaxStackTab": { "offset": "0x20", "type": "i32", "comment": "Currency stash tab cap (Wisdom = 5000)." },
        "MaxStack": { "offset": "0x28", "type": "i32", "comment": "Normal cap: backpack AND normal stash tabs (Wisdom = 40)." }
      }
    },


    "StdVector": {
      "comment": "Not a game struct - the SIZE of a std::vector, which is three pointers: begin, end, and the end of the allocation. Needed because an item's five mod lists sit one after another in memory, so walking from one to the next is a stride of this. 0x18 is what the AHK tool strides by (AllMods + 0x18 * n across implicit/explicit/enchant/hellscape/crucible) and what GameHelper2's StdVector declares. DRIFT: nothing here can drift - it is the compiler's layout, not the game's - but it was MISSING from this file entirely, and the item reader asks for it in its constructor. That threw at start-up and took the whole tool down before the overlay ever appeared, from the commit that first read an item's mods until 2026-08-09.",
      "consts": {
        "StructSize": "0x18"
      }
    },

    "ModArray": {
      "comment": "One entry of a mod vector. The ROLLS live here and the stat ids do not: the mod's dat row says which stats it grants, and this holds only the numbers rolled for them - so a '+Life and +Mana' mod has two values and nothing here says which is which.",
      "fields": {
        "Values": { "offset": "0x00", "type": "stdVector", "comment": "The rolled values, 4 bytes each." },
        "Value0": { "offset": "0x18", "type": "i32", "comment": "A single roll, for the entries whose Values vector is empty." },
        "ModsPtr": { "offset": "0x28", "type": "ptr", "comment": "-> the Mods.dat row, whose first field is a pointer to the mod's id string." }
      },
      "consts": {
        "EntrySize": "0x40"
      }
    },

    "StatPair": {
      "comment": "A resolved stat: which one, and how much of it. The key is a ROW INDEX into Stats.dat rather than a name, so turning it into words needs the shipped stat table.",
      "fields": {
        "Key": { "offset": "0x00", "type": "i32" },
        "Value": { "offset": "0x04", "type": "i32" }
      },
      "consts": {
        "EntrySize": "0x08"
      }
    },

    "RenderItemComponent": {
      "fields": {
        "ResourcePath": { "offset": "0x28", "type": "stdWString", "comment": "2D inventory-art .dds path; the basename doubles as a price-lookup key." }
      }
    },

    "ItemBaseComponent": {
      "fields": {
        "UniqueIviRow": { "offset": "0x30", "type": "ptr", "struct": "ItemVisualIdentityRow", "comment": "ItemVisualIdentity dat row for uniques (0 for non-uniques); its +0x00 points to the IVI Id wide string." }
      }
    },

    "ItemVisualIdentityRow": {
      "comment": "The dat row ItemBaseComponent.UniqueIviRow points at. Its Id - \"FourUniquePinnacle1\" - is the ROBUST key for a unique: it is an engine identifier and stays English on a localised client, where the displayed name does not. data/unique_ivi_name_map.tsv turns it into the name price sites use. Chain and offsets from the AHK tool, live-verified there 2026-06-24.",
      "fields": {
        "IdPtr": { "offset": "0x00", "type": "ptr", "comment": "Points at the Id as a wide string." }
      }
    },

    "Player": {
      "fields": {
        "Name": { "offset": "0x1B0", "type": "stdWString" },
        "Xp": { "offset": "0x1D8", "type": "u64" },
        "Level": { "offset": "0x204", "type": "i32", "invariant": { "kind": "range", "min": 1, "max": 100 } }
      }
    },

    "ServerDataOffsets": {
      "comment": "What LocalPlayerStruct.ServerDataPtr actually points at. It is NOT the struct holding PlayerInventories - that one is reached through the vector below. Missing this hop reads PlayerInventories off the wrong base, where it is simply zero, which looks exactly like a drifted offset. Source: GameHelper2 ServerDataOffsets.",
      "fields": {
        "PlayerServerData": { "offset": "0x48", "type": "stdVector", "comment": "StdVector of pointers to ServerDataStructure; the first entry is the local player's." },
        "AreaMarkers": {
          "offset": "0x2248", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 192, "maxCount": 4096 },
          "comment": "THE MAP MARKERS THE GAME ITSELF PLACES IN THIS AREA, one AreaMarker each. Found 2026-08 by --questflags, which was hunting something else entirely: it follows every pointer out of ServerData and sweeps what it finds, and this list was the one place in 3.5 MB that held a reference to a QuestFlags row. Different from MinimapIcon, and the difference is the point - that component only exists on an ENTITY, so it can only mark things that are entities and awake. This is the area's own list, server-sent, with grid coordinates for each marker, and it carries things an entity walk never sees. Read live in a hideout: waypoint, map device, crafting bench, both stashes, the healing well and five NPCs, sorted by Y. THE LIST IS A COPY, NOT THE ORIGINAL. A hardware breakpoint on one entry's QuestFlagRowPtr slot (Cheat Engine, live, 2026-08-13) fired 1052 times on exactly two instructions, and both are bulk SIMD moves rather than anything that reads the flag: `movups xmm1,[rcx+r8+30]` with r8 = the list's first entry and rcx = 0x340, and `vmovdqa [rcx+60],ymm4` writing 32 bytes to the same address. The destination stayed at the same address across all 1052 hits, so this is not a vector growing and relocating; it is a fixed buffer written over and over. The second instruction looks like the Win64 memcpy store - rcx destination, r8 count, r9 = -16 as the alignment mask, rax the destination held for the return - and reading rdx as its source puts one 0x3000 above this list. THAT READING DID NOT SURVIVE THE MEMORY VIEWER: the bytes there are floats on a 0x14 stride, 1.0f repeated with a 1.05f among them, which is not an AreaMarker array under any alignment. So rdx was not a source array of markers, and asking what WRITES the entry instead is what named one properly. Two writers, both generic bulk routines, three hits inside one second against those 1052 reads - so this memory is built on an event and then read every frame. One is a fill: every store from the same ymm0, `sub r8,0x100` per round, 0xF28 bytes from the entry list + 0x10, with bytes-travelled plus r8 equalling rsi exactly. The other is a copy: stores from ymm2/ymm3/ymm4, `add rdx,0x100` alongside rcx, 0x8A4 bytes into the list, and its source base falls out of the registers twice over - rdx minus the distance rcx has travelled from rax lands precisely on rbx, 0x9CDB600 away in a different allocation. NEITHER LENGTH IS A MULTIPLE OF THE 0xC0 STRIDE, which is why this is recorded as an observation and not as the list's provenance: the copy may be partial, or that buffer may no longer be the marker array. The process was never restarted between the recording and the debugger, so the address itself is comparable - but that settles the instance, not the tenant. Heap blocks get recycled, and 0x8A4 bytes into a list of fourteen 0xC0 entries (0xA80) is exactly what a recycled block looks like from the outside. An address carried over from a recording needs the object re-identified at the moment it is watched, not just the process - and watching the source buffer settled why. Four writers in fifteen seconds, and one of them is the block being FREED: `mov rax,[rcx+18]` / `mov [r10],rax` / `mov [rcx+18],r10` hangs it off a pool free list by writing the list head into its own first qword. Another nulls slot 0 of a pointer array whose base is held at +0x00 of a struct elsewhere; another memsets it; another stores sixteen bytes at its head with a module address in rcx. That is a pool block being recycled, not a structure holding anything. The dat tables are the exception worth naming: loaded once at startup and never freed, so a row address from a recording still points at that row for as long as the process lives, while a heap address from the same recording points at whoever holds the block now. Checked rather than assumed: the QuestFlags row for CanSeeAngeInHideout, taken out of a recording, still had its Id pointing at the wide string CanSeeAngeInHideout when a debugger followed it minutes later - the same process, but well past the point where the heap addresses beside it had changed hands twice. What is not in doubt is the negative: 1052 touches of a flag slot and not one of them an evaluation - no compare, and the row pointer never dereferenced - which is why every runtime flag reference found so far reads as a rule rather than as per-character state."
        },
        "League": { "offset": "0x21E0", "type": "stdWString", "comment": "Active league name, EXACTLY poe.ninja/poe2scout's value (\"Standard\", \"HC Runes of Aldur\") - it drives price-league detection, so a wrong one silently prices a stash against another economy. ON THE OUTER STRUCT, not on the inner one the inventories are on, and that is the whole trap: it was read off the inner struct first and came back empty, which reads as 'not in the game yet' and cost every price in the tool. The AHK tool says which struct in the shape of its own resolve - the pointer it reads the league from is whichever one's +0x48 is a plausible vector, which is the OUTER by definition, while it reads inventories from what that vector points at. Confirmed from the other side in a recording, 2026-08-09: at this offset on the INNER struct sit two heap pointers interleaved with two into the module image - a pair of vtables - in the same frames where that struct's inventory vector reads 118 inventories perfectly. Value live-verified by the owner 2026-06-22 (AHK tool)." }
      }
    },

    "AreaMarker": {
      "comment": "One entry of ServerDataOffsets.AreaMarkers: what to draw, where, and what it depends on. THE ENTRY NAMES ITSELF, which is what makes a single sighting worth writing down: 0x00 is a foreign reference to MinimapIcons - row then table, the order settled on NPCs.QuestFlags - and 0x10 repeats that row as an INDEX. The two agree, and their agreement is the check: StashPlayer and StashGuild sit at indices 169 and 170 and their row pointers are 0x26 apart, which is exactly the row size the column widths compute for MinimapIcons. NPC is index 4 in every entry that has it, MapDevice is 164, and 164 - 4 = 160 rows = 0x17C0 bytes, which is the gap between those two row pointers to the byte. SEEN IN ONE PROCESS across two captures, at the same offset both times - so the offset is corroborated but NOT across a restart, which is the check still missing.",
      "fields": {
        "IconRowPtr": { "offset": "0x00", "type": "ptr", "struct": "MinimapIconRow", "comment": "The MinimapIcons row: Waypoint, MapDevice, StashPlayer, NPC..." },
        "IconTablePtr": { "offset": "0x08", "type": "ptr", "struct": "DatTable", "comment": "The table half of that reference, which is what names it - \"Data/Balance/MinimapIcons.dat\"." },
        "IconRow": { "offset": "0x10", "type": "u32", "comment": "The same row as an index. Redundant, and useful precisely because of that - see the comment above." },
        "GridX": { "offset": "0x14", "type": "u32", "invariant": { "kind": "range", "min": 0, "max": 65535 } },
        "GridY": { "offset": "0x18", "type": "u32", "invariant": { "kind": "range", "min": 0, "max": 65535 }, "comment": "The list is sorted by this, which is a drawing order and not a coincidence to rely on." },
        "NpcRowPtr": {
          "offset": "0x20", "type": "ptr", "struct": "NpcsRow",
          "comment": "WHICH NPC this marker is, when it is one - an NPCs.dat reference, zero on every marker whose icon is not NPC. Verified by grid rather than by reading it: all six NPC markers in the hideout land exactly on the 0xBF NPCs row stride relative to a row identified in an earlier session, and one of them IS that row - Metadata/NPC/Hideout/VaalTimeScientist, the NPC this whole chain was first followed from. So a marker can be named without the entity existing, which is the thing MinimapIcon cannot do."
        },
        "NpcTablePtr": { "offset": "0x28", "type": "ptr", "struct": "DatTable" },
        "QuestFlagRowPtr": {
          "offset": "0x80", "type": "ptr", "struct": "QuestFlagsRow",
          "comment": "The flag a marker waits for - read live as CanSeeAngeInHideout on one of the NPC markers. NOT ZERO WHEN THERE IS NO CONDITION, which is what this was first written down as: three of the fourteen markers hold floats and small integers here (0x3F800000 is 1.0f), because the slot is written by the entries that have a condition and left as whatever the allocation held by the ones that do not. Counting non-zero slots finds four conditions where there is one. ReadPointer's plausibility range happens to throw out all three of those - 1.0f and 0xFEF are not addresses - but that is luck rather than a check: a leftover can look like an address, and then only the table can say. Checking the value against the table's own rows costs one division, which is why the reader does it and the test counts all three ways.",
          "invariant": { "kind": "plausiblePtr" }
        },
        "QuestFlagTablePtr": { "offset": "0x88", "type": "ptr", "struct": "DatTable" }
      },
      "consts": { "EntrySize": "0xC0" }
    },

    "ServerDataStructure": {
      "comment": "Reached via ServerDataOffsets.PlayerServerData, not directly from ServerDataPtr.",
      "fields": {
        "PlayerInventories": {
          "offset": "0x320", "type": "stdVector",
          "invariant": { "kind": "vectorSane", "elementSize": 24, "maxCount": 1024 }
        },
        "TabRecords": {
          "offset": "0x38", "type": "ptr",
          "comment": "ON THE OUTER SERVER-DATA STRUCT, and it leads to the STASH TAB NAMES - the question this project spent five rounds on. The block it points at holds an array of 0x18-byte entries; each entry's first qword is a pointer to a record, and that record carries the tab's name as a std::wstring at +0x08 with its length at +0x18. Three consecutive entries were read on a live client 2026-09 and gave three of the player's own tab names, which is what settles it: nothing but the real list can produce words the player chose. Confirmed by --peek from the root the sweep itself prints, not from a Cheat Engine path - an earlier module-anchored chain to the same block went dead after its intermediate object moved, so the route to X is NOT stable and must be taken from ServerDataStructure every time. The +0x3A90 seen in every pointer scan is base + index*0x18 for one particular tab, not a member offset. THE ARRAY IS NOT JUST THE PLAYER'S OWN STASH: one of the three names read back was a GUILD stash tab, identified by the player. So an index here does not correspond to a PlayerInventories slot by position, and any mapping has to be established rather than assumed - which is the mistake this whole line of work started from. WHAT IS STILL OPEN: where the array starts, how long it is, and how an index maps to an inventory id - the entries just before the one read hold nulls, which may be unloaded tabs or may be padding before the first element. Also unverified across a game restart: outer+0x38 was checked repeatedly within one session."
        },
        "FriendsList": {
          "offset": "0x2848", "type": "stdVector",
          "comment": "NOT READ BY ANYTHING - recorded because it was identified, not because it is wanted. Found 2026-09 by the inventory sweep's parallel-list search, which was hunting a per-tab name list and turned this up instead: a vector of 0x10 records whose text is an account handle, a status message, a character name and a league. Confirmed against the game's Social panel, which shows exactly those four things for the same account. It sits on the OUTER server-data struct, the one ServerDataPtr points at, not on the inner one that carries PlayerInventories - the sweep labels the two and that label is the only reason the distinction survived. Its length tracks the friend count and merely happened to land near the inventory count on the day it was found, which is precisely why a count was never allowed to be the evidence for anything here."
        }
      }
    },

    "InventoryArray": {
      "comment": "One slot per inventory: the backpack, the worn gear and every stash tab, in one vector. BIT 31 OF THE ID IS A MARK, NOT PART OF A NUMBER - 0x80000000 and 0x80000001 are the Merchant window's two shop pages, confirmed against the game 2026-09 by selecting 0x80000001 and seeing the same 55 items the second page draws. Read as a signed i32 they are -2147483648 and -2147483647, which is how they were first noticed. See StashInventory.Called.",
      "consts": { "EntrySize": "0x18" },
      "fields": {
        "InventoryId": { "offset": "0x00", "type": "i32" },
        "InventoryPtr0": { "offset": "0x08", "type": "ptr", "struct": "Inventory" },
        "InventoryPtr1": {
          "offset": "0x10", "type": "ptr",
          "comment": "The same object, sixteen bytes lower: InventoryPtr0 minus 0x10 on every slot observed. So Inventory begins 0x10 into a larger object and this is its true base, carrying a second vtable - the layout of a class with multiple inheritance. Nothing reads it; it is recorded because it was measured and because the sixteen bytes it opens up were the last untried place the stash TYPE could have been. It is not there either - see the Inventory comment."
        }
      }
    },

    "Inventory": {
      "comment": "A GRID AND ITS CONTENTS, AND NOTHING ABOUT WHAT SORT OF TAB IT IS. Searched exhaustively for a stash type 2026-09 with --inventories, over 181 live inventories including two shop pages and grids from 1x1 to 64x5: every byte of Inventory+0x000..0x400, every byte of the 0x18 array slot, and every byte of the 0x40 before it, at widths of one, two, four and eight and at EVERY alignment. The only fields that are constant among tabs sharing a grid shape and different between shapes are TotalBoxes and TotalBoxesY themselves - which a type must be, since a type decides a layout. Both vtables settle it: the first qword of Inventory is 0x7FF648128C78 for all 181 and the first qword of the object below it is 0x7FF647CB4268 for all 181, so the backpack, a worn ring, a quad tab and a shop page are ONE class. The type is not a subclass and not a member here. What is left is a parallel per-tab list off ServerDataStructure - see the note at StashReader.Read, which has claimed since before this search that the tab NAMES live in such a list and are matched to these by position. --inventories --tabname walks outwards from every inventory, every array slot and both server-data structs, three pointers deep, looking for a name the player supplies; that is the search which either produces a path or ends this. WHAT A STRING SCAN ALREADY SETTLES, 2026-09, Cheat Engine on a live client: a tab's name exists in memory in exactly ONE live copy. A second buffer held a stale 16-character copy and was orphaned the moment the name outgrew it, which means it was a discarded reallocation and not a second owner. The live buffer tracks every KEYSTROKE in the rename dialog, before the change is confirmed and so before any server round trip - so whatever owns it is client-side. That is consistent with the name living only in the UI tree, which is what this project has assumed for several rounds, but it does not establish it: a client that binds the rename field straight to its own copy of the tab record would look identical. The opcodes touching the buffer are all movdqu/mov pairs from the shared wide-string copy routines and name no owner. WHAT THE POINTER SCAN GAVE, and it is a shape rather than a base: [X + 0x1E0] -> Y, and the name's std::wstring header sits at Y + 0x18. So a tab's name is a wstring at 0x18 of some record, and the hop that reaches that record is at 0x1E0 of its parent. Whether X is reachable from PlayerInventories is the one thing still open, and it is what --inventories --tabname answers. This measurement immediately corrected the hunt: it read 0x100 per struct, which cannot see a pointer at 0x1E0, so it would have walked past the record and reported NOT FOUND with full confidence. The window is 0x400 now. A window that is too narrow produces exactly the same clean wrong negative as a read that never happened.",
      "fields": {
        "TotalBoxes": { "offset": "0x150", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 256 } },
        "TotalBoxesY": { "offset": "0x154", "type": "i32", "invariant": { "kind": "range", "min": 0, "max": 256 } },
        "ItemList": { "offset": "0x170", "type": "stdVector", "comment": "Vector of POINTERS to InventoryItem structs." },
        "ItemListLast": { "offset": "0x178", "type": "ptr", "comment": "Vector end; count = (Last - First) / 8." },
        "ServerRequestCounter": { "offset": "0x1E8", "type": "i32" }
      }
    },

    "StashTabRecord": {
      "comment": "ONE STASH TAB'S NAME, and the end of a five-round search. Reached from ServerDataStructure.TabRecords: that pointer leads to a block holding an array of 0x18-byte entries whose first qword points here. The name is an ordinary MSVC std::wstring - up to seven characters live inline in the sixteen bytes at +0x08, longer ones put a heap pointer there, and the length follows at +0x18. Both shapes were read on a live client 2026-09: \"Armor I\" inline at seven, \"getTheNameNO\" through a pointer at twelve. The seven-character boundary is the same one TextProbe.InlineCapacity already encodes, which is a small independent check that this is being read as the game writes it. Nothing in this tool consumes it yet - the array's start and its mapping to inventory ids are still open, see TabRecords. THE OTHER TWO QWORDS OF AN ENTRY ARE AN EMPTY std::vector in every entry examined so far - begin and end hold the same address, checked on all THREE entries read 2026-09, one of them the guild tab. Three for three matters: it means a full one has never been seen, so nothing here says what the vector holds, and it also means picking further entries at random is not a way to find out - which entry belongs to which tab is exactly what is still unknown. This array is the first thing in this project that reaches GUILD stash tabs at all, whose contents have never been readable, so if that vector turns out to hold a tab's items it is the route to them. STILL A HYPOTHESIS, and the way to test it is an entry whose begin and end DIFFER; both examined were empty. DO NOT DEREFERENCE AN EMPTY ONE. Following begin on a zero-length vector reads whatever unrelated heap happens to sit at that address, and it looks convincing: one entry led to floats and the numbers 2496 and 1360, which read exactly like a window size, and another to a 64-character hex string that read exactly like a per-tab id. Both are neighbouring allocations and mean nothing. This note previously recorded the window size as though it said something about the field, which was the same mistake as taking heap adjacency for evidence, one level further down.",
      "fields": {
        "Name": { "offset": "0x08", "type": "stdWString" }
      }
    },

    "ChargesComponent": {
      "comment": "Component on a flask item: how many charges it holds and what a use costs. Together they answer the only question that matters before pressing the key - is this flask usable AT ALL. Confirmed identically by GameHelper2's ChargesOffsets and the AHK tool.",
      "fields": {
        "ChargesInternalPtr": { "offset": "0x10", "type": "ptr", "struct": "ChargesInternal", "comment": "-> ChargesInternal, which holds the per-use cost." },
        "Current": { "offset": "0x18", "type": "i32", "comment": "Charges the flask currently holds." }
      }
    },

    "ChargesInternal": {
      "comment": "The shared per-base-type descriptor a Charges component points at.",
      "fields": {
        "PerUseCharges": { "offset": "0x18", "type": "i32", "comment": "Cost of one use. A flask with fewer charges than this cannot be used." }
      }
    },

    "InventoryItem": {
      "fields": {
        "Item": { "offset": "0x00", "type": "ptr" },
        "SlotStart": { "offset": "0x08", "type": "i32" },
        "SlotStartY": { "offset": "0x0C", "type": "i32" },
        "SlotEnd": { "offset": "0x10", "type": "i32" },
        "SlotEndY": { "offset": "0x14", "type": "i32" }
      }
    },

    "UiElement": {
      "comment": "Game UI tree node. Scale conversion is per-element: v1 = (clientW - 2*cull)/2560, v2 = clientH/1600; ScaleIndex picks the pair, times LocalScaleMultiplier. Sanity-clamp everything - a mis-resolved GameCullSize or drifted ScaleIndex silently poisons every rect.",
      "fields": {
        "Self": { "offset": "0x08", "type": "ptr" },
        "Children": { "offset": "0x10", "type": "stdVector" },
        "StringId": { "offset": "0x98", "type": "stdWString", "comment": "Was 0x140 in the 0.4 layout - the 0.5 client moved it." },
        "LocalScaleMultiplier": { "offset": "0x130", "type": "f32", "comment": "Sanitize: accept 0.2..5.0, else treat as 1.0." },
        "Flags": { "offset": "0x180", "type": "u32", "comment": "Visibility bit lives here." },
        "ScaleIndex": { "offset": "0x18A", "type": "u8", "comment": "0.4-era offset; may have drifted in 0.5 - unknown index falls back to uniform scale." },
        "ItemPtr": {
          "offset": "0x4F8", "type": "ptr",
          "comment": "Item-slot elements: direct pointer to the item ENTITY. Source: coussiraty/CoreExile2 InventoryAdapters.cs (ItemPointerOffset = 0x4F8); verified live on a hovered Rare. Powers price-on-hover and ritual badges."
        }
      }
    }
  }
}
