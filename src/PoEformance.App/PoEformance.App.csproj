<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Layer 5 - the composition root. This is the ONLY project allowed to know about
    every other one. If you want to know what the program does, read Program.cs here:
    everything is wired by hand, in order, with no container and no reflection.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PoEformance.App</RootNamespace>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- IL2104/IL3053 are ILC's PER-ASSEMBLY ROLLUPS: "assembly X produced trim/AOT
         warnings", raised for EXTERNAL assemblies we cannot edit (first offender:
         DirectN.Extensions, whose author nonetheless ships working AOT builds of the same
         stack). With TreatWarningsAsErrors they killed an otherwise clean publish - the
         first AOT CI run failed on exactly these two lines while every assembly compiled.
         Exempting ONLY the rollups keeps every individually-coded IL2xxx/IL3xxx warning in
         OUR projects a hard error; what it accepts is that a dependency's reflective
         corners are proven at runtime (the config-window smoke run) instead of at build time. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PoEformance.Overlay\PoEformance.Overlay.csproj" />
    <ProjectReference Include="..\PoEformance.Config\PoEformance.Config.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The offset schema ships next to the exe so it stays hot-editable after deploy. -->
    <None Include="..\..\schema\poe2.offsets.json" Link="schema\poe2.offsets.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The config page ships the same way, for the same reason: edit, reload, no rebuild. -->
    <None Include="..\..\ui\**" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
