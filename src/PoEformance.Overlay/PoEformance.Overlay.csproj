<Project Sdk="Microsoft.NET.Sdk">
  <!-- Layer 4a - the in-game overlay (ImGui / ClickableTransparentOverlay). Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The overlay drags in native ImGui/Veldrid assets that the AOT analyzer cannot see
         through; it is loaded dynamically at runtime, so exclude it from AOT analysis
         rather than silencing individual warnings. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClickableTransparentOverlay" Version="11.1.0" />
    <!-- Pinned explicitly: the version ClickableTransparentOverlay pulls in transitively
         (3.1.6) carries known high-severity advisories. A direct reference wins over the
         transitive one, so this keeps the restore clean of NU1903/NU1902. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PoEformance.Features\PoEformance.Features.csproj" />
  </ItemGroup>
  <!-- Pictures the tool draws by default, INSIDE the assembly rather than beside the
       executable. A loose file can be deleted, missed by a copy, or lost when a new build is
       unzipped over an old folder, and the failure looks like the feature being broken; a
       manifest resource cannot be separated from the code that draws it and survives
       single-file publishing. The glob matching nothing is not an error, so the mechanism
       ships before the art does and degrades to text until it lands. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\*.png" />
    <!-- The icon sheet lives at the repository root because it is the project's art rather
         than the overlay's, and it is linked here rather than copied so the 4.9 MB exists
         once. LogicalName is pinned: IconCache.BuiltIn matches on the END of the resource
         name, and a linked file's generated name is derived from its path outside the project
         directory, which is neither stable nor predictable. -->
    <EmbeddedResource Include="..\..\assets\icons.png" LogicalName="PoEformance.Overlay.assets.icons.png" />
  </ItemGroup>
</Project>
